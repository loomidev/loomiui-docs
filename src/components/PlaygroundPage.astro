---
import MarketingHeader from "./MarketingHeader.astro";
import { buildImportMap } from "../lib/import-map.mjs";
import "../styles/home.css";

const importMap = buildImportMap();
const title = "Playground - LoomiUI";
const description = "Select LoomiUI components and adjust common props in a live playground.";

// Every entry is attribute-driven: props map 1:1 to attributes so the generated markup
// stays copy-pasteable. Components that need imperative wiring (modal, drawer,
// notification, command palette), rich data structures (table, chart, calendar,
// timeline), or slot-composed children (accordion, tabs, button-group) are deliberately
// excluded. Boolean props that default to `true` via plain Lit `type: Boolean` (e.g.
// avatar `show-ring`, button `show-focus-ring`) are also skipped — absence keeps the
// default and presence is also true, so an attribute can never turn them off; only
// booleans with a string converter (playground type "boolean-string") support "false".
