---
import GoogleAnalytics from "./GoogleAnalytics.astro";
import MarketingHeader from "./MarketingHeader.astro";
import { buildImportMap } from "../lib/import-map.mjs";
import {
  PRO_AFTER_CHECKOUT,
  PRO_BILLING_OPTIONS,
  PRO_INCLUDED,
  PRO_LICENSE_PLANS,
  PRO_LICENSING_NOTES,
  PRO_PORTAL_URL,
  PRO_SIGN_IN_URL,
} from "../lib/pro-licensing.mjs";
import "../styles/home.css";

const importMap = buildImportMap();
const title = "LoomiUI Pro licensing";
const description =
  "Choose Solo, Team, or Enterprise licensing for LoomiUI Pro, including templates, themes, private packages, and updates.";
const billingOptions = Object.entries(PRO_BILLING_OPTIONS);
const enterpriseSeatOptions = [
  { label: "2–10", value: "2–10" },
  { label: "11–25", value: "11–25" },
  { label: "26–50", value: "26–50" },
  { label: "51+", value: "51+" },
  { label: "Not sure yet", value: "Not sure yet" },
];
const enterpriseTimelineOptions = [
  { label: "This month", value: "This month" },
  { label: "This quarter", value: "This quarter" },
  { label: "Later", value: "Later" },
  { label: "Just exploring", value: "Just exploring" },
];
// Leads go to the portal, which holds the Slack webhook server-side. A webhook
// URL referenced here would ship in the static output for anyone to read and post to.
const salesLeadEndpoint = `${PRO_PORTAL_URL}/api/sales-lead`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" />
    <script type="importmap" is:inline set:html={JSON.stringify(importMap)} />
    <GoogleAnalytics />
  </head>
  <body class="bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100">
    <MarketingHeader />

    <main class="mx-auto max-w-6xl px-6 py-12 lg:py-16">
      <div class="max-w-3xl">
        <div class="feature-kicker">Licensing</div>
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Choose your Pro license</h1>
        <p class="mt-3 text-lg leading-7 text-gray-600 dark:text-gray-400">
          Pick Solo, Team, or Enterprise. Every plan includes Pro components, application templates,
          theme and Figma assets, private docs, and updates.
        </p>
      </div>

      <div class="license-toolbar" aria-label="Billing period">
        <span>Billing</span>
        <div class="license-toggle" role="group" aria-label="Choose billing period">
          {billingOptions.map(([key, option]) => (
            <button
              type="button"
              class:list={["license-toggle-option", key === "monthly" && "is-active"]}
              aria-pressed={key === "monthly" ? "true" : "false"}
              data-billing-option={key}
            >
              {option.label}
            </button>
          ))}
        </div>
        <strong>Annual saves two months</strong>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {PRO_LICENSE_PLANS.map((plan) => {
          const checkout = plan.checkout;
          return (
          <article
            id={plan.key}
            class:list={["license-card", plan.featured && "is-featured"]}
            data-monthly-amount={plan.pricing.monthly.amount}
            data-monthly-detail={plan.pricing.monthly.detail}
            data-monthly-suffix={plan.pricing.monthly.amount === "Custom" ? "" : PRO_BILLING_OPTIONS.monthly.suffix}
            data-annual-amount={plan.pricing.annual.amount}
            data-annual-detail={plan.pricing.annual.detail}
            data-annual-suffix={plan.pricing.annual.amount === "Custom" ? "" : PRO_BILLING_OPTIONS.annual.suffix}
          >
            {plan.featured && <div class="license-badge">Most popular</div>}
            <div class="license-card-top">
              <span class="license-icon">
                <loomi-icon name={plan.icon} style="width:1.25rem;height:1.25rem"></loomi-icon>
              </span>
              <div>
                <h2 class="license-name">{plan.name}</h2>
                <p class="license-tagline">{plan.tagline}</p>
              </div>
            </div>
            <div class="license-price">
              <div>
                <span class="license-price-amount" data-price-amount>{plan.pricing.monthly.amount}</span>
                <span class="license-price-suffix" data-price-suffix>{plan.pricing.monthly.amount === "Custom" ? "" : PRO_BILLING_OPTIONS.monthly.suffix}</span>
              </div>
              <p data-price-detail>{plan.pricing.monthly.detail}</p>
            </div>
            <ul class="license-features">
              {plan.features.map((feature) => (
                <li>
                  <loomi-icon name="check-circle" style="width:1rem;height:1rem;color:rgb(37 99 235);flex-shrink:0"></loomi-icon>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
            <div class="license-cta-wrap">
              {plan.contact || !checkout ? (
                <loomi-button
                  type="secondary"
                  size="small"
                  class="license-cta"
                  data-contact-sales
                >
                  {plan.cta}
                </loomi-button>
              ) : plan.key === "team" ? (
                <div
                  class="license-cta-group"
                >
                  <loomi-number
                    class="license-seats"
                    data-team-seats
                    label="Seats"
                    size="small"
                    min="2"
                    max="50"
                    step="1"
                    value="5"
                    no-clearing
                  ></loomi-number>
                  <loomi-button
                    type={plan.featured ? undefined : "secondary"}
                    color={plan.featured ? "primary" : undefined}
                    size="small"
                    tag="a"
                    href={checkout.monthly}
                    class="license-cta"
                    data-checkout
                    data-plan={plan.key}
                    data-monthly-href={checkout.monthly}
                    data-annual-href={checkout.annual}
                  >
                    {plan.cta}
                  </loomi-button>
                </div>
              ) : (
                <loomi-button
                  type={plan.featured ? undefined : "secondary"}
                  color={plan.featured ? "primary" : undefined}
                  size="small"
                  tag="a"
                  href={checkout.monthly}
                  class="license-cta"
                  data-checkout
                  data-plan={plan.key}
                  data-monthly-href={checkout.monthly}
                  data-annual-href={checkout.annual}
                >
                  {plan.cta}
                </loomi-button>
              )}
            </div>
          </article>
          );
        })}
      </div>

      <loomi-alert type="info" class="mt-8 text-sm">
        Solo and Team redirect to hosted checkout. Enterprise requests go straight to sales.
      </loomi-alert>

      <section class="license-panels">
        <div class="license-panel">
          <div class="license-panel-heading">
            <span class="license-panel-mark">
              <loomi-icon name="sparkles" style="width:1.1rem;height:1.1rem"></loomi-icon>
            </span>
            <div>
              <h3 class="license-panel-title">What's included</h3>
              <p>Everything needed to ship polished Pro surfaces.</p>
            </div>
          </div>
          <ul class="license-panel-list">
            {PRO_INCLUDED.map((item) => (
              <li>
                <span class:list={["license-panel-item-icon", `tone-${item.tone}`]}>
                  <loomi-icon name={item.icon} style="width:1rem;height:1rem"></loomi-icon>
                </span>
                <span>
                  <strong>{item.label}</strong>
                  <span>{item.detail}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
        <div class="license-panel">
          <div class="license-panel-heading">
            <span class="license-panel-mark">
              <loomi-icon name="shield-check" style="width:1.1rem;height:1.1rem"></loomi-icon>
            </span>
            <div>
              <h3 class="license-panel-title">After checkout</h3>
              <p>The buyer lands in a portal built for access and handoff.</p>
            </div>
          </div>
          <ul class="license-panel-list">
            {PRO_AFTER_CHECKOUT.map((item) => (
              <li>
                <span class:list={["license-panel-item-icon", `tone-${item.tone}`]}>
                  <loomi-icon name={item.icon} style="width:1rem;height:1rem"></loomi-icon>
                </span>
                <span>
                  <strong>{item.label}</strong>
                  <span>{item.detail}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section id="contact-sales" class="contact-sales">
        <div class="contact-sales-copy">
          <div class="feature-kicker">Enterprise sales</div>
          <h3>Enterprise licensing, built around your team</h3>
          <p>
            Tell us what you need, from seats and invoicing to SSO or private registry access.
            We’ll take it from there.
          </p>
        </div>
        <form id="sales-contact-form" class="sales-form" data-lead-endpoint={salesLeadEndpoint}>
          <div class="sales-form-heading">
            <span>Start a conversation</span>
            <strong>Tell us what your team needs</strong>
          </div>
          <loomi-input name="name" label="Name" autocomplete="name" required></loomi-input>
          <loomi-input name="email" type="email" label="Work email" autocomplete="email" required></loomi-input>
          <loomi-input name="company" label="Company" autocomplete="organization" required></loomi-input>
          <div class="sales-form-row">
            <loomi-select
              name="seats"
              label="Expected seats"
              placeholder="Choose a range"
              data={JSON.stringify(enterpriseSeatOptions)}
              required
              no-clearing
            ></loomi-select>
            <loomi-select
              name="timeline"
              label="Timeline"
              placeholder="Choose a timeline"
              data={JSON.stringify(enterpriseTimelineOptions)}
              required
              no-clearing
            ></loomi-select>
          </div>
          <loomi-textarea
            name="message"
            label="What do you need?"
            rows="4"
            value="Enterprise licensing for LoomiUI Pro"
            required
          ></loomi-textarea>
          <label class="sales-honeypot" aria-hidden="true">
            <span>Website</span>
            <input name="website" tabindex="-1" autocomplete="off" />
          </label>
          <div class="sales-form-actions">
            <loomi-button can-submit class="sales-submit">Contact sales</loomi-button>
            <p id="sales-contact-status" class="sales-status" role="status" aria-live="polite"></p>
            <loomi-alert id="sales-contact-success" class="sales-feedback" type="success" hidden>
              Sent. Sales will follow up shortly.
            </loomi-alert>
            <loomi-alert id="sales-contact-error" class="sales-feedback" type="error" hidden>
              Could not send your request. Please <a href="mailto:sales@loomiui.com">email sales@loomiui.com</a> instead.
            </loomi-alert>
            <p class="sales-privacy">
              We only use these details to respond to your enterprise licensing request.
            </p>
          </div>
        </form>
      </section>

      <section class="mt-10 rounded-2xl border border-gray-200 p-6 dark:border-gray-800">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white">How licensing works</h3>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-gray-600 dark:text-gray-300">
          {PRO_LICENSING_NOTES.map((note) => (
            <li class="flex gap-2">
              <loomi-icon name="shield-check" style="width:1rem;height:1rem;color:rgb(37 99 235);flex-shrink:0;margin-top:0.15rem"></loomi-icon>
              <span>{note}</span>
            </li>
          ))}
        </ul>
      </section>

      <div class="license-footer-actions">
        <loomi-button color="primary" size="small" tag="a" href={PRO_SIGN_IN_URL}>Already purchased? Sign in</loomi-button>
        <loomi-button type="secondary" size="small" tag="a" href="/pro/">Browse Pro catalog</loomi-button>
        <loomi-button type="secondary" size="small" tag="a" href="/components/">Browse free components</loomi-button>
      </div>
    </main>

    <footer class="border-t border-gray-200 dark:border-gray-800">
      <div class="mx-auto max-w-6xl px-6 py-10 text-sm text-gray-500 dark:text-gray-400">
        <div class="flex flex-wrap justify-center gap-6">
          <a href="/installation/" class="hover:text-primary-600 dark:hover:text-primary-400">Installation</a>
          <a href="/components/" class="hover:text-primary-600 dark:hover:text-primary-400">Components</a>
          <a href="/pro/" class="hover:text-primary-600 dark:hover:text-primary-400">Pro</a>
          <a href="/contributing/" class="hover:text-primary-600 dark:hover:text-primary-400">Contributing</a>
        </div>
        <p class="mt-6 text-center">© {new Date().getFullYear()} LoomiUI.</p>
      </div>
    </footer>

    <script type="module" is:inline>
      import "@loomidev/button";
      import "@loomidev/icon";
      import "@loomidev/alert";
      import "@loomidev/number";
      import "@loomidev/select";
      import "@loomidev/input";
      import "@loomidev/textarea";
    </script>
    <script is:inline>
      const billingButtons = Array.from(document.querySelectorAll("[data-billing-option]"));
      const licenseCards = Array.from(document.querySelectorAll(".license-card"));
      const contactForm = document.querySelector("#sales-contact-form");
      const LEAD_ENDPOINT = contactForm?.dataset.leadEndpoint ?? "";

      function teamSeats() {
        const input = document.querySelector("[data-team-seats]");
        const raw = input?.value ?? input?.getAttribute("value") ?? "5";
        const seats = Number.parseInt(String(raw), 10);
        if (!Number.isFinite(seats)) return 5;
        return Math.min(50, Math.max(2, seats));
      }

      function checkoutHref(base, plan) {
        if (!base) return base;
        if (plan !== "team") return base;
        const url = new URL(base, window.location.origin);
        url.searchParams.set("seats", String(teamSeats()));
        return url.toString();
      }

      function syncTeamCheckoutHrefs(period) {
        licenseCards.forEach((card) => {
          const checkout = card.querySelector("[data-checkout]");
          if (!checkout) return;
          const plan = checkout.dataset.plan ?? "";
          const base = checkout.dataset[`${period}Href`] ?? checkout.getAttribute("href") ?? "";
          const href = checkoutHref(base, plan);
          if (href) checkout.setAttribute("href", href);
        });
      }

      function setBillingPeriod(period) {
        billingButtons.forEach((button) => {
          const isActive = button.dataset.billingOption === period;
          button.classList.toggle("is-active", isActive);
          button.setAttribute("aria-pressed", String(isActive));
        });

        licenseCards.forEach((card) => {
          const amount = card.dataset[`${period}Amount`] ?? "";
          const suffix = card.dataset[`${period}Suffix`] ?? "";
          const detail = card.dataset[`${period}Detail`] ?? "";
          const amountNode = card.querySelector("[data-price-amount]");
          const suffixNode = card.querySelector("[data-price-suffix]");
          const detailNode = card.querySelector("[data-price-detail]");
          const checkout = card.querySelector("[data-checkout]");

          if (amountNode) amountNode.textContent = amount;
          if (suffixNode) suffixNode.textContent = suffix;
          if (detailNode) detailNode.textContent = detail;
          if (checkout) {
            const plan = checkout.dataset.plan ?? "";
            const base = checkout.dataset[`${period}Href`];
            const href = checkoutHref(base, plan);
            if (href) checkout.setAttribute("href", href);
          }
        });
      }

      billingButtons.forEach((button) => {
        button.addEventListener("click", () => setBillingPeriod(button.dataset.billingOption));
      });

      const seatsInput = document.querySelector("[data-team-seats]");
      if (seatsInput) {
        const refresh = () => {
          const active = document.querySelector("[data-billing-option].is-active");
          syncTeamCheckoutHrefs(active?.dataset.billingOption ?? "monthly");
        };
        seatsInput.addEventListener("input", refresh);
        seatsInput.addEventListener("change", refresh);
        refresh();
      }

      document.querySelectorAll("[data-checkout]").forEach((button) => {
        button.addEventListener("click", () => {
          const href = button.getAttribute("href");
          if (href) window.location.assign(href);
        });
      });

      const contactStatus = document.querySelector("#sales-contact-status");
      const contactSuccess = document.querySelector("#sales-contact-success");
      const contactError = document.querySelector("#sales-contact-error");
      const firstContactField = contactForm?.querySelector("loomi-input, loomi-textarea");

      document.querySelectorAll("[data-contact-sales]").forEach((button) => {
        button.addEventListener("click", () => {
          contactForm?.scrollIntoView({ behavior: "smooth", block: "center" });
          window.setTimeout(() => firstContactField?.focus(), 350);
        });
      });

      contactForm?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const submitButton = contactForm.querySelector("loomi-button[can-submit]");
        const formData = new FormData(contactForm);
        const lead = Object.fromEntries(formData.entries());

        if (submitButton) submitButton.disabled = true;
        if (contactSuccess) contactSuccess.hidden = true;
        if (contactError) contactError.hidden = true;
        if (contactStatus) contactStatus.textContent = "Sending...";

        try {
          // The portal holds the Slack webhook and forwards this. A real response
          // is required, so this cannot be a no-cors fire-and-forget.
          const response = await fetch(LEAD_ENDPOINT, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              name: lead.name,
              email: lead.email,
              company: lead.company,
              seats: lead.seats,
              timeline: lead.timeline,
              message: lead.message,
              website: lead.website,
              source: window.location.pathname,
            }),
          });
          if (!response.ok) throw new Error(`Lead endpoint returned ${response.status}`);
          // Keep the submitted values visible. Clearing required form-associated
          // custom elements immediately after validation makes their revealed
          // invalid state turn every empty field red, even though the request sent.
          if (contactStatus) contactStatus.textContent = "";
          if (contactSuccess) contactSuccess.hidden = false;
        } catch (error) {
          console.error("Sales lead submission failed", error);
          if (contactStatus) contactStatus.textContent = "";
          if (contactError) contactError.hidden = false;
        } finally {
          if (submitButton) submitButton.disabled = false;
        }
      });
    </script>
  </body>
</html>

<style is:global>
  .license-toolbar {
    margin-top: 2rem;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid rgb(226 232 240);
    border-radius: 0.75rem;
    background: rgb(248 250 252);
    padding: 0.55rem;
    color: rgb(71 85 105);
    font-size: 0.85rem;
  }
  .dark .license-toolbar {
    border-color: rgb(51 65 85);
    background: rgb(15 23 42 / 0.65);
    color: rgb(203 213 225);
  }
  .license-toolbar > span,
  .license-toolbar > strong {
    padding-inline: 0.45rem;
  }
  .license-toolbar > strong {
    color: rgb(21 128 61);
    font-weight: 700;
  }
  .dark .license-toolbar > strong {
    color: rgb(134 239 172);
  }
  .license-toggle {
    display: inline-grid;
    grid-template-columns: repeat(2, minmax(5.5rem, 1fr));
    gap: 0.25rem;
    border-radius: 0.55rem;
    background: rgb(226 232 240);
    padding: 0.25rem;
  }
  .dark .license-toggle {
    background: rgb(30 41 59);
  }
  .license-toggle-option {
    border: 0;
    border-radius: 0.4rem;
    background: transparent;
    color: rgb(71 85 105);
    cursor: pointer;
    font: inherit;
    font-weight: 700;
    padding: 0.45rem 0.7rem;
  }
  .license-toggle-option.is-active {
    background: white;
    color: rgb(15 23 42);
    box-shadow: 0 8px 20px -16px rgb(15 23 42 / 0.45);
  }
  .dark .license-toggle-option {
    color: rgb(203 213 225);
  }
  .dark .license-toggle-option.is-active {
    background: rgb(51 65 85);
    color: white;
  }
  .license-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 1rem;
    border: 1px solid rgb(226 232 240);
    background: white;
    padding: 1.25rem;
    scroll-margin-top: 6rem;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }
  .license-card:hover,
  .license-card:focus-within {
    border-color: rgb(37 99 235);
    box-shadow: 0 24px 55px -34px rgb(15 23 42 / 0.45);
    transform: translateY(-4px);
  }
  .dark .license-card {
    border-color: rgb(51 65 85);
    background: rgb(15 23 42 / 0.55);
  }
  .dark .license-card:hover,
  .dark .license-card:focus-within {
    border-color: rgb(96 165 250);
    box-shadow: 0 24px 55px -34px rgb(37 99 235 / 0.55);
  }
  .license-card.is-featured {
    border-color: rgb(37 99 235);
    box-shadow: 0 18px 40px -24px rgb(37 99 235 / 0.45);
  }
  .license-badge {
    position: absolute;
    top: -0.65rem;
    left: 1rem;
    border-radius: 999px;
    background: rgb(37 99 235);
    color: white;
    padding: 0.18rem 0.65rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .license-card-top {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
  }
  .license-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.75rem;
    background: rgb(239 246 255);
    color: rgb(37 99 235);
    flex-shrink: 0;
  }
  .dark .license-icon {
    background: rgb(30 58 138 / 0.35);
    color: rgb(147 197 253);
  }
  .license-name {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
    color: rgb(15 23 42);
  }
  .dark .license-name {
    color: white;
  }
  .license-tagline {
    margin: 0.2rem 0 0;
    font-size: 0.88rem;
    color: rgb(100 116 139);
  }
  .dark .license-tagline {
    color: rgb(148 163 184);
  }
  .license-price {
    margin-top: 1.25rem;
    border-radius: 0.75rem;
    background: rgb(248 250 252);
    padding: 1rem;
  }
  .dark .license-price {
    background: rgb(30 41 59 / 0.55);
  }
  .license-price > div {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }
  .license-price-amount {
    color: rgb(15 23 42);
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
  }
  .dark .license-price-amount {
    color: white;
  }
  .license-price-suffix {
    color: rgb(100 116 139);
    font-size: 0.9rem;
    font-weight: 700;
  }
  .dark .license-price-suffix {
    color: rgb(148 163 184);
  }
  .license-price p {
    margin: 0.45rem 0 0;
    color: rgb(71 85 105);
    font-size: 0.82rem;
  }
  .dark .license-price p {
    color: rgb(203 213 225);
  }
  .license-features {
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.65rem;
    flex: 1;
  }
  .license-features li {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    font-size: 0.84rem;
    line-height: 1.45;
    color: rgb(51 65 85);
  }
  .dark .license-features li {
    color: rgb(203 213 225);
  }
  .license-cta-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-top: 1.25rem;
  }
  .license-cta-group {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.75rem;
  }
  .license-cta-group > loomi-number.license-seats {
