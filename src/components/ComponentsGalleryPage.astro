---
// Gallery shell for the /components/ index page.
import { getCollection } from "astro:content";
import MarketingHeader from "./MarketingHeader.astro";
import { buildImportMap } from "../lib/import-map.mjs";
import { COMPONENT_NAMES } from "../../scripts/loomiui-packages.mjs";
import {
  DISPLAY_CATEGORIES,
  categoryKeyOf,
  categoryCounts,
} from "../lib/component-categories.mjs";
import { FALLBACK_PREVIEWS } from "../lib/preview-fallbacks.generated.mjs";
import "../styles/home.css";

const importMap = buildImportMap();
const title = "Components - LoomiUI";
const description =
  "Browse every LoomiUI component — framework-agnostic web components for forms, navigation, and content, each with a one-line usage example and full docs.";
const GITHUB_URL = "https://github.com/loomidev/loomiui-docs";

function titleCase(name: string): string {
  const special: Record<string, string> = {
    checkcards: "Checkcards",
    qrcode: "QR Code",
    "data-grid": "Data Grid",
    calendar: "Calendar",
  };
  if (special[name]) return special[name];
  return name.split("-").map((w) => w[0].toUpperCase() + w.slice(1)).join(" ");
}

// One small, real, live render per component — not a screenshot. Kept compact (small
// sizes, 1-2 children, fixed-height container) so it reads at a glance inside a card.
// Attributes here were verified against each package's own dist/loomi-*.js property
// list and src/content/docs/components/*.md usage, not guessed.
const PREVIEWS: Record<string, string> = {
  // Data Entry
  input: `<loomi-input placeholder="Type something..." size="small"></loomi-input>`,
  textarea: `<loomi-textarea placeholder="Write a message..." rows="2"></loomi-textarea>`,
  select: `<loomi-select placeholder="Select an option" size="small"></loomi-select>`,
  checkbox: `<loomi-checkbox checked>Remember me</loomi-checkbox>`,
  radio: `<loomi-radio label="Option one" name="prev-radio" checked></loomi-radio>`,
  toggle: `<loomi-toggle checked></loomi-toggle>`,
  number: `<loomi-number value="1"></loomi-number>`,
  slider: `<loomi-slider selected="60" max="100"></loomi-slider>`,
  datepicker: `<loomi-datepicker placeholder="Select date" size="small"></loomi-datepicker>`,
  timepicker: `<loomi-timepicker size="small"></loomi-timepicker>`,
  timezonepicker: `<loomi-timezonepicker selection="Africa/Accra" size="small" label="Timezone"></loomi-timezonepicker>`,
  colorpicker: `<loomi-colorpicker></loomi-colorpicker>`,
  filepicker: `<div style="height:5.5rem;width:100%;overflow:hidden;display:flex;align-items:center;justify-content:center"><loomi-filepicker name="prev-files" placeholder-line1="Drag & drop files" placeholder-line2="or click to browse" style="display:block;transform:scale(.82)"></loomi-filepicker></div>`,
  checkcards: `<loomi-checkcards name="prev-host" style="display:block;width:11rem"><loomi-checkcard value="aws" title="AWS">Cloud hosting</loomi-checkcard></loomi-checkcards>`,
  countries: `<loomi-countries name="prev-country" label="Country"></loomi-countries>`,
  creditcard: `<loomi-creditcard cardholder-name="Ama Osei" number="4242424242424242" style="max-width:9rem" no-clearing></loomi-creditcard>`,
  "text-editor": `<div style="height:5.5rem;width:100%;overflow:hidden"><loomi-text-editor label="Comment" rows="2" style="display:block;transform:scale(.78);transform-origin:top left;width:128%"></loomi-text-editor></div>`,
  "tag-input": `<loomi-tag-input placeholder="Add tag" value="Design,Docs" size="small"></loomi-tag-input>`,
  "emoji-picker": `<loomi-emoji-picker label="Reaction" selected-value="😎" size="small"></loomi-emoji-picker>`,
  password: `<loomi-password label="Password" value="Loomi2026!" size="small" strength="Aa1#"></loomi-password>`,
  pin: `<loomi-pin total-digits="4" size="small" style="transform:scale(.9)"></loomi-pin>`,
  autocomplete: `<loomi-autocomplete placeholder="Search teammates" size="small"></loomi-autocomplete>`,

  // Feedback
  alert: `<loomi-alert type="success" class="w-full text-xs">Success! Your changes were saved.</loomi-alert>`,
  notification: `<loomi-button size="small" type="secondary" outline>Save</loomi-button><loomi-notification></loomi-notification>`,
  bell: `<loomi-bell></loomi-bell>`,
  spinner: `<loomi-spinner></loomi-spinner>`,
  progress: `<loomi-progress-bar percentage="60" class="w-full"></loomi-progress-bar>`,
  processing: `<div style="transform:scale(.82)"><loomi-processing state="processing" title="Uploading…"></loomi-processing></div>`,
  "progress-steps": `<div style="transform:scale(.62);transform-origin:center;width:167%"><loomi-progress-steps current="2" style="display:block"><loomi-progress-step label="Account"></loomi-progress-step><loomi-progress-step label="Billing"></loomi-progress-step><loomi-progress-step label="Confirm"></loomi-progress-step></loomi-progress-steps></div>`,

  // Navigation
  tab: `<loomi-tabs class="w-full"><loomi-tab label="Tab 1" active></loomi-tab><loomi-tab label="Tab 2"></loomi-tab></loomi-tabs>`,
  pagination: `<loomi-pagination total="60" page-size="20" page="2" pagination-style="numbers" show-total="false"></loomi-pagination>`,
  dropmenu: `<loomi-dropmenu position="auto"><loomi-button slot="trigger" type="secondary" size="small" icon="chevron-down" icon-right>Open menu</loomi-button><loomi-dropmenu-item>Edit</loomi-dropmenu-item><loomi-dropmenu-item>Duplicate</loomi-dropmenu-item></loomi-dropmenu>`,
  "theme-switcher": `<loomi-theme-switcher style="display:block;transform:scale(.75)"></loomi-theme-switcher>`,
  "context-menu": `<loomi-context-menu><button slot="target" style="border:1px solid var(--loomi-surface-border,#e5e7eb);border-radius:.45rem;padding:.45rem .65rem;font-size:.78rem;background:var(--loomi-surface,#fff)">Right-click file</button><loomi-context-menu-item icon="document-duplicate">Duplicate</loomi-context-menu-item><loomi-context-menu-item icon="pencil-square">Rename</loomi-context-menu-item></loomi-context-menu>`,
  "bottom-nav": `<div style="height:5.5rem;width:100%;overflow:hidden;position:relative"><loomi-bottom-nav active="home" active-style="pill" style="position:absolute;bottom:0.35rem;left:50%;right:auto;transform:translateX(-50%) scale(.72);transform-origin:bottom center;width:92%"><loomi-bottom-nav-item name="home" icon="home">Home</loomi-bottom-nav-item><loomi-bottom-nav-item name="cart" icon="shopping-cart" badge="3">Cart</loomi-bottom-nav-item><loomi-bottom-nav-item name="profile" icon="user">Profile</loomi-bottom-nav-item></loomi-bottom-nav></div>`,
  "profile-menu": `<loomi-profile-menu name="Olivia Rhye" description="olivia@loomi.dev" avatar-label="OR" dotted><loomi-dropmenu-item icon="user-circle">Profile</loomi-dropmenu-item><loomi-dropmenu-item icon="cog-6-tooth">Settings</loomi-dropmenu-item></loomi-profile-menu>`,
  "side-nav": `<div style="height:5.5rem;width:100%;overflow:hidden;display:flex;justify-content:center"><loomi-side-nav label="Workspace" state="icons" style="height:100%;--loomi-side-nav-icon-width:4.25rem"><loomi-side-nav-item icon="home" label="Home" active></loomi-side-nav-item><loomi-side-nav-item icon="calendar" label="Calendar"></loomi-side-nav-item><loomi-side-nav-item icon="cog-6-tooth" label="Settings"></loomi-side-nav-item></loomi-side-nav></div>`,

  // Overlay
  modal: `<loomi-button size="small" color="primary" onclick="showLoomiModal('prev-modal')">Open Modal</loomi-button><loomi-modal name="prev-modal" title="Preview">Preview content.</loomi-modal>`,
  popover: `<loomi-popover><p>This is the popover content.</p></loomi-popover>`,
  tooltip: `<loomi-tooltip content="Tooltip text" position="top"><loomi-icon name="information-circle" style="width:1.4rem;height:1.4rem;color:var(--loomi-gray-400,#9ca3af)"></loomi-icon></loomi-tooltip>`,
  drawer: `<loomi-button size="small" type="secondary" onclick="showLoomiDrawer('prev-drawer')">Open filters</loomi-button><loomi-drawer name="prev-drawer" title="Filters">Filter controls.</loomi-drawer>`,
  "floating-panel": `<div style="height:5.5rem;width:100%;overflow:hidden;position:relative"><loomi-floating-panel name="prev-panel" title="Notes" open top="6%" left="6%" width="88%" height="82%" no-drag resizable="false" show-close-icon="false" style="position:absolute"></loomi-floating-panel></div>`,
  lightbox: `<div style="height:5.5rem;width:100%;display:flex;align-items:center;justify-content:center"><loomi-lightbox-image src="/avatars/female.jpg" alt="Portrait photo"><img src="/avatars/female.jpg" alt="Portrait photo" style="width:4.5rem;height:4.5rem;object-fit:cover;border-radius:.5rem;display:block" /></loomi-lightbox-image></div>`,

  // Data Display
  table: `<loomi-table compact data='[{"Name":"Olivia Rhye","Status":"Active"},{"Name":"Liam Carter","Status":"Invited"}]' class="w-full"></loomi-table>`,
  tag: `<loomi-tag label="New" color="primary"></loomi-tag>`,
  statistic: `<loomi-statistic number="34,500" label="Total payments"></loomi-statistic>`,
  "arc-meter": `<loomi-arc-meter markers="4" active-marker="2" title="Guarded" description="Protection level" style="--loomi-arc-meter-width:8.5rem"></loomi-arc-meter>`,
  rating: `<loomi-rating rating="4" name="prev-rating" clickable="false" color="orange"></loomi-rating>`,
  timeline: `<div style="height:5.5rem;width:100%;overflow:hidden;display:flex;align-items:center;padding-left:0.5rem"><div style="transform:scale(.8);transform-origin:left center"><loomi-timelines><loomi-timeline date="2d ago" content="Activated"></loomi-timeline></loomi-timelines></div></div>`,
  listview: `<loomi-card class="w-full"><loomi-card-content style="padding:0"><loomi-listview><loomi-listview-item><loomi-avatar size="small" image="/avatars/john.svg"></loomi-avatar><div style="font-weight:500;font-size:.78rem">Olivia Rhye</div></loomi-listview-item></loomi-listview></loomi-card-content></loomi-card>`,
  "contact-card": `<div style="transform:scale(.7)"><loomi-contact-card name="Olivia Rhye" position="Designer"></loomi-contact-card></div>`,
  chart: `<loomi-chart type="line" color="primary" data='[{"label":"1","value":12},{"label":"2","value":18},{"label":"3","value":15},{"label":"4","value":24},{"label":"5","value":21}]' style="height:3rem;width:100%;display:block"></loomi-chart>`,
  "horizontal-line-graph": `<loomi-horizontal-line-graph data='[{"label":"Direct","value":45,"color":"primary"},{"label":"Search","value":30,"color":"success"}]' style="width:100%;display:block"></loomi-horizontal-line-graph>`,
  clipboard: `<loomi-clipboard>INV-2048</loomi-clipboard>`,
  timer: `<loomi-timer duration="90" label="Sprint" style="font-size:14px"></loomi-timer>`,
  chat: `<div style="height:5.5rem;width:100%;overflow:hidden;display:flex;flex-direction:column;justify-content:center;gap:.3rem;padding:0 .5rem;transform:scale(.9)"><loomi-chat-message text="Can we ship this today?" sender="Sara" sender-id="sara" bubble-color="success" show-avatar></loomi-chat-message><loomi-chat-message text="Yes — pushing now." sender="You" sender-id="you" bubble-color="primary" outgoing show-avatar></loomi-chat-message></div>`,
  "photo-gallery": `<div style="height:5.5rem;width:100%;overflow:hidden"><loomi-photo-gallery thumb-size="90" show-slideshow="false" show-album-toggle="false" style="display:block;width:166%;transform:scale(.6);transform-origin:top left"><loomi-photo-gallery-item src="/avatars/male.jpg" thumb="/avatars/male.jpg" alt="Photo one"></loomi-photo-gallery-item><loomi-photo-gallery-item src="/avatars/female.jpg" thumb="/avatars/female.jpg" alt="Photo two"></loomi-photo-gallery-item><loomi-photo-gallery-item src="/avatars/male2.jpg" thumb="/avatars/male2.jpg" alt="Photo three" favourite></loomi-photo-gallery-item></loomi-photo-gallery></div>`,

  // Layout
  button: `<loomi-button color="primary">Button</loomi-button>`,
  "button-group": `<loomi-button-group size="small"><loomi-button-group-item label="Day" value="day" selected></loomi-button-group-item><loomi-button-group-item label="Week" value="week"></loomi-button-group-item><loomi-button-group-item label="Month" value="month"></loomi-button-group-item></loomi-button-group>`,
  card: `<loomi-card class="w-full text-left"><loomi-card-header><loomi-card-title>Card title</loomi-card-title><loomi-card-description>Card description</loomi-card-description></loomi-card-header></loomi-card>`,
  accordion: `<div style="width:100%;transform:scale(.88)"><loomi-accordion class="w-full"><loomi-accordion-item title="Section one" open></loomi-accordion-item><loomi-accordion-item title="Section two"></loomi-accordion-item></loomi-accordion></div>`,
  "centered-content": `<loomi-centered-content min-height="84px" style="display:block"><div style="font-size:.72rem;font-weight:600;text-align:center">Welcome back</div></loomi-centered-content>`,
  sortable: `<loomi-sortable items='[{"id":"a","label":"Tomatoes"},{"id":"b","label":"Lettuce"}]'></loomi-sortable>`,
  divider: `<loomi-divider label="Today" style="display:block;width:100%"></loomi-divider>`,
  resizable: `<loomi-resizable-panel-group style="height:5rem;width:100%;border:1px solid var(--loomi-surface-border,#e5e7eb);border-radius:0.5rem"><loomi-resizable-panel default-size="50%"><div style="display:flex;height:100%;align-items:center;justify-content:center;font-size:.72rem">One</div></loomi-resizable-panel><loomi-resizable-handle with-handle></loomi-resizable-handle><loomi-resizable-panel default-size="50%"><div style="display:flex;height:100%;align-items:center;justify-content:center;font-size:.72rem">Two</div></loomi-resizable-panel></loomi-resizable-panel-group>`,
  fab: `<div style="height:5.5rem;width:100%;display:flex;align-items:center;justify-content:center"><loomi-fab variant="docked" icon="plus" color="primary"></loomi-fab></div>`,

  // Media
  icon: `<div style="display:flex;gap:.6rem"><loomi-icon name="bell-alert" style="width:1.4rem;height:1.4rem"></loomi-icon><loomi-icon name="check-circle" style="width:1.4rem;height:1.4rem"></loomi-icon><loomi-icon name="trash" style="width:1.4rem;height:1.4rem"></loomi-icon></div>`,
  avatar: `<loomi-avatar label="OR" bg-color="primary" size="regular"></loomi-avatar>`,
  "empty-state": `<div style="transform:scale(.55)"><loomi-empty-state message="No documents yet."></loomi-empty-state></div>`,
  qrcode: `<loomi-qrcode url="https://loomiui.com" size="82" corner-borders gradient></loomi-qrcode>`,
  video: `<div style="height:5.5rem;width:100%;overflow:hidden;border-radius:.5rem"><loomi-video controls style="display:block;width:100%;height:100%"></loomi-video></div>`,

  "data-grid": `<div style="height:5.5rem;width:100%;overflow:hidden"><loomi-data-grid density="compact" selectable style="display:block;width:166%;transform:scale(.6);transform-origin:top left"></loomi-data-grid></div>`,
  "command-palette": `<loomi-command-palette placeholder="Search workspace"></loomi-command-palette>`,
  "date-range-picker": `<div style="transform:scale(.78);transform-origin:center"><loomi-date-range-picker label="Range" start-date="2026-06-02" end-date="2026-07-01"></loomi-date-range-picker></div>`,
  "filter-builder": `<div style="height:5.5rem;width:100%;overflow:hidden"><loomi-filter-builder style="display:block;width:150%;transform:scale(.66);transform-origin:top left"></loomi-filter-builder></div>`,
  calendar: `<div style="height:5.5rem;width:100%;overflow:hidden"><loomi-calendar view="week" week-starts="monday" style="display:block;width:140%;transform:scale(.58);transform-origin:top left"></loomi-calendar></div>`,
};

interface ComponentDocEntry {
  id: string;
  data: { title: string; description?: string };
}
const allDocs = (await getCollection("docs")) as unknown as ComponentDocEntry[];
const docsEntries = allDocs.filter((entry) => entry.id.startsWith("components/"));
const docsByName = new Map(docsEntries.map((entry) => [entry.id.replace(/^components\//, ""), entry] as const));

const components = COMPONENT_NAMES.slice()
  .sort((a, b) => a.localeCompare(b))
  .map((name) => {
    const entry = docsByName.get(name);
    const category = categoryKeyOf(name)!;
    return {
      name,
      title: entry?.data.title ?? titleCase(name),
      description: entry?.data.description ?? "",
      href: `/components/${name}/`,
      category,
      preview: PREVIEWS[name] ?? FALLBACK_PREVIEWS[name] ?? "",
    };
  });

const counts = categoryCounts();
const packagesToImport = COMPONENT_NAMES;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" />
    <script type="importmap" is:inline set:html={JSON.stringify(importMap)} />
  </head>
  <body class="bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100">
    <MarketingHeader />

    <div class="mx-auto max-w-7xl px-6 py-10 lg:grid lg:grid-cols-[15rem_1fr] lg:items-start lg:gap-10">
      <!-- Sidebar -->
      <aside class="lg:sticky lg:top-20 lg:self-start">
        <div class="relative">
          <loomi-icon name="magnifying-glass" class="search-icon" style="width:1rem;height:1rem"></loomi-icon>
          <input
            type="text"
            data-role="search-input"
            placeholder="Search components..."
            class="sidebar-search"
            aria-label="Search components"
          />
          <kbd class="search-kbd">⌘K</kbd>
        </div>

        <nav class="mt-4 space-y-0.5">
          <a href="/icons/" class="category-link">
            <span class="category-link-icon"><loomi-icon name="squares-plus" style="width:1.05rem;height:1.05rem"></loomi-icon></span>
            <span class="grow text-left">Icons</span>
          </a>
        </nav>

        <nav class="mt-4 space-y-0.5">
          <button type="button" class="category-link is-active" data-category="all">
            <span class="category-link-icon"><loomi-icon name="squares-2-x-2" style="width:1.05rem;height:1.05rem"></loomi-icon></span>
            <span class="grow text-left">All Components</span>
            <span class="category-count">{components.length}</span>
          </button>
        </nav>

        <div class="sidebar-section-label">Categories</div>
        <nav class="space-y-0.5">
          {DISPLAY_CATEGORIES.map((cat) => (
            <button type="button" class="category-link" data-category={cat.key}>
              <span class="category-link-icon"><loomi-icon name={cat.icon} style="width:1.05rem;height:1.05rem"></loomi-icon></span>
              <span class="grow text-left">{cat.label}</span>
              <span class="category-count">{counts[cat.key]}</span>
            </button>
          ))}
        </nav>

        <div class="promo-card">
          <div class="promo-card-icon"><loomi-icon name="rocket-launch" style="width:1.15rem;height:1.15rem"></loomi-icon></div>
          <div class="promo-card-title">Build faster with LoomiUI</div>
          <p class="promo-card-text">Copy, paste and ship beautiful interfaces.</p>
          <a href="/installation/" class="promo-card-link">
            Get Started
            <loomi-icon name="arrow-right" style="width:0.85rem;height:0.85rem"></loomi-icon>
          </a>
        </div>

        <div class="help-card">
          <div class="help-card-title">Need help?</div>
          <p class="help-card-text">Join the conversation or report an issue on GitHub.</p>
          <a href={`${GITHUB_URL}/discussions`} class="help-card-link">
            <loomi-icon name="chat-bubble-left-right" style="width:0.95rem;height:0.95rem"></loomi-icon>
            Discussions
          </a>
          <a href={`${GITHUB_URL}/issues`} class="help-card-link">
            <loomi-icon name="exclamation-circle" style="width:0.95rem;height:0.95rem"></loomi-icon>
            Report an issue
          </a>
        </div>
      </aside>

      <!-- Main -->
      <div class="mt-10 min-w-0 lg:mt-0">
        <div class="feature-kicker">Components</div>
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Components</h1>
        <p class="mt-3 max-w-2xl text-lg leading-7 text-gray-600 dark:text-gray-400">
          Explore our collection of {components.length}+ carefully crafted components. Click on any component to view documentation and examples.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <div class="relative grow">
            <loomi-icon name="magnifying-glass" class="search-icon" style="width:1rem;height:1rem"></loomi-icon>
            <input
              type="text"
              data-role="search-input"
              placeholder="Search components..."
              class="main-search"
              aria-label="Search components"
            />
          </div>
          <div class="relative shrink-0">
            <select id="sort-select" class="sort-select" aria-label="Sort components">
              <option value="name">Sort by: Name</option>
              <option value="category">Sort by: Category</option>
            </select>
            <loomi-icon name="chevron-down" class="sort-select-chevron" style="width:0.85rem;height:0.85rem"></loomi-icon>
          </div>
        </div>

        <div class="mt-5 flex flex-wrap gap-2" id="category-pills">
          <button type="button" class="filter-pill" aria-pressed="true" data-category="all">All</button>
          {DISPLAY_CATEGORIES.map((cat) => (
            <button type="button" class="filter-pill" aria-pressed="false" data-category={cat.key}>{cat.label}</button>
          ))}
        </div>

        <p id="no-results" class="no-results hidden">No components match your search.</p>

        <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" id="component-grid">
          {components.map((c) => (
            <a
              href={c.href}
              class="component-card"
              data-category={c.category}
              data-name={c.name.toLowerCase()}
              data-search={`${c.title} ${c.description}`.toLowerCase()}
            >
              <div class="component-card-preview" set:html={c.preview} />
              <div class="component-card-title">{c.title}</div>
              <p class="component-card-desc">{c.description}</p>
              <loomi-icon name="chevron-right" class="component-card-arrow" style="width:0.95rem;height:0.95rem"></loomi-icon>
            </a>
          ))}
        </div>

        <div class="mt-12 text-center">
          <a href="/installation/" class="inline-flex items-center gap-1 text-sm font-semibold text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300">
            Read the installation guide
            <loomi-icon name="arrow-right" style="width:0.9rem;height:0.9rem"></loomi-icon>
          </a>
          <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Components are framework agnostic and work everywhere.</p>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer class="border-t border-gray-200 dark:border-gray-800">
      <div class="mx-auto max-w-6xl px-6 py-10 text-sm text-gray-500 dark:text-gray-400">
        <div class="flex flex-wrap justify-center gap-6">
          <a href="/installation/" class="hover:text-primary-600 dark:hover:text-primary-400">Installation</a>
          <a href="/components/" class="hover:text-primary-600 dark:hover:text-primary-400">Components</a>
          <a href="/mcp-server/" class="hover:text-primary-600 dark:hover:text-primary-400">MCP Server</a>
          <a href="/cli/" class="hover:text-primary-600 dark:hover:text-primary-400">CLI</a>
          <a href="/contributing/" class="hover:text-primary-600 dark:hover:text-primary-400">Contributing</a>
        </div>
        <p class="mt-6 text-center">© {new Date().getFullYear()} LoomiUI.</p>
      </div>
    </footer>

    <script type="module" is:inline set:html={`
      const names = ${JSON.stringify(packagesToImport)};
      for (const name of names) { import("@loomidev/" + name); }

      document.querySelectorAll("loomi-data-grid").forEach((grid) => {
        grid.columns = [
          { key: "name", label: "Name", sortable: true, pinned: "start" },
          { key: "role", label: "Role" },
          { key: "status", label: "Status", pinned: "end" },
        ];
        grid.data = [
          { id: "usr_001", name: "Ama Mensah", role: "Owner", status: "Active" },
          { id: "usr_002", name: "Kojo Boateng", role: "Admin", status: "Invited" },
        ];
        grid.pagination = false;
      });

      document.querySelectorAll("loomi-command-palette").forEach((palette) => {
        palette.items = [
          { id: "go-users", label: "Open users", description: "Manage members", group: "Navigation", shortcut: "G U" },
          { id: "invite", label: "Invite member", description: "Send an invitation", group: "Actions" },
        ];
      });

      document.querySelectorAll("loomi-filter-builder").forEach((builder) => {
        builder.fields = [
          { key: "status", label: "Status", type: "select", options: [{ label: "Active", value: "Active" }, { label: "Invited", value: "Invited" }] },
          { key: "createdAt", label: "Created", type: "date" },
        ];
        builder.rules = [{ id: "status-active", field: "status", operator: "equals", value: "Active" }];
      });
    `} />

    <script>
      const grid = document.getElementById("component-grid") as HTMLElement;
      const cards = Array.from(grid.querySelectorAll<HTMLElement>(".component-card"));
      const searchInputs = document.querySelectorAll<HTMLInputElement>("[data-role='search-input']");
      const categoryButtons = document.querySelectorAll<HTMLElement>("[data-category]");
      const sortSelect = document.getElementById("sort-select") as HTMLSelectElement | null;
      const noResults = document.getElementById("no-results") as HTMLElement;

      const state = { query: "", category: "all", sort: "name" };

      function applyFilters() {
        const q = state.query.trim().toLowerCase();
        let visible = 0;
        for (const card of cards) {
          const matchesCategory = state.category === "all" || card.dataset.category === state.category;
          const matchesQuery = !q || card.dataset.search!.includes(q);
          const show = matchesCategory && matchesQuery;
          card.classList.toggle("hidden", !show);
          if (show) visible++;
        }
        noResults.classList.toggle("hidden", visible !== 0);
      }

      function applySort() {
        const sorted = cards.slice().sort((a, b) => {
          if (state.sort === "category") {
            const c = a.dataset.category!.localeCompare(b.dataset.category!);
            if (c !== 0) return c;
          }
          return a.dataset.name!.localeCompare(b.dataset.name!);
        });
        for (const card of sorted) grid.appendChild(card);
      }

      searchInputs.forEach((input) => {
        input.addEventListener("input", (e) => {
          state.query = (e.target as HTMLInputElement).value;
          searchInputs.forEach((other) => {
            if (other !== e.target) other.value = state.query;
          });
          applyFilters();
        });
      });

      categoryButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          state.category = btn.dataset.category!;
          categoryButtons.forEach((b) => {
            const active = b.dataset.category === state.category;
            b.classList.toggle("is-active", active);
            if (b.hasAttribute("aria-pressed")) b.setAttribute("aria-pressed", String(active));
          });
          applyFilters();
        });
      });

      sortSelect?.addEventListener("change", () => {
        state.sort = sortSelect.value;
        applySort();
      });

      document.addEventListener("keydown", (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
          e.preventDefault();
          (searchInputs[0] as HTMLInputElement | undefined)?.focus();
        }
      });

      applySort();
      applyFilters();
    </script>
  </body>
</html>

