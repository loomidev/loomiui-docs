---
// Pro overview hub at /pro/ — links to the templates and themes galleries.
import MarketingHeader from "./MarketingHeader.astro";
import ProSidebar from "./ProSidebar.astro";
import { buildImportMap } from "../lib/import-map.mjs";
import {
  PRO_AREAS,
  PRO_CATEGORIES,
  proAreaCounts,
  proCatalogItems,
  proCategoryCounts,
} from "../lib/pro-catalog.mjs";
import { PRO_LICENSING_URL } from "../lib/pro-licensing.mjs";
import "../styles/home.css";

const importMap = buildImportMap();
const title = "LoomiUI Pro";
const description =
  "Application starter kits, premium themes, Figma assets, and production tooling — browse everything included in LoomiUI Pro.";
const areaCounts = proAreaCounts() as Record<string, number>;
const categoryCounts = proCategoryCounts() as Record<string, number>;
const items = proCatalogItems();
const featuredTemplates = items.filter((item) => item.previewImage && item.title.endsWith("vite-lit")).slice(0, 4);
const workflowStats = [
  { label: "Template pages", value: areaCounts.templates },
  { label: "Theme assets", value: areaCounts.themes },
  { label: "Categories", value: PRO_CATEGORIES.length },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" />
    <script type="importmap" is:inline set:html={JSON.stringify(importMap)} />
  </head>
  <body class="bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100">
    <MarketingHeader />

    <div class="mx-auto max-w-7xl px-6 py-10 lg:grid lg:grid-cols-[15rem_1fr] lg:items-start lg:gap-10">
      <ProSidebar currentPath="/pro/" />

      <div class="mt-10 min-w-0 lg:mt-0">
        <section class="pro-hero">
          <div class="pro-hero-copy">
            <div class="feature-kicker">Premium UI system</div>
            <h1>LoomiUI Pro</h1>
            <p>
              Application starter kits, premium themes, Figma assets, and production tooling for teams
              building polished product interfaces with LoomiUI.
            </p>
            <div class="pro-hero-actions">
              <loomi-button color="primary" size="small" tag="a" href={PRO_LICENSING_URL}>Buy Pro</loomi-button>
              <loomi-button type="secondary" size="small" tag="a" href="/pro/licensing/">Compare licenses</loomi-button>
            </div>
            <div class="pro-stat-strip" aria-label="Pro catalog summary">
              {workflowStats.map((stat) => (
                <div class="pro-stat">
                  <strong>{stat.value}</strong>
                  <span>{stat.label}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="pro-hero-preview" aria-label="Pro product preview">
            <div class="pro-preview-toolbar">
              <span></span>
              <span></span>
              <span></span>
              <div>Loomi Pro workspace</div>
            </div>
            <div class="pro-preview-grid">
              <div class="pro-preview-pane pro-preview-pane-main">
                <div class="pro-preview-label">Template kit</div>
                <h2>Admin Pro</h2>
                <p>Dashboard, users, roles, billing, reports, settings, and ready-made states.</p>
                <div class="pro-preview-bars">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
              </div>
              <div class="pro-preview-pane">
                <div class="pro-preview-label">Theme preset</div>
                <div class="pro-swatch-row">
                  <span class="swatch-blue"></span>
                  <span class="swatch-green"></span>
                  <span class="swatch-rose"></span>
                  <span class="swatch-gold"></span>
                </div>
                <p>Semantic tokens for light, dark, high contrast, and brand variants.</p>
              </div>
              <div class="pro-preview-pane">
                <div class="pro-preview-label">Tooling</div>
                <code>loomi-pro add admin-pro</code>
                <p>Private packages, docs, and scaffold commands.</p>
              </div>
            </div>
          </div>
        </section>

        <div class="mt-10 grid gap-5 sm:grid-cols-2">
          {PRO_AREAS.map((area) => (
            <a href={area.href} class="pro-area-card">
              <span class="pro-area-icon">
                <loomi-icon name={area.icon} style="width:1.5rem;height:1.5rem"></loomi-icon>
              </span>
              <div class="pro-area-body">
                <div class="pro-area-title">{area.label}</div>
                <p class="pro-area-desc">
                  {area.key === "templates"
                    ? "Starter kits, page templates, and framework variants for shipping production apps."
                    : "Design tokens, theme presets, Figma kit, and brand assets."}
                </p>
                <span class="pro-area-count">{areaCounts[area.key]} items</span>
              </div>
              <loomi-icon name="chevron-right" class="pro-area-arrow" style="width:1rem;height:1rem"></loomi-icon>
            </a>
          ))}
        </div>

        <section class="pro-section">
          <div class="pro-section-heading">
            <div>
              <div class="feature-kicker">Featured kits</div>
              <h2>Start from a real product surface</h2>
            </div>
            <a href="/pro/templates/" class="pro-section-link">
              View templates
              <loomi-icon name="arrow-right" style="width:0.9rem;height:0.9rem"></loomi-icon>
            </a>
          </div>

          <div class="pro-template-strip">
            {featuredTemplates.map((item) => (
              <a href={item.href ?? "/pro/templates/"} class="pro-template-card">
                <img src={item.previewImage} alt={`${item.title} preview`} loading="lazy" decoding="async" />
                <div>
                  <strong>{item.title}</strong>
                  <span>{item.description}</span>
                </div>
              </a>
            ))}
          </div>
        </section>

        <section class="pro-section" id="catalog">
          <div class="pro-section-heading">
            <div>
              <div class="feature-kicker">Everything included</div>
              <h2>Browse the full Pro catalog</h2>
            </div>
            <div class="pro-sort-wrap">
              <select id="sort-select" class="sort-select" aria-label="Sort Pro catalog">
                <option value="title">Sort by: Name</option>
                <option value="category">Sort by: Category</option>
              </select>
              <loomi-icon name="chevron-down" class="sort-select-chevron" style="width:0.85rem;height:0.85rem"></loomi-icon>
            </div>
          </div>

          <div class="pro-catalog-controls">
            <div class="relative grow">
              <loomi-icon name="magnifying-glass" class="search-icon" style="width:1rem;height:1rem"></loomi-icon>
              <input
                type="text"
                data-role="search-input"
                placeholder="Search Pro templates, themes, and assets..."
                class="main-search"
                aria-label="Search Pro catalog"
              />
            </div>
          </div>

          <div class="pro-filter-row" id="area-pills" aria-label="Pro catalog areas">
            {PRO_AREAS.map((area) => (
              <button
                type="button"
                class:list={["filter-pill", area.key === "templates" && "is-active"]}
                aria-pressed={area.key === "templates" ? "true" : "false"}
                data-filter={area.key}
                data-filter-type="area"
              >
                {area.label}
              </button>
            ))}
          </div>

          <div class="pro-section-tabs" id="section-tabs" aria-label="Pro catalog sections">
            {PRO_AREAS.map((area) => (
              <button
                type="button"
                class:list={["section-tab", area.key === "templates" && "is-active", area.key !== "templates" && "hidden"]}
                aria-pressed={area.key === "templates" ? "true" : "false"}
                data-filter="all"
                data-filter-type="category"
                data-tab-area={area.key}
              >
                All {area.label.toLowerCase()}
              </button>
            ))}
            {PRO_CATEGORIES.map((cat) => (
              <button
                type="button"
                class:list={["section-tab", cat.area !== "templates" && "hidden"]}
                aria-pressed="false"
                data-filter={cat.key}
                data-filter-type="category"
                data-tab-area={cat.area}
              >
                {cat.label}
              </button>
            ))}
          </div>

          <p id="no-results" class="no-results hidden">No Pro items match your search.</p>

          <div class="pro-catalog-grid" id="pro-grid">
            {items.map((item) => {
              const category = PRO_CATEGORIES.find((cat) => cat.key === item.category);
              const area = PRO_AREAS.find((entry) => entry.key === item.area);
              const Tag = item.href ? "a" : "article";
              return (
                <Tag
                  href={item.href ?? undefined}
                  class:list={["pro-item-card", item.area !== "templates" && "hidden"]}
                  data-area={item.area}
                  data-category={item.category}
                  data-title={item.title.toLowerCase()}
                  data-search={item.search}
                >
                  <div class="pro-item-icon">
                    <loomi-icon name={item.icon} style="width:1.25rem;height:1.25rem"></loomi-icon>
                  </div>
                  <div class="pro-item-body">
                    <div class="pro-item-eyebrow">{area?.label} / {category?.label}</div>
                    <div class="pro-item-title">{item.title}</div>
                    <p>{item.description}</p>
                    <span>{categoryCounts[item.category]} in category</span>
                  </div>
                  {item.href && <loomi-icon name="chevron-right" class="pro-item-arrow" style="width:0.95rem;height:0.95rem"></loomi-icon>}
                </Tag>
              );
            })}
          </div>
        </section>

        <section id="buy-pro" class="pro-buy-band">
          <div>
            <div class="feature-kicker">Private package access</div>
            <h2>Ready to build with Pro?</h2>
            <p>
              Get application templates, premium themes, Figma kit, private docs, and updates for
              the product surfaces your team ships every week.
            </p>
          </div>
          <div class="pro-buy-actions">
            <loomi-button color="primary" size="small" tag="a" href={PRO_LICENSING_URL}>Buy Pro</loomi-button>
            <loomi-button type="secondary" size="small" tag="a" href="/components/">Browse free components</loomi-button>
          </div>
        </section>
      </div>
    </div>

    <footer class="border-t border-gray-200 dark:border-gray-800">
      <div class="mx-auto max-w-6xl px-6 py-10 text-sm text-gray-500 dark:text-gray-400">
        <div class="flex flex-wrap justify-center gap-6">
          <a href="/installation/" class="hover:text-primary-600 dark:hover:text-primary-400">Installation</a>
          <a href="/components/" class="hover:text-primary-600 dark:hover:text-primary-400">Components</a>
          <a href="/pro/" class="hover:text-primary-600 dark:hover:text-primary-400">Pro</a>
          <a href="/contributing/" class="hover:text-primary-600 dark:hover:text-primary-400">Contributing</a>
        </div>
        <p class="mt-6 text-center">© {new Date().getFullYear()} LoomiUI.</p>
      </div>
    </footer>

    <script type="module" is:inline>
      import "@loomidev/button";
      import "@loomidev/icon";
    </script>

    <script is:inline>
      const grid = document.getElementById("pro-grid");
      const cards = Array.from(grid.querySelectorAll(".pro-item-card"));
      const searchInputs = document.querySelectorAll("[data-role='search-input']");
      const filterButtons = document.querySelectorAll("[data-filter]");
      const sortSelect = document.getElementById("sort-select");
      const noResults = document.getElementById("no-results");
      const sectionTabs = document.querySelectorAll("[data-tab-area]");
      const categoryLabels = new Map(
        cards.map((card) => [card.dataset.category, card.querySelector(".pro-item-eyebrow")?.textContent ?? ""]),
      );
      const categoryAreas = new Map(cards.map((card) => [card.dataset.category, card.dataset.area]));
      const state = {
        query: "",
        area: "templates",
        category: "all",
        sort: "title",
      };

      function setActivePill() {
        filterButtons.forEach((btn) => {
          const isAreaButton = btn.dataset.filterType === "area";
          const isSectionTab = btn.dataset.filterType === "category";
          const tabArea = btn.dataset.tabArea;
          const active = isAreaButton
            ? btn.dataset.filter === state.area
            : isSectionTab && btn.dataset.filter === state.category && (!tabArea || tabArea === state.area);
          btn.classList.toggle("is-active", active);
          if (btn.hasAttribute("aria-pressed")) btn.setAttribute("aria-pressed", String(active));
        });

        sectionTabs.forEach((tab) => {
          tab.classList.toggle("hidden", tab.dataset.tabArea !== state.area);
        });
      }

      function matchesFilter(card) {
        if (card.dataset.area !== state.area) return false;
        if (state.category === "all") return true;
        return card.dataset.category === state.category;
      }

      function applyFilters() {
        const q = state.query.trim().toLowerCase();
        let visible = 0;
        for (const card of cards) {
          const show = matchesFilter(card) && (!q || card.dataset.search.includes(q));
          card.classList.toggle("hidden", !show);
          if (show) visible++;
        }
        noResults.classList.toggle("hidden", visible !== 0);
      }

      function applySort() {
        const sorted = cards.slice().sort((a, b) => {
          if (state.sort === "category") {
            const byCategory = (categoryLabels.get(a.dataset.category) ?? "").localeCompare(
              categoryLabels.get(b.dataset.category) ?? "",
            );
            if (byCategory !== 0) return byCategory;
          }
          return (a.dataset.title ?? "").localeCompare(b.dataset.title ?? "");
        });
        for (const card of sorted) grid.appendChild(card);
      }

      searchInputs.forEach((input) => {
        input.addEventListener("input", (event) => {
          state.query = event.target.value;
          searchInputs.forEach((other) => {
            if (other !== event.target) other.value = state.query;
          });
          applyFilters();
        });
      });

      filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
          if (button.dataset.filterType === "area") {
            state.area = button.dataset.filter;
            state.category = "all";
          } else {
            state.category = button.dataset.filter;
            state.area = button.dataset.tabArea ?? categoryAreas.get(state.category) ?? state.area;
          }
          setActivePill();
          applyFilters();
        });
      });

      sortSelect?.addEventListener("change", (event) => {
        state.sort = event.target.value;
        applySort();
      });

      setActivePill();
      applySort();
      applyFilters();
    </script>
  </body>
</html>

<style>
  .pro-hero {
    position: relative;
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid rgb(203 213 225);
    background:
      linear-gradient(135deg, rgb(248 250 252), rgb(239 246 255) 48%, rgb(240 253 250)),
      white;
    padding: clamp(1.25rem, 3vw, 2rem);
    display: grid;
    gap: 1.5rem;
  }
  .dark .pro-hero {
    border-color: rgb(51 65 85);
    background:
      linear-gradient(135deg, rgb(15 23 42), rgb(30 41 59) 52%, rgb(20 83 45 / 0.45)),
      rgb(15 23 42);
  }
  @media (min-width: 960px) {
    .pro-hero {
      grid-template-columns: minmax(0, 0.96fr) minmax(22rem, 1fr);
      align-items: center;
    }
  }
  .pro-hero-copy h1 {
    margin: 0.5rem 0 0;
    max-width: 12ch;
    color: rgb(15 23 42);
    font-size: clamp(2.5rem, 4.8vw, 4.25rem);
    line-height: 0.96;
    font-weight: 800;
  }
  .dark .pro-hero-copy h1 {
    color: white;
  }
  .pro-hero-copy p {
    margin-top: 1rem;
    max-width: 34rem;
    color: rgb(71 85 105);
    font-size: 1rem;
    line-height: 1.65;
  }
  .dark .pro-hero-copy p {
    color: rgb(203 213 225);
  }
  .pro-hero-actions {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .pro-stat-strip {
    margin-top: 1.75rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .pro-stat {
    border-radius: 0.75rem;
    border: 1px solid rgb(226 232 240 / 0.9);
    background: rgb(255 255 255 / 0.74);
    padding: 0.85rem;
  }
  .dark .pro-stat {
    border-color: rgb(71 85 105 / 0.8);
    background: rgb(15 23 42 / 0.72);
  }
  .pro-stat strong,
  .pro-stat span {
    display: block;
  }
  .pro-stat strong {
    color: rgb(15 23 42);
    font-size: 1.6rem;
    line-height: 1;
  }
  .dark .pro-stat strong {
    color: white;
  }
  .pro-stat span {
    margin-top: 0.25rem;
    color: rgb(100 116 139);
    font-size: 0.78rem;
    font-weight: 600;
  }
  .dark .pro-stat span {
    color: rgb(148 163 184);
  }
  .pro-hero-preview {
    border-radius: 1rem;
    border: 1px solid rgb(148 163 184 / 0.45);
    background: rgb(15 23 42);
    box-shadow: 0 30px 70px -38px rgb(15 23 42 / 0.7);
    color: white;
    min-height: 20rem;
    overflow: hidden;
  }
  .pro-preview-toolbar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
    background: rgb(2 6 23 / 0.55);
    padding: 0.8rem 1rem;
    color: rgb(148 163 184);
    font-size: 0.78rem;
    font-weight: 600;
  }
  .pro-preview-toolbar span {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 999px;
    background: rgb(248 113 113);
  }
  .pro-preview-toolbar span:nth-child(2) {
    background: rgb(250 204 21);
  }
  .pro-preview-toolbar span:nth-child(3) {
    background: rgb(74 222 128);
  }
  .pro-preview-toolbar div {
    margin-left: auto;
  }
  .pro-preview-grid {
    display: grid;
    gap: 0.85rem;
    padding: 1rem;
  }
  @media (min-width: 620px) {
    .pro-preview-grid {
      grid-template-columns: 1.15fr 0.85fr;
    }
    .pro-preview-pane-main {
      grid-row: span 2;
    }
  }
  .pro-preview-pane {
    border-radius: 0.85rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.04));
    padding: 1rem;
  }
  .pro-preview-pane h2 {
    margin: 1.25rem 0 0.45rem;
    font-size: 1.6rem;
    font-weight: 800;
  }
  .pro-preview-pane p {
    color: rgb(203 213 225);
    font-size: 0.86rem;
    line-height: 1.55;
  }
  .pro-preview-label {
    color: rgb(147 197 253);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pro-preview-bars {
    margin-top: 1.75rem;
    display: grid;
    gap: 0.65rem;
  }
  .pro-preview-bars span {
    height: 0.65rem;
    border-radius: 999px;
    background: rgb(96 165 250 / 0.42);
  }
  .pro-preview-bars span:nth-child(2) {
    width: 76%;
    background: rgb(45 212 191 / 0.42);
  }
  .pro-preview-bars span:nth-child(3) {
    width: 56%;
    background: rgb(251 191 36 / 0.44);
  }
  .pro-swatch-row {
    margin: 1rem 0 1.25rem;
    display: flex;
    gap: 0.5rem;
  }
  .pro-swatch-row span {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.65rem;
    border: 1px solid rgb(255 255 255 / 0.14);
  }
  .swatch-blue {
    background: rgb(37 99 235);
  }
  .swatch-green {
    background: rgb(16 185 129);
  }
  .swatch-rose {
    background: rgb(244 63 94);
  }
  .swatch-gold {
    background: rgb(245 158 11);
  }
  .pro-preview-pane code {
    margin: 1rem 0 0.85rem;
    display: block;
    overflow-wrap: anywhere;
    border-radius: 0.6rem;
    background: rgb(2 6 23 / 0.58);
    padding: 0.7rem;
    color: rgb(191 219 254);
    font-size: 0.8rem;
  }
  .pro-area-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    border-radius: 0.85rem;
    border: 1px solid rgb(226 232 240);
    background: white;
    padding: 1.25rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }
  .pro-area-card:hover {
    border-color: rgb(37 99 235 / 0.35);
    box-shadow: 0 12px 28px -16px rgb(37 99 235 / 0.35);
    transform: translateY(-1px);
  }
  .dark .pro-area-card {
    border-color: rgb(51 65 85);
    background: rgb(15 23 42 / 0.55);
  }
  .pro-area-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.85rem;
    background: rgb(239 246 255);
    color: rgb(37 99 235);
    flex-shrink: 0;
  }
  .dark .pro-area-icon {
    background: rgb(30 58 138 / 0.35);
    color: rgb(147 197 253);
  }
  .pro-area-body {
    flex: 1;
    min-width: 0;
  }
  .pro-area-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: rgb(15 23 42);
  }
  .dark .pro-area-title {
    color: white;
  }
  .pro-area-desc {
    margin-top: 0.35rem;
    font-size: 0.88rem;
    line-height: 1.5;
    color: rgb(100 116 139);
  }
  .dark .pro-area-desc {
    color: rgb(148 163 184);
  }
  .pro-area-count {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: rgb(37 99 235);
  }
  .dark .pro-area-count {
    color: rgb(147 197 253);
  }
  .pro-area-arrow {
    margin-top: 0.35rem;
    color: rgb(203 213 225);
    flex-shrink: 0;
  }
  .pro-area-card:hover .pro-area-arrow {
    color: rgb(37 99 235);
  }
  .pro-section {
    margin-top: 3rem;
  }
  .pro-section-heading {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  @media (min-width: 720px) {
    .pro-section-heading {
      flex-direction: row;
      align-items: end;
      justify-content: space-between;
    }
  }
  .pro-section-heading h2 {
    margin-top: 0.35rem;
    color: rgb(15 23 42);
    font-size: clamp(1.7rem, 4vw, 2.35rem);
    line-height: 1.05;
    font-weight: 800;
  }
  .dark .pro-section-heading h2 {
    color: white;
  }
  .pro-section-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: rgb(37 99 235);
    font-size: 0.88rem;
    font-weight: 700;
  }
  .pro-template-strip {
    margin-top: 1.25rem;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 720px) {
    .pro-template-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .pro-template-card {
    display: grid;
    overflow: hidden;
    border-radius: 0.85rem;
    border: 1px solid rgb(226 232 240);
