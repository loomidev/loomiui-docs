    <script>
      // Live re-theme demo: clicking a swatch overrides loomi's public --loomi-primary-*
      // tokens at :root, which every loomi component on the page already reads through
      // (var(--loomi-X, var(--_loomi-X-default))) — no per-component wiring needed.
      document.getElementById("theme-swatches")?.addEventListener("click", (e) => {
        const target = e.target;
        if (!(target instanceof Element)) return;
        const button = target.closest("button[data-color]");
        if (!(button instanceof HTMLElement)) return;
        const shadeMap: Record<string, { 500: string; 600: string; 700: string }> = {
          "#2563eb": { 500: "#3b82f6", 600: "#2563eb", 700: "#1d4ed8" },
          "#db2777": { 500: "#ec4899", 600: "#db2777", 700: "#be185d" },
          "#16a34a": { 500: "#22c55e", 600: "#16a34a", 700: "#15803d" },
          "#9333ea": { 500: "#a855f7", 600: "#9333ea", 700: "#7e22ce" },
          "#ea580c": { 500: "#f97316", 600: "#ea580c", 700: "#c2410c" },
        };
        const shades = shadeMap[button.dataset.color ?? ""] ?? shadeMap["#2563eb"];
        document.documentElement.style.setProperty("--loomi-primary-500", shades[500]);
        document.documentElement.style.setProperty("--loomi-primary-600", shades[600]);
        document.documentElement.style.setProperty("--loomi-primary-700", shades[700]);
        for (const b of document.querySelectorAll("#theme-swatches button")) {
          b.classList.toggle("ring-2", b === button);
          b.classList.toggle("ring-offset-2", b === button);
        }
      });

      // Real form participation demo: a genuine FormData read, proving form-associated
      // custom elements submit like native inputs across the shadow boundary.
      //
      // loomi-button's own native <button type="submit"> lives inside ITS shadow root,
      // and a shadow-internal native button does not automatically submit an ancestor
      // light-DOM <form> by crossing that boundary — only form-associated custom
      // elements (via ElementInternals, like loomi's form controls) get that. So the
      // button's click is wired to demoForm.requestSubmit(), which fires a real
      // `submit` event the normal way.
      const demoForm = document.getElementById("demo-form");
      document.getElementById("demo-form-submit")?.addEventListener("click", () => {
        if (demoForm instanceof HTMLFormElement) demoForm.requestSubmit();
      });
      demoForm?.addEventListener("submit", (e) => {
        e.preventDefault();
        if (!(demoForm instanceof HTMLFormElement)) return;
        const data = Object.fromEntries(new FormData(demoForm).entries());
        const out = document.getElementById("demo-form-output");
        if (out) {
          out.textContent = JSON.stringify(data, null, 2);
          out.classList.remove("hidden");
        }
      });
    </script>

