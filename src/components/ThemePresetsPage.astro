function loadThemeBundle() {
  const docsRoot = process.cwd();
  const roots = [
    resolve(docsRoot, "public/pro/themes"),
    resolve(docsRoot, "../pro/packages/themes/dist"),
  ];

  for (const root of roots) {
    const manifestFile = resolve(root, "json/manifest.json");
    if (!existsSync(manifestFile)) continue;

    const manifest = JSON.parse(readFileSync(manifestFile, "utf8"));
    const tokens: Record<string, any> = {};
    for (const preset of manifest.presets) {
      const tokenFile = resolve(root, preset.json);
      if (existsSync(tokenFile)) tokens[preset.name] = JSON.parse(readFileSync(tokenFile, "utf8"));
    }
    return { manifest, tokens };
  }

  return { manifest: { presets: fallbackPresets }, tokens: {} };
}

