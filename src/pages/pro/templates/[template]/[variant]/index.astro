---
import ProTemplatePreviewPage from "../../../../../components/ProTemplatePreviewPage.astro";

export function getStaticPaths() {
  const templates = ["admin", "saas", "crm", "analytics"];
  const variants = ["vite-lit", "next-react", "nuxt", "laravel-inertia"];
  return templates.flatMap((template) => variants.map((variant) => ({ params: { template, variant } })));
}

const { template, variant } = Astro.params;
---

<ProTemplatePreviewPage template={template!} variant={variant!} />
