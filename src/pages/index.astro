---
import { Image } from "astro:assets";
import MarketingHeader from "../components/MarketingHeader.astro";
import icon from "../assets/icon.png";
import { buildImportMap } from "../lib/import-map.mjs";
import { COMPONENT_NAMES } from "../../scripts/loomiui-packages.mjs";
import "../styles/home.css";

const importMap = buildImportMap();
const title = "LoomiUI - One component library for every frontend stack";
const description =
  "LoomiUI is a framework-agnostic library of Web Components built with Lit, fully themeable through CSS custom properties. Install a single component or the entire library";

const heroFeatures = [
  { icon: "cube", title: "Framework agnostic", desc: "Works with any stack" },
  { icon: "shield-check", title: "Accessible", desc: "Built-in a11y" },
  { icon: "adjustments-horizontal", title: "Customizable", desc: "CSS variables" },
  { icon: "sparkles", title: "Light & Dark", desc: "Theme ready" },
];

const componentCategories = ["All", "Data Entry", "Feedback", "Navigation", "Overlay", "Data Display", "Layout"];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" />
    <script type="importmap" is:inline set:html={JSON.stringify(importMap)} />
  </head>
  <body class="bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100">
    <MarketingHeader />

    <!-- Hero -->
    <div class="post-hero-backdrop">
      <section class="mx-auto max-w-7xl px-6 pb-20 pt-16 sm:pt-20">
        <div class="grid items-center gap-16 lg:grid-cols-2">
          <div>
            <div class="kicker-badge">
              <span>Open source</span><span class="kicker-dot" aria-hidden="true"></span><span>Built with Lit</span>
            </div>
            <h1 class="mt-5 text-5xl font-bold leading-[1.05] tracking-tight text-gray-950 dark:text-white sm:text-6xl">
              Beautiful components.<br />
              Built for <span class="hero-underline text-primary-600 dark:text-primary-400">every</span> frontend.
            </h1>
            <p class="mt-6 max-w-xl text-lg leading-8 text-gray-600 dark:text-gray-300">
              LoomiUI is a framework-agnostic Web Component library built with modern standards and styled your way.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-3">
              <loomi-button color="primary" tag="a" href="/installation/" icon="arrow-right" icon-right>Get Started</loomi-button>
              <loomi-button type="secondary" outline tag="a" href="/components/">Explore Components</loomi-button>
            </div>
            <div class="mt-12 grid grid-cols-2 gap-x-4 gap-y-5 sm:grid-cols-4">
              {heroFeatures.map((item) => (
                <div class="flex items-start gap-2.5">
                  <span class="hero-bullet-icon"><loomi-icon name={item.icon} style="width:1rem;height:1rem"></loomi-icon></span>
                  <div>
                    <div class="text-sm font-semibold text-gray-900 dark:text-white">{item.title}</div>
                    <div class="text-xs text-gray-500 dark:text-gray-400">{item.desc}</div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="hero-stage relative hidden min-h-[28rem] lg:block" aria-hidden="true">
            <div class="hero-stage-glow"></div>

            <div class="hero-float absolute left-0 top-2 w-52">
              <div class="text-xs font-medium text-gray-500 dark:text-gray-400">Sales Overview</div>
              <div class="mt-1 text-2xl font-bold text-gray-950 dark:text-white">$24,780</div>
              <div class="mt-0.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400">+12.6% vs last month</div>
              <div class="mt-2 h-9">
                <loomi-chart
                  type="line"
                  color="primary"
                  data='[{"label":"1","value":12},{"label":"2","value":18},{"label":"3","value":15},{"label":"4","value":24},{"label":"5","value":21},{"label":"6","value":30}]'
                ></loomi-chart>
              </div>
            </div>

            <div class="hero-float absolute right-2 top-8 flex items-center gap-1.5 font-mono text-xs text-gray-600 dark:text-gray-300">
              <loomi-icon name="code-bracket" style="width:0.9rem;height:0.9rem"></loomi-icon>
              loomi-button
            </div>

            <div class="hero-float absolute right-0 top-40 flex w-56 items-center gap-3">
              <loomi-avatar image="/avatars/female.jpg" size="small"></loomi-avatar>
              <div class="min-w-0 grow">
                <div class="truncate text-sm font-semibold text-gray-900 dark:text-white">Olivia Rhye</div>
                <div class="truncate text-xs text-gray-500 dark:text-gray-400">olivia@loomi.dev</div>
              </div>
              <loomi-icon name="chevron-down" style="width:1rem;height:1rem;color:#9ca3af"></loomi-icon>
            </div>

            <div class="hero-float absolute bottom-24 right-10 flex items-center gap-2">
              <loomi-rating rating="5" name="hero-rating" clickable="false" color="orange"></loomi-rating>
              <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">4.9 out of 5</span>
            </div>

            <div class="hero-float hero-float-round absolute bottom-0 left-10 flex items-center gap-3">
              <loomi-icon name="bolt" style="width:1rem;height:1rem;color:#9ca3af"></loomi-icon>
              <loomi-toggle checked></loomi-toggle>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- One library, every stack -->
    <section class="border-t border-gray-100 dark:border-gray-900">
      <div class="mx-auto max-w-6xl px-6 py-20 text-center">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">One component library for every frontend stack</h2>
        <p class="mt-3 text-gray-600 dark:text-gray-400">Write once. Use anywhere.</p>

        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {["App.jsx", "App.vue", "App.svelte", "index.html"].map((file) => (
            <div class="stack-card">
              <div class="stack-card-code">
                <div class="stack-card-filename">{file}</div>
                <pre><code>&lt;<span class="text-sky-400">loomi-button</span> <span class="text-violet-300">radius</span>=<span class="text-emerald-300">"full"</span>&gt;
  Save User
&lt;/<span class="text-sky-400">loomi-button</span>&gt;</code></pre>
              </div>
              <div class="stack-card-render">
                <loomi-button radius="full">Save User</loomi-button>
              </div>
            </div>
          ))}
        </div>

        <p class="mt-10 text-sm text-gray-500 dark:text-gray-400">
          Works with React, Vue, Svelte, Angular, Solid, Qwik and any web project.
        </p>
        <a href="/installation/" class="mt-2 inline-flex items-center gap-1 text-sm font-semibold text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300">
          See all integrations
          <loomi-icon name="arrow-right" style="width:0.9rem;height:0.9rem"></loomi-icon>
        </a>
      </div>
    </section>

    <!-- Everything you need to build -->
    <section class="border-t border-gray-100 bg-gray-50/60 dark:border-gray-900 dark:bg-gray-900/20">
      <div class="mx-auto max-w-6xl px-6 py-20">
        <div class="text-center">
          <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Everything you need to build</h2>
          <p class="mt-3 text-gray-600 dark:text-gray-400">
            {COMPONENT_NAMES.length}+ carefully crafted components to build modern, accessible interfaces.
          </p>
        </div>

        <div class="mt-8 flex flex-wrap justify-center gap-2" id="component-filters">
          {componentCategories.map((cat, i) => (
            <button
              type="button"
              class="filter-pill"
              data-filter={cat === "All" ? "all" : cat.toLowerCase().replace(/ /g, "-")}
              aria-pressed={i === 0 ? "true" : "false"}
            >{cat}</button>
          ))}
        </div>

        <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
          <div class="component-tile" data-cat="layout">
            <div class="component-tile-preview">
              <loomi-button color="primary">Button</loomi-button>
            </div>
            <div class="component-tile-label">Button</div>
          </div>

          <div class="component-tile" data-cat="data-entry">
            <div class="component-tile-preview">
              <loomi-input placeholder="Type something..." size="small"></loomi-input>
            </div>
            <div class="component-tile-label">Input</div>
          </div>

          <div class="component-tile" data-cat="data-entry">
            <div class="component-tile-preview">
              <loomi-select placeholder="Select an option" size="small"></loomi-select>
            </div>
            <div class="component-tile-label">Select</div>
          </div>

          <div class="component-tile" data-cat="data-entry">
            <div class="component-tile-preview">
              <loomi-checkbox checked>Remember me</loomi-checkbox>
            </div>
            <div class="component-tile-label">Checkbox</div>
          </div>

          <div class="component-tile" data-cat="data-entry">
            <div class="component-tile-preview">
              <loomi-radio label="Option one" name="grid-radio-demo" checked></loomi-radio>
            </div>
            <div class="component-tile-label">Radio</div>
          </div>

          <div class="component-tile" data-cat="data-entry">
            <div class="component-tile-preview">
              <loomi-toggle checked></loomi-toggle>
            </div>
            <div class="component-tile-label">Switch</div>
          </div>

          <div class="component-tile" data-cat="data-entry">
            <div class="component-tile-preview">
              <loomi-textarea placeholder="Write a message..." rows="2"></loomi-textarea>
            </div>
            <div class="component-tile-label">Textarea</div>
          </div>

          <div class="component-tile" data-cat="data-entry">
            <div class="component-tile-preview">
              <loomi-datepicker placeholder="Select date" size="small"></loomi-datepicker>
            </div>
            <div class="component-tile-label">Date Picker</div>
          </div>

          <div class="component-tile" data-cat="navigation">
            <div class="component-tile-preview">
              <loomi-dropmenu position="auto">
                <loomi-button slot="trigger" type="secondary" size="small" icon="chevron-down" icon-right>Open menu</loomi-button>
                <loomi-dropmenu-item>Edit</loomi-dropmenu-item>
                <loomi-dropmenu-item>Duplicate</loomi-dropmenu-item>
                <loomi-dropmenu-item>Delete</loomi-dropmenu-item>
              </loomi-dropmenu>
            </div>
            <div class="component-tile-label">Dropdown</div>
          </div>

          <div class="component-tile" data-cat="overlay">
            <div class="component-tile-preview">
              <loomi-button size="small" color="primary" onclick="showLoomiModal('grid-modal-demo')">Open Modal</loomi-button>
              <loomi-modal name="grid-modal-demo" title="A real modal">
                This modal is the actual <code>@loomidev/modal</code> package — not a screenshot.
              </loomi-modal>
            </div>
            <div class="component-tile-label">Modal</div>
          </div>

          <div class="component-tile" data-cat="data-display">
            <div class="component-tile-preview w-full">
              <loomi-table compact data='[{"Name":"Olivia Rhye","Status":"Active"},{"Name":"Liam Carter","Status":"Invited"}]'></loomi-table>
            </div>
            <div class="component-tile-label">Table</div>
          </div>

          <div class="component-tile" data-cat="layout">
            <div class="component-tile-preview w-full">
              <loomi-card class="w-full text-left">
                <loomi-card-header>
                  <div class="mb-2 h-6 w-6 rounded bg-gray-200 dark:bg-gray-700"></div>
                  <loomi-card-title>Card title</loomi-card-title>
                  <loomi-card-description>This is a card component.</loomi-card-description>
                </loomi-card-header>
              </loomi-card>
            </div>
            <div class="component-tile-label">Card</div>
          </div>

          <div class="component-tile" data-cat="feedback">
            <div class="component-tile-preview w-full">
              <loomi-alert type="success" class="w-full text-xs">Success! Your changes were saved.</loomi-alert>
            </div>
            <div class="component-tile-label">Alert</div>
          </div>

          <div class="component-tile" data-cat="navigation">
            <div class="component-tile-preview w-full">
              <loomi-tabs class="w-full">
                <loomi-tab label="Tab 1" active></loomi-tab>
                <loomi-tab label="Tab 2"></loomi-tab>
              </loomi-tabs>
            </div>
            <div class="component-tile-label">Tabs</div>
          </div>

          <div class="component-tile" data-cat="data-display">
            <div class="component-tile-preview">
              <loomi-tag label="New" color="primary"></loomi-tag>
            </div>
            <div class="component-tile-label">Badge</div>
          </div>
        </div>

        <div class="mt-10 text-center">
          <a href="/components/" class="inline-flex items-center gap-1 text-sm font-semibold text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300">
            View free components
            <loomi-icon name="arrow-right" style="width:0.9rem;height:0.9rem"></loomi-icon>
          </a>
        </div>
      </div>
    </section>

    <!-- Themed with CSS variables -->
    <section class="border-t border-gray-100 dark:border-gray-900">
      <div class="mx-auto max-w-6xl px-6 py-20 text-center">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Themed with CSS variables</h2>
        <p class="mt-3 text-gray-600 dark:text-gray-400">Fully customizable. Works with your design system.</p>

        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <div class="theme-preview-card">
              <div class="theme-mini-stack">
                <loomi-button color="primary" size="small">Primary</loomi-button>
                <loomi-input placeholder="Input field" size="small"></loomi-input>
                <loomi-select placeholder="Dropdown" size="small"></loomi-select>
              </div>
            </div>
            <div class="theme-preview-label">Light</div>
          </div>

          <div>
            <div class="dark theme-preview-card">
              <div class="theme-mini-stack">
                <loomi-button color="primary" size="small">Primary</loomi-button>
                <loomi-input placeholder="Input field" size="small"></loomi-input>
                <loomi-select placeholder="Dropdown" size="small"></loomi-select>
              </div>
            </div>
            <div class="theme-preview-label">Dark</div>
          </div>

          <div>
            <div class="theme-preview-card theme-preview-card-split">
              <div class="theme-mini-stack">
                <loomi-button color="primary" size="small">Primary</loomi-button>
                <loomi-input placeholder="Input field" size="small"></loomi-input>
                <loomi-select placeholder="Dropdown" size="small"></loomi-select>
              </div>
              <div class="dark theme-mini-stack">
                <loomi-button color="primary" size="small">Primary</loomi-button>
                <loomi-input placeholder="Input field" size="small"></loomi-input>
                <loomi-select placeholder="Dropdown" size="small"></loomi-select>
              </div>
            </div>
            <div class="theme-preview-label">Auto (System)</div>
          </div>

          <div>
            <div class="theme-preview-card theme-card-brand">
              <div class="theme-mini-stack">
                <loomi-button color="primary" size="small">Primary</loomi-button>
                <loomi-input placeholder="Input field" size="small"></loomi-input>
                <loomi-select placeholder="Dropdown" size="small"></loomi-select>
              </div>
            </div>
            <div class="theme-preview-label">Brand</div>
          </div>
        </div>

        <a href="/customization/" class="mt-10 inline-flex items-center gap-1 text-sm font-semibold text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300">
          Learn how theming works
          <loomi-icon name="arrow-right" style="width:0.9rem;height:0.9rem"></loomi-icon>
        </a>
      </div>
    </section>

    <!-- Stats -->
    <section class="stats-banner">
      <div class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-6 py-12 text-center sm:grid-cols-4">
        <div>
          <div class="text-4xl font-bold text-white">{COMPONENT_NAMES.length}+</div>
          <div class="mt-1 text-sm font-medium text-white/80">Components</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-white">0kb</div>
          <div class="mt-1 text-sm font-medium text-white/80">Global CSS shipped</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-white">100%</div>
          <div class="mt-1 text-sm font-medium text-white/80">Framework agnostic</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-white">100%</div>
          <div class="mt-1 text-sm font-medium text-white/80">Open source</div>
        </div>
      </div>
    </section>

    <!-- A real library, not a demo -->
    <section class="demo-band border-t border-gray-100 px-6 py-20 dark:border-gray-900">
      <div class="mx-auto grid max-w-6xl items-end gap-8 md:grid-cols-[0.9fr_1.1fr]">
        <div>
          <div class="text-sm font-semibold uppercase tracking-[0.18em] text-primary-600 dark:text-primary-300">
            Live product proof
          </div>
          <h2 class="mt-3 text-3xl font-bold sm:text-4xl">A real library, not a brochure.</h2>
        </div>
        <p class="max-w-2xl text-gray-600 dark:text-gray-400 md:justify-self-end">
          Every component below is the actual package, composed into a small workspace.
          Switch projects, drag tasks, open details, post a comment, or create new work
          and watch the interface respond.
        </p>
      </div>

      <loomi-card class="demo-card mx-auto mt-10 block max-w-6xl overflow-hidden" style="--loomi-card-spacing: 0">
        <div class="demo-card-bar border-b border-gray-200 px-5 py-3 dark:border-gray-800">
          <div class="flex items-center gap-2">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="demo-title-lockup text-xs font-semibold uppercase tracking-[0.16em] text-gray-500 dark:text-gray-400">
            <Image src={icon} alt="" class="h-5 w-5" />
            <span>LoomiUI project workspace</span>
          </div>
          <loomi-tag label="Interactive" color="green"></loomi-tag>
        </div>
        <div id="demo-app" class="h-[44rem] overflow-y-auto">
          <!-- Page: Dashboard -->
          <div class="demo-page" data-page="dashboard">
            <div class="flex flex-wrap items-center justify-between gap-4 border-b border-gray-200 p-5 dark:border-gray-800">
              <div>
                <div class="flex items-center gap-2">
                  <loomi-tag label="Workspace" color="primary"></loomi-tag>
                  <span id="dash-health" class="text-xs font-medium text-emerald-600 dark:text-emerald-400">On track</span>
                </div>
                <div id="dash-project-name" class="mt-2 text-xl font-bold">Homepage Redesign</div>
                <div id="dash-project-meta" class="text-sm text-gray-500">Led by Michael K. Ocansey</div>
              </div>
              <div class="flex flex-wrap items-center gap-3">
                <loomi-select
                  id="project-switcher"
                  size="small"
                  style="width: 14rem"
                  selected-value="redesign"
                ></loomi-select>
                <loomi-button id="dash-new-project" type="secondary" size="small" icon="folder-plus">New Project</loomi-button>
              </div>
            </div>

            <div class="grid grid-cols-1 gap-4 p-5 sm:grid-cols-4">
              <loomi-statistic id="stat-total" number="8" label="Total tasks" has-shadow="false"></loomi-statistic>
              <loomi-statistic id="stat-progress" number="1" label="In progress" has-shadow="false"></loomi-statistic>
              <loomi-statistic id="stat-complete" number="25%" label="Complete" has-shadow="false"></loomi-statistic>
              <loomi-statistic id="stat-due" number="6" label="Due soon" has-shadow="false"></loomi-statistic>
            </div>

            <div class="grid gap-5 px-5 pb-5 md:grid-cols-[1.2fr_0.8fr]">
              <div class="space-y-5">
                <div>
                  <div class="mb-2 text-sm font-medium text-gray-600 dark:text-gray-400">Tasks by status</div>
                  <loomi-horizontal-line-graph id="status-graph"></loomi-horizontal-line-graph>
                </div>
                <div>
                  <div class="mb-2 text-sm font-medium text-gray-600 dark:text-gray-400">Team workload</div>
                  <loomi-horizontal-line-graph id="workload-graph"></loomi-horizontal-line-graph>
                </div>
              </div>
              <div class="rounded-md border border-gray-200 bg-gray-50 p-4 dark:border-gray-800 dark:bg-gray-900">
                <div class="mb-3 flex items-center justify-between">
                  <div class="text-sm font-medium text-gray-600 dark:text-gray-400">Recent activity</div>
                  <loomi-tag id="dash-budget" label="$18k" color="green"></loomi-tag>
                </div>
                <loomi-listview id="activity-list" compact class="block"></loomi-listview>
              </div>
            </div>

            <div class="flex flex-wrap gap-3 border-t border-gray-200 p-5 dark:border-gray-800">
              <loomi-button id="dash-view-board" color="primary" size="small" icon="kanban-square">View Tasks</loomi-button>
              <loomi-button id="dash-new-task" type="secondary" size="small" icon="plus">Add Task</loomi-button>
              <loomi-button id="dash-new-project-bottom" type="secondary" size="small" icon="folder-plus">Add Project</loomi-button>
            </div>
          </div>

          <!-- Page: Board -->
          <div class="demo-page hidden" data-page="board">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-200 p-5 dark:border-gray-800">
              <loomi-button id="board-back" type="secondary" size="small" icon="arrow-left">Dashboard</loomi-button>
              <div>
                <div id="board-project-name" class="font-semibold">Homepage Redesign</div>
                <div id="board-project-lead" class="text-xs text-gray-500">Michael K. Ocansey</div>
              </div>
              <loomi-button id="board-new-task" color="primary" size="small" icon="plus">Add Task</loomi-button>
            </div>
            <div class="grid grid-cols-1 gap-4 p-5 md:grid-cols-3">
              <div>
                <div class="mb-2 flex items-center gap-2 text-sm font-medium text-gray-600 dark:text-gray-400">
                  To Do <span id="count-todo" class="rounded-full bg-gray-100 px-2 py-0.5 text-xs dark:bg-gray-800">0</span>
                </div>
                <loomi-sortable id="col-todo" type="shared" group="board"></loomi-sortable>
              </div>
              <div>
                <div class="mb-2 flex items-center gap-2 text-sm font-medium text-gray-600 dark:text-gray-400">
                  In Progress <span id="count-in-progress" class="rounded-full bg-gray-100 px-2 py-0.5 text-xs dark:bg-gray-800">0</span>
                </div>
                <loomi-sortable id="col-in-progress" type="shared" group="board"></loomi-sortable>
              </div>
              <div>
                <div class="mb-2 flex items-center gap-2 text-sm font-medium text-gray-600 dark:text-gray-400">
                  Done <span id="count-done" class="rounded-full bg-gray-100 px-2 py-0.5 text-xs dark:bg-gray-800">0</span>
                </div>
                <loomi-sortable id="col-done" type="shared" group="board"></loomi-sortable>
              </div>
            </div>
          </div>

          <!-- Page: Task detail -->
          <div class="demo-page hidden" data-page="task-detail">
            <div class="flex items-center justify-between border-b border-gray-200 p-5 dark:border-gray-800">
              <loomi-button id="detail-back" type="secondary" size="small" icon="arrow-left">Board</loomi-button>
              <loomi-tag id="detail-status" label="To Do" color="gray"></loomi-tag>
            </div>
            <div class="space-y-5 p-5">
              <div>
