---
// Gallery for /components/ — one <loomi-card> per package, linking to its docs page.
// Same "raw Astro page outside Starlight's Layout" shape as ../index.astro (see that
// file's comments for why: importmap injected by hand, home.css for Tailwind, the
// `dark` class contract driven by <loomi-theme-switcher> itself).
import { getCollection } from "astro:content";
import MarketingHeader from "../../components/MarketingHeader.astro";
import { buildImportMap } from "../../lib/import-map.mjs";
import { COMPONENT_NAMES } from "../../../scripts/loomiui-packages.mjs";
import "../../styles/home.css";

const importMap = buildImportMap();
const title = "Components - LoomiUI";
const description = "Browse every LoomiUI component — framework-agnostic web components for forms, navigation, and content, each with a one-line usage example and full docs.";

function titleCase(name: string): string {
  const special: Record<string, string> = { checkcards: "Checkcards" };
  if (special[name]) return special[name];
  return name.split("-").map((w) => w[0].toUpperCase() + w.slice(1)).join(" ");
}

// One representative, single-line usage per component, trimmed from its docs page's own
// "Basic Usage" example. Plain text shown as code, not executed — see card.md's docs for
// the full live versions.
const EXAMPLES: Record<string, string> = {
  accordion: `<loomi-accordion>...</loomi-accordion>`,
  alert: `<loomi-alert>Your subscription is expiring in 19 days.</loomi-alert>`,
  avatar: `<loomi-avatar image="/avatars/john.svg"></loomi-avatar>`,
  bell: `<loomi-bell></loomi-bell>`,
  button: `<loomi-button>Subscribe Now</loomi-button>`,
  card: `<loomi-card>Card content goes here.</loomi-card>`,
  "centered-content": `<loomi-centered-content>...</loomi-centered-content>`,
  chart: `<loomi-chart></loomi-chart>`,
  checkbox: `<loomi-checkbox>I agree to the terms</loomi-checkbox>`,
  checkcards: `<loomi-checkcards name="hosting">...</loomi-checkcards>`,
  code: `<loomi-code></loomi-code>`,
  colorpicker: `<loomi-colorpicker></loomi-colorpicker>`,
  "contact-card": `<loomi-contact-card name="Michael K. Ocansey" position="Senior Developer"></loomi-contact-card>`,
  datepicker: `<loomi-datepicker></loomi-datepicker>`,
  dropmenu: `<loomi-dropmenu>...</loomi-dropmenu>`,
  "empty-state": `<loomi-empty-state message="Awesome! You have no documents to approve."></loomi-empty-state>`,
  filepicker: `<loomi-filepicker name="certs"></loomi-filepicker>`,
  "horizontal-line-graph": `<loomi-horizontal-line-graph></loomi-horizontal-line-graph>`,
  icon: `<loomi-icon name="bell-alert"></loomi-icon>`,
  input: `<loomi-input label="Full name"></loomi-input>`,
  listview: `<loomi-listview>...</loomi-listview>`,
  modal: `<loomi-modal name="tnc-agreement" title="Agree or Disagree">...</loomi-modal>`,
  notification: `showLoomiNotification('Saved', 'Your changes were saved.')`,
  number: `<loomi-number value="1"></loomi-number>`,
  pagination: `<loomi-pagination total="240" page-size="25"></loomi-pagination>`,
  popover: `<loomi-popover>...</loomi-popover>`,
  processing: `<loomi-processing title="Uploading…" message="Please wait."></loomi-processing>`,
  progress: `<loomi-progress-bar percentage="36"></loomi-progress-bar>`,
  radio: `<loomi-radio name="tnc"></loomi-radio>`,
  rating: `<loomi-rating name="star-rating"></loomi-rating>`,
  select: `<loomi-select name="country" label="Country"></loomi-select>`,
  slider: `<loomi-slider></loomi-slider>`,
  sortable: `<loomi-sortable></loomi-sortable>`,
  spinner: `<loomi-spinner></loomi-spinner>`,
  statistic: `<loomi-statistic number="34,500,100" label="Total payments"></loomi-statistic>`,
  tab: `<loomi-tabs>...</loomi-tabs>`,
  table: `<loomi-table></loomi-table>`,
  tag: `<loomi-tag label="pending"></loomi-tag>`,
  textarea: `<loomi-textarea placeholder="Comment"></loomi-textarea>`,
  "theme-switcher": `<loomi-theme-switcher></loomi-theme-switcher>`,
  timeline: `<loomi-timelines>...</loomi-timelines>`,
  timepicker: `<loomi-timepicker></loomi-timepicker>`,
  toggle: `<loomi-toggle></loomi-toggle>`,
  tooltip: `<loomi-tooltip content="Helpful hint">...</loomi-tooltip>`,
};

// `getCollection`'s generated return type doesn't carry Starlight's docsSchema() data
// shape through to `.data` here (nothing else in this project calls getCollection/
// getEntry yet to have surfaced it) — narrowed to just the two frontmatter fields this
// page actually reads, which a `gen-component-docs.mjs` run always populates.
interface ComponentDocEntry {
  id: string;
  data: { title: string; description?: string };
}
const allDocs = (await getCollection("docs")) as unknown as ComponentDocEntry[];
const docsEntries = allDocs.filter((entry) => entry.id.startsWith("components/"));
const docsByName = new Map(docsEntries.map((entry) => [entry.id.replace(/^components\//, ""), entry] as const));

const components = COMPONENT_NAMES.slice()
  .sort((a, b) => a.localeCompare(b))
  .map((name) => {
    const entry = docsByName.get(name);
    return {
      name,
      title: entry?.data.title ?? titleCase(name),
      description: entry?.data.description ?? "",
      href: `/components/${name}/`,
      example: EXAMPLES[name] ?? "",
    };
  });
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" />
    <script type="importmap" is:inline set:html={JSON.stringify(importMap)} />
  </head>
  <body class="bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100">
    <MarketingHeader />

    <section class="mx-auto max-w-4xl px-6 pt-16 text-center">
      <div class="feature-kicker mx-auto">{components.length} components</div>
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Components</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg leading-8 text-gray-600 dark:text-gray-400">
        Every LoomiUI component, each one the real package. Open a card for the full API,
        framework snippets, and attribute reference.
      </p>
    </section>

    <section class="mx-auto max-w-7xl px-6 py-12">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {components.map((c) => (
          <a href={c.href} class="block h-full text-inherit no-underline">
            <loomi-card has-hover class="flex h-full flex-col">
              <div class="mb-1 flex items-center justify-between gap-2">
                <h2 class="text-lg font-semibold text-gray-950 dark:text-white">{c.title}</h2>
                <code class="text-xs text-gray-400 dark:text-gray-500">{`<loomi-${c.name}>`}</code>
              </div>
              <p class="mb-4 grow text-sm text-gray-600 dark:text-gray-400">{c.description}</p>
              {c.example && (
                <pre class="overflow-x-auto rounded-lg border border-gray-200 bg-gray-50 p-3 font-mono text-xs text-gray-700 dark:border-gray-800 dark:bg-gray-900 dark:text-gray-300"><code>{c.example}</code></pre>
              )}
            </loomi-card>
          </a>
        ))}
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-gray-200 dark:border-gray-800">
      <div class="mx-auto max-w-6xl px-6 py-10 text-sm text-gray-500 dark:text-gray-400">
        <div class="flex flex-wrap justify-center gap-6">
          <a href="/installation/" class="hover:text-primary-600 dark:hover:text-primary-400">Installation</a>
          <a href="/components/" class="hover:text-primary-600 dark:hover:text-primary-400">Components</a>
          <a href="/mcp-server/" class="hover:text-primary-600 dark:hover:text-primary-400">MCP Server</a>
          <a href="/contributing/" class="hover:text-primary-600 dark:hover:text-primary-400">Contributing</a>
        </div>
        <p class="mt-6 text-center">© {new Date().getFullYear()} LoomiUI.</p>
      </div>
    </footer>

    <script type="module" is:inline>
      import "@loomidev/card";
    </script>
  </body>
</html>