# Origin of the LoomiUI Pro portal app (apps/portal).
# Licensing CTAs become `${PUBLIC_LOOMI_PORTAL_URL}/pro/{solo|team}?billing={monthly|annual}`.
# The Enterprise form also posts to `${PUBLIC_LOOMI_PORTAL_URL}/api/sales-lead`.
# For local development, the portal must be running at this origin and its
# `DOCS_ORIGIN` must exactly match the docs URL, including scheme and port
# (for example, `http://localhost:4321`).
PUBLIC_LOOMI_PORTAL_URL=https://pro.loomiui.test
