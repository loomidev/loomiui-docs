---
import GoogleAnalytics from "./GoogleAnalytics.astro";
import MarketingHeader from "./MarketingHeader.astro";
import ProSidebar from "./ProSidebar.astro";
import { buildImportMap } from "../lib/import-map.mjs";
import {
  PRO_CATEGORIES,
  getProFeaturePage,
  proCatalogItems,
} from "../lib/pro-catalog.mjs";
import { PRO_LICENSING_URL } from "../lib/pro-licensing.mjs";
import "../styles/home.css";

interface Props {
  category: string;
}

const { category } = Astro.props;
const feature = getProFeaturePage(category);
if (!feature) {
  throw new Error(`Unknown Pro feature page: ${category}`);
}

const categoryMeta = PRO_CATEGORIES.find((cat) => cat.key === category)!;
const currentPath = categoryMeta.href!;
const items = proCatalogItems({ category });
const importMap = buildImportMap();
const title = `${feature.title} - LoomiUI Pro`;

const THEME_PRESETS = [
  { name: "Loomi Default", color: "#2563eb" },
  { name: "SaaS Admin", color: "#4f46e5" },
  { name: "Fintech", color: "#0d9488" },
  { name: "Healthcare", color: "#0284c7" },
  { name: "Education", color: "#7c3aed" },
  { name: "High Contrast", color: "#1d4ed8" },
];

const THEME_BUILDER_HIGHLIGHTS = [
  {
    step: "01",
    icon: "swatch",
    text: "Start from any Pro preset or compose a brand theme with createTheme()",
  },
  {
    step: "02",
    icon: "adjustments-horizontal",
    text: "Override shared, light, or dark tokens without breaking component contracts",
  },
  {
    step: "03",
    icon: "arrow-down-tray",
    text: "Export runtime CSS variables, static stylesheets, or JSON token files",
  },
  {
    step: "04",
    icon: "check-badge",
    text: "Import existing themes and validate tokens before shipping",
  },
];

const TOKEN_SYSTEM_HIGHLIGHTS = [
  {
    step: "01",
    icon: "swatch",
    text: "Primary, neutral, success, warning, and error color scales",
  },
  {
    step: "02",
    icon: "squares-2x2",
    text: "Surface, text, and focus-ring tokens consumed by LoomiUI components",
  },
  {
    step: "03",
    icon: "variable",
    text: "Typography, spacing, radius, shadow, border, motion, and z-index scales",
  },
  {
    step: "04",
    icon: "cube",
    text: "Density and component-level tokens for shells, panels, and tables",
  },
];

const ACCESSIBILITY_QUALITY_HIGHLIGHTS = [
  {
    step: "01",
    icon: "eye",
    text: "WCAG contrast review for light and dark modes",
  },
  {
    step: "02",
    icon: "cursor-arrow-rays",
    text: "Visible focus rings and keyboard-friendly component defaults",
  },
  {
    step: "03",
    icon: "pause",
    text: "Reduced-motion behavior aligned with user preferences",
  },
  {
    step: "04",
    icon: "document-text",
    text: "Migration notes and changelogs when tokens evolve",
  },
];

const FIGMA_KIT_HIGHLIGHTS = [
  {
    step: "01",
    icon: "squares-2x2",
    text: "Core and Pro component libraries with matching variants",
  },
  {
    step: "02",
    icon: "swatch",
    text: "Tokenized color and text styles synced to Pro themes",
  },
  {
    step: "03",
    icon: "rectangle-stack",
    text: "Auto-layout patterns and page layout examples",
  },
  {
    step: "04",
    icon: "beaker",
    text: "Admin, SaaS, table, form, modal, and empty-state frames",
  },
];

const ASSETS_BRAND_HIGHLIGHTS = [
  {
    step: "01",
    icon: "computer-desktop",
    text: "App shell and dashboard preview artwork",
  },
  {
    step: "02",
    icon: "photo",
    text: "Template and component gallery screenshots",
  },
  {
    step: "03",
    icon: "sparkles",
    text: "Marketing page and launch announcement visuals",
  },
  {
    step: "04",
    icon: "arrow-up-tray",
    text: "Social preview and Open Graph image templates",
  },
];

const STYLED_HIGHLIGHT_CATEGORIES = new Set([
  "token-system",
  "theme-builder",
  "accessibility-quality",
  "figma-kit",
  "assets-brand",
]);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={feature.description} />
    <link rel="icon" href="/favicon.png" />
    <script type="importmap" is:inline set:html={JSON.stringify(importMap)} />
    <GoogleAnalytics />
  </head>
  <body class="bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100">
    <MarketingHeader />

    <div class="mx-auto max-w-7xl px-6 py-10 lg:grid lg:grid-cols-[15rem_1fr] lg:items-start lg:gap-10">
      <ProSidebar currentPath={currentPath} activeCategory={category} />

      <div class="mt-10 min-w-0 lg:mt-0">
        <div class="feature-kicker">{feature.kicker}</div>
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{feature.title}</h1>
        <p class="mt-3 max-w-2xl text-lg leading-7 text-gray-600 dark:text-gray-400">
          {feature.description}
        </p>

        { !STYLED_HIGHLIGHT_CATEGORIES.has(category) && (
          <ul class="mt-6 grid gap-3 sm:grid-cols-2">
            {feature.highlights.map((line: string) => (
              <li class="flex items-start gap-2 text-sm text-gray-600 dark:text-gray-300">
                <loomi-icon name="check-circle" style="width:1rem;height:1rem;color:rgb(37 99 235);flex-shrink:0;margin-top:0.1rem"></loomi-icon>
                <span>{line}</span>
              </li>
            ))}
          </ul>
        )}

        {category === "token-system" && (
          <div class="mt-10 space-y-6">
            <div class="builder-highlights">
              <div class="builder-highlights-label">What's included</div>
              <div class="builder-highlights-grid">
                {TOKEN_SYSTEM_HIGHLIGHTS.map((item) => (
                  <div class="builder-highlight-card">
                    <div class="builder-highlight-top">
                      <span class="builder-highlight-step">{item.step}</span>
                      <span class="builder-highlight-icon">
                        <loomi-icon name={item.icon} style="width:1.1rem;height:1.1rem"></loomi-icon>
                      </span>
                    </div>
                    <p class="builder-highlight-text">{item.text}</p>
                  </div>
                ))}
              </div>
            </div>

            <div class="rounded-2xl border border-gray-200 p-5 dark:border-gray-800">
              <div class="text-sm font-semibold text-gray-900 dark:text-white">Preset palette preview</div>
              <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Ten shipped Pro themes, each with complete light and dark token sets.</p>
              <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
                {THEME_PRESETS.map((preset) => (
                  <div class="token-swatch">
                    <div class="token-swatch-color" style={`background:${preset.color}`}></div>
                    <div class="token-swatch-label">{preset.name}</div>
                  </div>
                ))}
              </div>
              <pre class="token-code"><code>{`import { themePresets, applyTheme } from "@loomidev-pro/themes";

applyTheme(themePresets.fintech, "dark");`}</code></pre>
            </div>
          </div>
        )}

        {category === "theme-builder" && (
          <div class="mt-10 space-y-6">
            <div class="builder-highlights">
              <div class="builder-highlights-label">How it works</div>
              <div class="builder-highlights-grid">
                {THEME_BUILDER_HIGHLIGHTS.map((item) => (
                  <div class="builder-highlight-card">
                    <div class="builder-highlight-top">
                      <span class="builder-highlight-step">{item.step}</span>
                      <span class="builder-highlight-icon">
                        <loomi-icon name={item.icon} style="width:1.1rem;height:1.1rem"></loomi-icon>
                      </span>
                    </div>
                    <p class="builder-highlight-text">{item.text}</p>
                  </div>
                ))}
              </div>
            </div>

            <div class="rounded-2xl border border-gray-200 p-5 dark:border-gray-800">
              <div class="text-sm font-semibold text-gray-900 dark:text-white">Compose a brand theme</div>
              <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Start from a preset, override tokens, then export to CSS, JSON, or TypeScript.</p>
              <pre class="token-code"><code>{`import { createTheme, palettes, themeToCss } from "@loomidev-pro/themes";

const brand = createTheme({
  name: "brand",
  label: "Brand",
  description: "Our product theme.",
  primary: palettes.violet,
  overrides: { shared: { radius: { md: "10px" } } }
});

const css = themeToCss(brand);`}</code></pre>
              <div class="mt-5 grid gap-3 sm:grid-cols-3">
                <div class="builder-preview">
                  <loomi-button color="primary" size="small">Primary</loomi-button>
                  <loomi-button type="secondary" size="small">Secondary</loomi-button>
                </div>
                <div class="builder-preview">
                  <loomi-input placeholder="Email" size="small"></loomi-input>
                </div>
                <div class="builder-preview">
                  <loomi-tag label="Active" color="success"></loomi-tag>
                  <loomi-tag label="Draft" color="warning"></loomi-tag>
                </div>
              </div>
            </div>
          </div>
        )}

        {category === "accessibility-quality" && (
          <div class="mt-10 space-y-6">
            <div class="builder-highlights">
              <div class="builder-highlights-label">Quality bar</div>
              <div class="builder-highlights-grid">
                {ACCESSIBILITY_QUALITY_HIGHLIGHTS.map((item) => (
                  <div class="builder-highlight-card">
                    <div class="builder-highlight-top">
                      <span class="builder-highlight-step">{item.step}</span>
                      <span class="builder-highlight-icon">
                        <loomi-icon name={item.icon} style="width:1.1rem;height:1.1rem"></loomi-icon>
                      </span>
                    </div>
                    <p class="builder-highlight-text">{item.text}</p>
                  </div>
                ))}
              </div>
            </div>

            <div class="rounded-2xl border border-gray-200 p-5 dark:border-gray-800">
              <div class="text-sm font-semibold text-gray-900 dark:text-white">Built for real users</div>
              <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">The high-contrast preset targets WCAG AAA, with strong borders and reduced motion defaults.</p>
              <div class="mt-5 grid gap-4 sm:grid-cols-2">
                <div class="a11y-card">
                  <div class="a11y-card-title">Focus visible</div>
                  <loomi-button color="primary" size="small">Tab to focus</loomi-button>
                </div>
                <div class="a11y-card dark">
                  <div class="a11y-card-title">High contrast dark</div>
                  <loomi-alert type="success" class="text-xs">Success text meets contrast targets.</loomi-alert>
                </div>
              </div>
            </div>
          </div>
        )}

        {category === "figma-kit" && (
          <div class="mt-10 space-y-6">
            <div class="builder-highlights">
              <div class="builder-highlights-label">Design system in Figma</div>
              <div class="builder-highlights-grid">
                {FIGMA_KIT_HIGHLIGHTS.map((item) => (
                  <div class="builder-highlight-card">
                    <div class="builder-highlight-top">
                      <span class="builder-highlight-step">{item.step}</span>
                      <span class="builder-highlight-icon">
                        <loomi-icon name={item.icon} style="width:1.1rem;height:1.1rem"></loomi-icon>
                      </span>
                    </div>
                    <p class="builder-highlight-text">{item.text}</p>
                  </div>
                ))}
              </div>
            </div>

            <div class="rounded-2xl border border-gray-200 p-5 dark:border-gray-800">
              <div class="text-sm font-semibold text-gray-900 dark:text-white">Designer–developer parity</div>
              <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Figma styles map to the same token names exported from `@loomidev-pro/themes`.</p>
              <div class="mt-5 grid gap-3 sm:grid-cols-3">
                <div class="figma-frame">
                  <div class="figma-frame-label">Admin dashboard</div>
                  <div class="figma-frame-body">
                    <span class="figma-chip">Sidebar</span>
                    <span class="figma-chip">Header</span>
                    <span class="figma-chip">Table</span>
                  </div>
                </div>
                <div class="figma-frame">
                  <div class="figma-frame-label">SaaS settings</div>
                  <div class="figma-frame-body">
                    <span class="figma-chip">Nav</span>
                    <span class="figma-chip">Form</span>
                    <span class="figma-chip">Panel</span>
                  </div>
                </div>
                <div class="figma-frame">
                  <div class="figma-frame-label">Component states</div>
                  <div class="figma-frame-body">
                    <span class="figma-chip">Empty</span>
                    <span class="figma-chip">Loading</span>
                    <span class="figma-chip">Modal</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}

        {category === "assets-brand" && (
          <div class="mt-10 space-y-6">
            <div class="builder-highlights">
              <div class="builder-highlights-label">Launch-ready visuals</div>
              <div class="builder-highlights-grid">
                {ASSETS_BRAND_HIGHLIGHTS.map((item) => (
                  <div class="builder-highlight-card">
                    <div class="builder-highlight-top">
                      <span class="builder-highlight-step">{item.step}</span>
                      <span class="builder-highlight-icon">
                        <loomi-icon name={item.icon} style="width:1.1rem;height:1.1rem"></loomi-icon>
                      </span>
                    </div>
                    <p class="builder-highlight-text">{item.text}</p>
                  </div>
                ))}
              </div>
            </div>

            <div class="rounded-2xl border border-gray-200 p-5 dark:border-gray-800">
              <div class="text-sm font-semibold text-gray-900 dark:text-white">Matched to Pro templates</div>
              <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Screenshots and marketing art use the same shells, themes, and components shipped in Pro.</p>
              <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                <div class="asset-preview">
                  <div class="asset-preview-bar"></div>
                  <div class="asset-preview-content"></div>
                  <div class="asset-preview-caption">Dashboard preview</div>
                </div>
                <div class="asset-preview">
                  <div class="asset-preview-bar"></div>
                  <div class="asset-preview-content wide"></div>
                  <div class="asset-preview-caption">Template screenshot</div>
                </div>
                <div class="asset-preview social">
                  <div class="asset-preview-caption">Social / OG card</div>
                </div>
              </div>
            </div>
          </div>
        )}

        <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
          <div class="relative grow">
            <loomi-icon name="magnifying-glass" class="search-icon" style="width:1rem;height:1rem"></loomi-icon>
            <input
              type="text"
              id="feature-search"
              placeholder={`Search ${feature.title.toLowerCase()}...`}
              class="main-search"
              aria-label={`Search ${feature.title}`}
            />
          </div>
        </div>

        <p id="no-results" class="no-results hidden">No items match your search.</p>

        <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3" id="feature-grid">
          {items.map((item) => (
            <article
              id={item.anchor}
              class="pro-card"
              data-search={item.search}
            >
              <div class="pro-card-preview">
                <loomi-icon name={item.icon} style="width:2rem;height:2rem;color:rgb(37 99 235)"></loomi-icon>
              </div>
              <div class="pro-card-title">{item.title}</div>
              <p class="pro-card-desc">{item.description}</p>
            </article>
          ))}
        </div>

        <div class="mt-12 flex flex-wrap gap-3">
          <loomi-button color="primary" size="small" tag="a" href={PRO_LICENSING_URL}>Buy Pro</loomi-button>
          <loomi-button type="secondary" size="small" tag="a" href="/pro/">Back to all Pro</loomi-button>
        </div>
      </div>
    </div>

    <script type="module" is:inline>
      import "@loomidev/button";
      import "@loomidev/icon";
      import "@loomidev/input";
      import "@loomidev/tag";
      import "@loomidev/alert";
    </script>

    <script>
      const grid = document.getElementById("feature-grid") as HTMLElement;
      const cards = Array.from(grid.querySelectorAll<HTMLElement>(".pro-card"));
      const searchInput = document.getElementById("feature-search") as HTMLInputElement;
      const noResults = document.getElementById("no-results") as HTMLElement;

      searchInput?.addEventListener("input", () => {
        const q = searchInput.value.trim().toLowerCase();
        let visible = 0;
        for (const card of cards) {
          const show = !q || card.dataset.search!.includes(q);
          card.classList.toggle("hidden", !show);
          if (show) visible++;
        }
        noResults.classList.toggle("hidden", visible !== 0);
      });

      if (location.hash) {
        const target = document.querySelector(location.hash);
        target?.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    </script>
  </body>
</html>

<style is:global>
  .token-swatch {
    border-radius: 0.75rem;
    border: 1px solid rgb(226 232 240);
    overflow: hidden;
    background: white;
  }
  .dark .token-swatch {
    border-color: rgb(51 65 85);
    background: rgb(15 23 42 / 0.6);
  }
  .token-swatch-color {
    height: 3rem;
  }
  .token-swatch-label {
    padding: 0.55rem 0.65rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: rgb(51 65 85);
  }
  .dark .token-swatch-label {
    color: rgb(203 213 225);
  }
  .token-code {
    margin-top: 1.25rem;
    overflow-x: auto;
    border-radius: 0.75rem;
    background: rgb(15 23 42);
    padding: 1rem;
    font-size: 0.78rem;
    line-height: 1.6;
    color: rgb(226 232 240);
  }
  .builder-preview {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    min-height: 5rem;
    border-radius: 0.75rem;
    border: 1px solid rgb(226 232 240);
    background: rgb(248 250 252);
    padding: 1rem;
  }
  .dark .builder-preview {
    border-color: rgb(51 65 85);
    background: rgb(30 41 59 / 0.5);
  }
  .builder-highlights {
    border-radius: 1rem;
    border: 1px solid rgb(191 219 254);
    background:
      linear-gradient(135deg, rgb(239 246 255), rgb(248 250 252)),
      radial-gradient(circle at 100% 0%, rgb(37 99 235 / 0.12), transparent 42%);
    padding: 1.25rem;
  }
  .dark .builder-highlights {
    border-color: rgb(30 58 138 / 0.45);
    background:
      linear-gradient(135deg, rgb(15 23 42 / 0.92), rgb(30 41 59 / 0.72)),
      radial-gradient(circle at 100% 0%, rgb(59 130 246 / 0.18), transparent 42%);
  }
  .builder-highlights-label {
    margin-bottom: 1rem;
    color: rgb(29 78 216);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .dark .builder-highlights-label {
    color: rgb(147 197 253);
  }
  .builder-highlights-grid {
    display: grid;
    gap: 0.85rem;
  }
  @media (min-width: 640px) {
    .builder-highlights-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .builder-highlight-card {
    border-radius: 0.85rem;
    border: 1px solid rgb(255 255 255 / 0.85);
    background: rgb(255 255 255 / 0.88);
    box-shadow: 0 10px 24px -18px rgb(37 99 235 / 0.45);
    padding: 1rem 1rem 1.05rem;
  }
  .dark .builder-highlight-card {
    border-color: rgb(51 65 85);
    background: rgb(15 23 42 / 0.78);
    box-shadow: 0 12px 28px -20px rgb(0 0 0 / 0.55);
  }
  .builder-highlight-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }
  .builder-highlight-step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    border-radius: 999px;
    background: rgb(37 99 235);
    padding: 0.2rem 0.55rem;
    color: white;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .dark .builder-highlight-step {
    background: rgb(59 130 246);
  }
  .builder-highlight-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.65rem;
    background: rgb(37 99 235 / 0.1);
    color: rgb(37 99 235);
  }
  .dark .builder-highlight-icon {
    background: rgb(96 165 250 / 0.14);
    color: rgb(147 197 253);
  }
  .builder-highlight-text {
    margin: 0;
    color: rgb(15 23 42);
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.55;
  }
  .dark .builder-highlight-text {
    color: rgb(241 245 249);
  }
  .a11y-card {
    border-radius: 0.75rem;
    border: 2px solid rgb(15 23 42);
    background: white;
    padding: 1rem;
  }
  .a11y-card.dark {
    background: rgb(15 23 42);
    color: white;
  }
  .a11y-card-title {
    margin-bottom: 0.75rem;
    font-size: 0.82rem;
    font-weight: 600;
  }
  .figma-frame {
    border-radius: 0.75rem;
    border: 1px solid rgb(226 232 240);
    background: rgb(248 250 252);
    padding: 0.85rem;
  }
  .dark .figma-frame {
    border-color: rgb(51 65 85);
    background: rgb(30 41 59 / 0.5);
  }
  .figma-frame-label {
    margin-bottom: 0.65rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: rgb(51 65 85);
  }
  .dark .figma-frame-label {
    color: rgb(203 213 225);
  }
  .figma-frame-body {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .figma-chip {
    border-radius: 999px;
    background: rgb(219 234 254);
    color: rgb(29 78 216);
    padding: 0.2rem 0.55rem;
    font-size: 0.68rem;
    font-weight: 600;
  }
  .dark .figma-chip {
    background: rgb(30 58 138 / 0.45);
    color: rgb(147 197 253);
  }
  .asset-preview {
    border-radius: 0.75rem;
    border: 1px solid rgb(226 232 240);
    background: linear-gradient(135deg, rgb(239 246 255), rgb(248 250 252));
    padding: 0.75rem;
    min-height: 6.5rem;
  }
  .dark .asset-preview {
    border-color: rgb(51 65 85);
    background: linear-gradient(135deg, rgb(30 41 59 / 0.8), rgb(15 23 42 / 0.6));
  }
  .asset-preview-bar {
    height: 0.45rem;
    width: 40%;
    border-radius: 999px;
    background: rgb(37 99 235 / 0.35);
    margin-bottom: 0.5rem;
  }
  .asset-preview-content {
    height: 3rem;
    border-radius: 0.5rem;
    background: rgb(255 255 255 / 0.85);
    border: 1px solid rgb(226 232 240);
  }
  .asset-preview-content.wide {
