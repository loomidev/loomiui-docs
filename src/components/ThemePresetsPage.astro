      --preview-surface-muted:${initialTokens?.color?.surface?.muted ?? "#f8fafc"};
      --preview-surface-raised:${initialTokens?.color?.surface?.raised ?? "#ffffff"};
      --preview-border:${initialTokens?.color?.surface?.border ?? "#e2e8f0"};
      --preview-text:${initialTokens?.color?.text?.base ?? "#0f172a"};
      --preview-text-muted:${initialTokens?.color?.text?.muted ?? "#64748b"};
      --preview-radius:${initialTokens?.component?.panelRadius ?? "12px"};
      --preview-shadow:${initialTokens?.component?.cardShadow ?? "0 1px 3px rgba(15,23,42,.1)"};
    `}
  >
