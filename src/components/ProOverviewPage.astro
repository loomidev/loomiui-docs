---
// Pro overview hub at /pro/ — links to the templates and themes galleries.
import MarketingHeader from "./MarketingHeader.astro";
import ProSidebar from "./ProSidebar.astro";
import { buildImportMap } from "../lib/import-map.mjs";
import { PRO_AREAS, proAreaCounts } from "../lib/pro-catalog.mjs";
import { PRO_LICENSING_URL } from "../lib/pro-licensing.mjs";
import "../styles/home.css";

const importMap = buildImportMap();
const title = "LoomiUI Pro";
const description =
  "Application starter kits, premium themes, Figma assets, and production tooling — browse everything included in LoomiUI Pro.";
const areaCounts = proAreaCounts();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" />
    <script type="importmap" is:inline set:html={JSON.stringify(importMap)} />
  </head>
  <body class="bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100">
    <MarketingHeader />

    <div class="mx-auto max-w-7xl px-6 py-10 lg:grid lg:grid-cols-[15rem_1fr] lg:items-start lg:gap-10">
      <ProSidebar currentPath="/pro/" />

      <div class="mt-10 min-w-0 lg:mt-0">
        <div class="feature-kicker">Premium</div>
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">LoomiUI Pro</h1>
        <p class="mt-3 max-w-2xl text-lg leading-7 text-gray-600 dark:text-gray-400">
          Application starter kits, premium themes, Figma assets, and production tooling.
          Browse {areaCounts.templates + areaCounts.themes} customer-facing items included with Pro.
        </p>

        <div class="mt-10 grid gap-5 sm:grid-cols-2">
          {PRO_AREAS.map((area) => (
            <a href={area.href} class="pro-area-card">
              <span class="pro-area-icon">
                <loomi-icon name={area.icon} style="width:1.5rem;height:1.5rem"></loomi-icon>
              </span>
              <div class="pro-area-body">
                <div class="pro-area-title">{area.label}</div>
                <p class="pro-area-desc">
                  {area.key === "templates"
                    ? "Starter kits, page templates, and framework variants for shipping production apps."
                    : "Design tokens, theme presets, Figma kit, and brand assets."}
                </p>
                <span class="pro-area-count">{areaCounts[area.key]} items</span>
              </div>
              <loomi-icon name="chevron-right" class="pro-area-arrow" style="width:1rem;height:1rem"></loomi-icon>
            </a>
          ))}
        </div>

        <div id="buy-pro" class="mt-12 rounded-2xl border border-primary-200 bg-primary-50 p-8 text-center dark:border-primary-900/40 dark:bg-primary-950/30">
          <h2 class="text-2xl font-bold tracking-tight">Ready to build with Pro?</h2>
          <p class="mx-auto mt-3 max-w-xl text-gray-600 dark:text-gray-400">
            Get application templates, premium themes, Figma kit, private docs, and updates.
          </p>
          <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
            <loomi-button color="primary" size="small" tag="a" href={PRO_LICENSING_URL}>Buy Pro</loomi-button>
            <loomi-button type="secondary" size="small" tag="a" href="/components/">Browse free components</loomi-button>
          </div>
        </div>
      </div>
    </div>

    <script type="module" is:inline>
      import "@loomidev/button";
      import "@loomidev/icon";
    </script>
  </body>
</html>

<style>
  .pro-area-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    border-radius: 1rem;
    border: 1px solid rgb(226 232 240);
    background: white;
    padding: 1.25rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }
  .pro-area-card:hover {
    border-color: rgb(37 99 235 / 0.35);
    box-shadow: 0 12px 28px -16px rgb(37 99 235 / 0.35);
    transform: translateY(-1px);
  }
  .dark .pro-area-card {
    border-color: rgb(51 65 85);
    background: rgb(15 23 42 / 0.55);
  }
  .pro-area-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.85rem;
    background: rgb(239 246 255);
    color: rgb(37 99 235);
    flex-shrink: 0;
  }
  .dark .pro-area-icon {
    background: rgb(30 58 138 / 0.35);
    color: rgb(147 197 253);
  }
  .pro-area-body {
    flex: 1;
    min-width: 0;
  }
  .pro-area-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: rgb(15 23 42);
  }
  .dark .pro-area-title {
    color: white;
  }
  .pro-area-desc {
    margin-top: 0.35rem;
    font-size: 0.88rem;
    line-height: 1.5;
    color: rgb(100 116 139);
  }
  .dark .pro-area-desc {
    color: rgb(148 163 184);
  }
  .pro-area-count {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: rgb(37 99 235);
  }
  .dark .pro-area-count {
    color: rgb(147 197 253);
  }
  .pro-area-arrow {
    margin-top: 0.35rem;
    color: rgb(203 213 225);
    flex-shrink: 0;
  }
  .pro-area-card:hover .pro-area-arrow {
    color: rgb(37 99 235);
  }
</style>
