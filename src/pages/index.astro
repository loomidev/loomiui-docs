---
import { Image } from "astro:assets";
import MarketingHeader from "../components/MarketingHeader.astro";
import icon from "../assets/icon.png";
import { buildImportMap } from "../lib/import-map.mjs";
import "../styles/home.css";

const importMap = buildImportMap();
const title = "loomiui — Web components, themeable like it's 2015 again";
const description =
  "LoomiUI is a framework-agnostic library of Web Components built with Lit, fully themeable through CSS custom properties. Install a single component or the entire library";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" />
    <script type="importmap" is:inline set:html={JSON.stringify(importMap)} />
  </head>
  <body class="bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100">
    <MarketingHeader />

    <!-- Hero -->
    <section class="home-hero relative isolate overflow-hidden">
      <div class="hero-mesh" aria-hidden="true">
        <div class="hero-mesh-plane"></div>
        <div class="hero-mesh-lines"></div>
      </div>

      <div class="relative mx-auto max-w-5xl px-6 pb-[30px] pt-24 text-center sm:pt-32">
        <div class="mx-auto inline-flex items-center gap-2 rounded-full border border-gray-200 bg-white/85 px-4 py-2 text-xs font-semibold uppercase tracking-[0.16em] text-primary-700 shadow-sm backdrop-blur dark:border-white/10 dark:bg-gray-950/70 dark:text-primary-300">
          44 Lit components. One CSS variable away from your brand.
        </div>
        <h1 class="mx-auto mt-7 max-w-4xl text-5xl font-bold tracking-tight text-gray-950 dark:text-white sm:text-7xl">
          Web components that feel custom-built.
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-gray-600 dark:text-gray-300">
          LoomiUI ships real custom elements with scoped styles, form participation,
          per-component installs, and an MCP server that helps AI tools use the API
          correctly.
        </p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          <loomi-button color="primary" size="medium" tag="a" href="/installation/" icon="arrow-right" icon-right>
            Get Started
          </loomi-button>
        </div>
      </div>
    </section>

    <div class="post-hero-backdrop">
    <!-- Why LoomiUI — intro -->
    <section class="feature-intro mx-auto max-w-4xl px-6 pt-0 text-center">
      <div class="feature-kicker mx-auto">Designed for the messy middle</div>
      <h2 class="text-4xl font-bold tracking-tight sm:text-5xl">Why LoomiUI</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg leading-8 text-gray-600 dark:text-gray-400">
        Six reasons LoomiUI feels different from a typical component kit, each one
        shown with the same live components your app can import.
      </p>
    </section>

    <!-- Feature 1 — Framework-agnostic -->
    <section class="feature-section">
      <div class="feature-row mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 sm:grid-cols-2">
        <div class="feature-copy">
          <div class="feature-eyebrow">01 / Portability</div>
          <h3 class="text-2xl font-bold sm:text-3xl">Actually framework-agnostic</h3>
          <p class="mt-4 text-gray-600 dark:text-gray-400">
            Every component is a real custom element built with Lit. Drop
            <code>&lt;loomi-button&gt;</code> into React, Vue, Svelte, plain HTML, or a CMS
            template — no wrapper packages, no framework-specific build. It's the exact
            same tag, everywhere, because it's just a custom element.
          </p>
        </div>
        <div class="feature-panel framework-panel space-y-3">
          <div class="feature-panel-label">Same markup, four homes</div>
          <div class="grid grid-cols-1 gap-3 text-xs">
            {["App.jsx", "App.vue", "App.svelte", "index.html"].map((file) => (
              <div class="code-tile rounded-lg border border-gray-200 bg-gray-50 p-3 font-mono dark:border-gray-800 dark:bg-gray-900">
                <div class="mb-1 text-gray-400">{file}</div>
                <code class="break-all">&lt;loomi-button color="primary"&gt;Buy now&lt;/loomi-button&gt;</code>
              </div>
            ))}
          </div>
          <div class="component-stage flex items-center justify-center rounded-lg border border-dashed border-gray-300 p-6 dark:border-gray-700">
            <loomi-button color="primary">Buy now</loomi-button>
          </div>
        </div>
      </div>
    </section>

    <!-- Feature 2 — No Tailwind at runtime -->
    <section class="feature-section feature-section-muted">
      <div class="feature-row mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 sm:grid-cols-2">
        <div class="feature-copy sm:order-2">
          <div class="feature-eyebrow">02 / Scoped styling</div>
          <h3 class="text-2xl font-bold sm:text-3xl">No Tailwind at runtime</h3>
          <p class="mt-4 text-gray-600 dark:text-gray-400">
            Components are authored with Tailwind, but it's compiled away at build time
            and inlined into each component's Shadow DOM. Consumers never install
            Tailwind and never fight a global stylesheet — styles can't leak in or out.
          </p>
        </div>
        <div class="feature-panel runtime-panel space-y-4 sm:order-1">
          <div class="feature-panel-label">Global payload check</div>
          <div>
            <div class="mb-1 flex justify-between text-xs text-gray-500">
              <span>Typical UI kit + Tailwind</span><span>~38kb CSS</span>
            </div>
            <div class="h-2 w-full overflow-hidden rounded-full bg-gray-200 dark:bg-gray-800">
              <div class="h-full w-[95%] rounded-full bg-gray-400 dark:bg-gray-600"></div>
            </div>
          </div>
          <div>
            <div class="mb-1 flex justify-between text-xs text-gray-500">
              <span>@loomi/button, installed alone</span><span>0kb global CSS</span>
            </div>
            <div class="h-2 w-full overflow-hidden rounded-full bg-gray-200 dark:bg-gray-800">
              <div class="h-full w-[4%] rounded-full bg-primary-600"></div>
            </div>
          </div>
          <div class="flex items-center justify-center rounded-lg border border-dashed border-primary-300 p-6 dark:border-primary-800">
            <loomi-button color="primary" outline>Styled, scoped, shipped</loomi-button>
          </div>
        </div>
      </div>
    </section>

    <!-- Feature 3 — Theme with one CSS variable -->
    <section class="feature-section">
      <div class="feature-row mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 sm:grid-cols-2">
        <div class="feature-copy">
          <div class="feature-eyebrow">03 / Brand control</div>
          <h3 class="text-2xl font-bold sm:text-3xl">Theme with one CSS variable</h3>
          <p class="mt-4 text-gray-600 dark:text-gray-400">
            Override <code>--loomi-primary-600</code> (or any of the 14 palette colors)
            from your page's own CSS and every component re-skins instantly — no
            rebuild, no config file. Try it on the right.
          </p>
        </div>
        <div class="feature-panel theme-panel">
          <div class="feature-panel-label">Live theme tokens</div>
          <div class="signup-showcase">
            <div class="flex items-center justify-between gap-4">
              <div>
                <div class="text-sm font-bold text-gray-950 dark:text-white">Create workspace</div>
                <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Every primary control below follows the selected token.</p>
              </div>
              <loomi-tag label="68% ready" color="primary"></loomi-tag>
            </div>
            <div class="mt-5 grid gap-3 sm:grid-cols-2">
              <loomi-input name="signup_name" label="Name" prefix-icon="user" value="Maya Chen"></loomi-input>
              <loomi-input name="signup_email" label="Email" type="email" prefix-icon="envelope" value="maya@studio.dev"></loomi-input>
            </div>
            <div class="mt-4 grid gap-4 sm:grid-cols-[1fr_0.8fr]">
              <div>
                <div class="mb-2 text-xs font-semibold text-gray-500 dark:text-gray-400">Launch readiness</div>
                <loomi-slider name="readiness" color="primary" selected="68" show-values></loomi-slider>
              </div>
              <div class="space-y-2">
                <loomi-checkbox color="primary" checked>Invite teammates</loomi-checkbox>
                <loomi-toggle color="primary" checked label="Weekly digest" label-position="right"></loomi-toggle>
              </div>
            </div>
            <div class="mt-4">
              <loomi-progress-bar percentage="68" color="primary"></loomi-progress-bar>
            </div>
            <div class="mt-5 flex justify-end">
              <loomi-button color="primary" size="small" icon="arrow-right" icon-right>Create account</loomi-button>
            </div>
          </div>
          <div class="mt-6 flex gap-3" id="theme-swatches">
            <button type="button" class="size-8 rounded-full bg-[#2563eb] ring-2 ring-offset-2 ring-offset-gray-50 dark:ring-offset-gray-900" data-color="#2563eb" aria-label="Blue"></button>
            <button type="button" class="size-8 rounded-full bg-[#db2777]" data-color="#db2777" aria-label="Pink"></button>
            <button type="button" class="size-8 rounded-full bg-[#16a34a]" data-color="#16a34a" aria-label="Green"></button>
            <button type="button" class="size-8 rounded-full bg-[#9333ea]" data-color="#9333ea" aria-label="Purple"></button>
            <button type="button" class="size-8 rounded-full bg-[#ea580c]" data-color="#ea580c" aria-label="Orange"></button>
          </div>
        </div>
      </div>
    </section>

    <!-- Feature 4 — Install exactly what you need -->
    <section class="feature-section feature-section-muted">
      <div class="feature-row mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 sm:grid-cols-2">
        <div class="feature-copy sm:order-2">
          <div class="feature-eyebrow">04 / Package shape</div>
          <h3 class="text-2xl font-bold sm:text-3xl">Install exactly what you need</h3>
          <p class="mt-4 text-gray-600 dark:text-gray-400">
            <code>npm install @loomi/button</code> pulls in only the button and its
            direct dependencies. Want everything? <code>npm install @loomi/components</code>
            gets the whole library in one shot.
          </p>
        </div>
        <div class="feature-panel install-visual sm:order-1">
          <div class="feature-panel-label">Install map</div>
          <div class="install-track">
            <div class="install-command">
              <span>single component</span>
              <code>npm install @loomi/button lit</code>
            </div>
            <div class="install-arrow">or</div>
            <div class="install-command install-command-full">
              <span>entire library</span>
              <code>npm install @loomi/components lit</code>
            </div>
          </div>
          <div class="install-grid mt-5">
            {Array.from({ length: 44 }).map((_, i) => (
              <span class:list={["install-dot", i === 0 ? "selected" : i < 12 ? "category" : ""]}></span>
            ))}
          </div>
          <div class="mt-5 grid gap-3 sm:grid-cols-3">
            <div class="install-stat">
              <strong>1</strong>
              <span>button package</span>
            </div>
            <div class="install-stat">
              <strong>12</strong>
              <span>category bundles</span>
            </div>
            <div class="install-stat">
              <strong>44</strong>
              <span>full suite</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Feature 5 — Real form participation -->
    <section class="feature-section">
      <div class="feature-row mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 sm:grid-cols-2">
        <div class="feature-copy">
          <div class="feature-eyebrow">05 / Native behavior</div>
          <h3 class="text-2xl font-bold sm:text-3xl">Real form participation</h3>
          <p class="mt-4 text-gray-600 dark:text-gray-400">
            Every form control is form-associated via <code>ElementInternals</code> —
            they submit with a native <code>&lt;form&gt;</code> like any built-in input,
            across the shadow boundary. Fill this in and submit it — the values on the
            right come straight from a real <code>FormData</code>.
          </p>
        </div>
        <form id="demo-form" class="feature-panel form-panel space-y-4">
          <div class="feature-panel-label">Native submit path</div>
          <loomi-input name="full_name" label="Full name" required></loomi-input>
          <loomi-select
            name="plan"
            label="Plan"
            selected-value="pro"
            data='[{"label":"Starter","value":"starter"},{"label":"Pro","value":"pro"}]'
          ></loomi-select>
          <loomi-datepicker
            name="launch_date"
            label="Launch date"
            selected-value="2026-07-15"
            min-date="2026-06-25"
          ></loomi-datepicker>
          <div class="flex flex-col items-center justify-center gap-2 text-center">
            <loomi-button id="demo-form-submit" can-submit color="primary" size="small">Submit</loomi-button>
            <span class="text-xs text-gray-500">Real FormData, right below ↓</span>
          </div>
          <pre id="demo-form-output" class="hidden overflow-x-auto rounded bg-gray-900 p-3 text-xs text-gray-100 dark:bg-black"></pre>
        </form>
      </div>
    </section>

    <!-- Feature 6 — Built for AI-assisted coding -->
    <section class="feature-section feature-section-muted">
      <div class="feature-row mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 sm:grid-cols-2">
        <div class="feature-copy sm:order-2">
          <div class="feature-eyebrow">06 / AI context</div>
          <h3 class="text-2xl font-bold sm:text-3xl">Built for AI-assisted coding</h3>
          <p class="mt-4 text-gray-600 dark:text-gray-400">
            Ships an MCP server alongside the library so Claude Code, Cursor, and other
            AI tools can look up real attribute tables instead of guessing at your API.
          </p>
        </div>
        <div class="feature-panel ai-panel space-y-4 text-sm sm:order-1">
          <div class="feature-panel-label">Grounded component answers</div>
          <div class="ai-console">
            <div class="ai-prompt">
              <span>Prompt</span>
              <p>Build a primary CTA with an icon, submit behavior, and a link fallback.</p>
            </div>
            <div class="ai-answer">
              <div class="mb-2 flex items-center justify-between gap-3">
                <span class="font-sans text-[10px] font-semibold uppercase tracking-[0.16em] text-primary-600 dark:text-primary-300">loomi MCP lookup</span>
                <loomi-tag label="verified attrs" color="green"></loomi-tag>
              </div>
              <pre><code>&lt;loomi-button
  color="primary"
  icon="arrow-right"
  icon-right
  can-submit
&gt;Continue&lt;/loomi-button&gt;</code></pre>
            </div>
          </div>
          <div class="ai-attrs">
            {["color", "size", "icon", "icon-right", "tag", "href", "can-submit", "disabled"].map((attr) => (
              <span>{attr}</span>
            ))}
          </div>
          <div class="ai-footer">
            <loomi-button color="primary" size="small" icon="sparkles">Ask with context</loomi-button>
            <p>Fewer hallucinated props. More copy-pasteable UI.</p>
          </div>
        </div>
      </div>
    </section>
    </div>

    <!-- A real library, not a demo -->
    <section class="demo-band border-t border-gray-100 px-6 py-20 dark:border-gray-900">
      <div class="mx-auto grid max-w-6xl items-end gap-8 md:grid-cols-[0.9fr_1.1fr]">
        <div>
          <div class="text-sm font-semibold uppercase tracking-[0.18em] text-primary-600 dark:text-primary-300">
            Live product proof
          </div>
          <h2 class="mt-3 text-3xl font-bold sm:text-4xl">A real library, not a brochure.</h2>
        </div>
        <p class="max-w-2xl text-gray-600 dark:text-gray-400 md:justify-self-end">
          Every component below is the actual package, composed into a small workspace.
          Switch projects, drag tasks, open details, post a comment, or create new work
          and watch the interface respond.
        </p>
      </div>

      <loomi-card class="demo-card mx-auto mt-10 block max-w-6xl overflow-hidden" no-padding has-hover="false">
        <div class="demo-card-bar border-b border-gray-200 px-5 py-3 dark:border-gray-800">
          <div class="flex items-center gap-2">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="demo-title-lockup text-xs font-semibold uppercase tracking-[0.16em] text-gray-500 dark:text-gray-400">
            <Image src={icon} alt="" class="h-5 w-5" />
            <span>LoomiUI project workspace</span>
          </div>
          <loomi-tag label="Interactive" color="green"></loomi-tag>
        </div>
        <div id="demo-app" class="h-[44rem] overflow-y-auto">
          <!-- Page: Dashboard -->
          <div class="demo-page" data-page="dashboard">
            <div class="flex flex-wrap items-center justify-between gap-4 border-b border-gray-200 p-5 dark:border-gray-800">
              <div>
                <div class="flex items-center gap-2">
                  <loomi-tag label="Workspace" color="primary"></loomi-tag>
                  <span id="dash-health" class="text-xs font-medium text-emerald-600 dark:text-emerald-400">On track</span>
                </div>
                <div id="dash-project-name" class="mt-2 text-xl font-bold">Homepage Redesign</div>
                <div id="dash-project-meta" class="text-sm text-gray-500">Led by Michael K. Ocansey</div>
              </div>
              <div class="flex flex-wrap items-center gap-3">
                <loomi-select
                  id="project-switcher"
                  size="small"
                  style="width: 14rem"
                  selected-value="redesign"
                ></loomi-select>
                <loomi-button id="dash-new-project" type="secondary" size="small" icon="folder-plus">New Project</loomi-button>
              </div>
            </div>

            <div class="grid grid-cols-1 gap-4 p-5 sm:grid-cols-4">
              <loomi-statistic id="stat-total" number="8" label="Total tasks" has-shadow="false"></loomi-statistic>
              <loomi-statistic id="stat-progress" number="1" label="In progress" has-shadow="false"></loomi-statistic>
              <loomi-statistic id="stat-complete" number="25%" label="Complete" has-shadow="false"></loomi-statistic>
              <loomi-statistic id="stat-due" number="6" label="Due soon" has-shadow="false"></loomi-statistic>
            </div>

            <div class="grid gap-5 px-5 pb-5 md:grid-cols-[1.2fr_0.8fr]">
              <div class="space-y-5">
                <div>
                  <div class="mb-2 text-sm font-medium text-gray-600 dark:text-gray-400">Tasks by status</div>
                  <loomi-horizontal-line-graph id="status-graph"></loomi-horizontal-line-graph>
                </div>
                <div>
                  <div class="mb-2 text-sm font-medium text-gray-600 dark:text-gray-400">Team workload</div>
                  <loomi-horizontal-line-graph id="workload-graph"></loomi-horizontal-line-graph>
                </div>
              </div>
              <div class="rounded-md border border-gray-200 bg-gray-50 p-4 dark:border-gray-800 dark:bg-gray-900">
                <div class="mb-3 flex items-center justify-between">
                  <div class="text-sm font-medium text-gray-600 dark:text-gray-400">Recent activity</div>
                  <loomi-tag id="dash-budget" label="$18k" color="green"></loomi-tag>
                </div>
                <loomi-listview id="activity-list" compact class="block"></loomi-listview>
              </div>
            </div>

            <div class="flex flex-wrap gap-3 border-t border-gray-200 p-5 dark:border-gray-800">
              <loomi-button id="dash-view-board" color="primary" size="small" icon="kanban-square">View Tasks</loomi-button>
              <loomi-button id="dash-new-task" type="secondary" size="small" icon="plus">Add Task</loomi-button>
              <loomi-button id="dash-new-project-bottom" type="secondary" size="small" icon="folder-plus">Add Project</loomi-button>
            </div>
          </div>

          <!-- Page: Board -->
          <div class="demo-page hidden" data-page="board">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-200 p-5 dark:border-gray-800">
              <loomi-button id="board-back" type="secondary" size="small" icon="arrow-left">Dashboard</loomi-button>
              <div>
                <div id="board-project-name" class="font-semibold">Homepage Redesign</div>
                <div id="board-project-lead" class="text-xs text-gray-500">Michael K. Ocansey</div>
              </div>
              <loomi-button id="board-new-task" color="primary" size="small" icon="plus">Add Task</loomi-button>
            </div>
            <div class="grid grid-cols-1 gap-4 p-5 md:grid-cols-3">
              <div>
                <div class="mb-2 flex items-center gap-2 text-sm font-medium text-gray-600 dark:text-gray-400">
                  To Do <span id="count-todo" class="rounded-full bg-gray-100 px-2 py-0.5 text-xs dark:bg-gray-800">0</span>
                </div>
                <loomi-sortable id="col-todo" type="shared" group="board"></loomi-sortable>
              </div>
              <div>
                <div class="mb-2 flex items-center gap-2 text-sm font-medium text-gray-600 dark:text-gray-400">
                  In Progress <span id="count-in-progress" class="rounded-full bg-gray-100 px-2 py-0.5 text-xs dark:bg-gray-800">0</span>
                </div>
                <loomi-sortable id="col-in-progress" type="shared" group="board"></loomi-sortable>
              </div>
              <div>
                <div class="mb-2 flex items-center gap-2 text-sm font-medium text-gray-600 dark:text-gray-400">
                  Done <span id="count-done" class="rounded-full bg-gray-100 px-2 py-0.5 text-xs dark:bg-gray-800">0</span>
                </div>
                <loomi-sortable id="col-done" type="shared" group="board"></loomi-sortable>
              </div>
            </div>
          </div>

          <!-- Page: Task detail -->
          <div class="demo-page hidden" data-page="task-detail">
            <div class="flex items-center justify-between border-b border-gray-200 p-5 dark:border-gray-800">
              <loomi-button id="detail-back" type="secondary" size="small" icon="arrow-left">Board</loomi-button>
              <loomi-tag id="detail-status" label="To Do" color="gray"></loomi-tag>
            </div>
            <div class="space-y-5 p-5">
              <div>
                <h4 id="detail-title" class="text-lg font-semibold"></h4>
                <p id="detail-description" class="mt-1 text-sm text-gray-600 dark:text-gray-400"></p>
                <div id="detail-due" class="mt-3 text-xs font-medium text-gray-500"></div>
              </div>
              <div class="grid gap-4 sm:grid-cols-2">
                <loomi-select
                  id="detail-assignee"
                  label="Assigned to"
                  size="small"
                  data='[{"label":"Michael K. Ocansey","value":"mk"},{"label":"Sara Field","value":"sf"},{"label":"Robert Boateng","value":"rb"}]'
                ></loomi-select>
                <loomi-select
                  id="detail-status-select"
                  label="Status"
                  size="small"
                  data='[{"label":"To Do","value":"todo"},{"label":"In Progress","value":"in-progress"},{"label":"Done","value":"done"}]'
                ></loomi-select>
              </div>
              <div>
                <div class="mb-2 text-sm font-medium text-gray-600 dark:text-gray-400">Comments</div>
                <loomi-listview id="detail-comments" compact class="block"></loomi-listview>
                <div class="mt-3 space-y-2">
                  <loomi-textarea id="detail-comment-input" placeholder="Write a comment…" rows="2"></loomi-textarea>
                  <loomi-button id="detail-comment-submit" size="small" color="primary" icon="send">Post comment</loomi-button>
                </div>
              </div>
            </div>
          </div>

          <!-- Page: New task -->
          <div class="demo-page hidden" data-page="new-task">
            <div class="flex items-center justify-between border-b border-gray-200 p-5 dark:border-gray-800">
              <loomi-button id="new-task-back" type="secondary" size="small" icon="arrow-left">Cancel</loomi-button>
              <div class="font-semibold">New Task</div>
              <span></span>
            </div>
            <form id="new-task-form" class="space-y-4 p-5" enctype="multipart/form-data">
              <loomi-input name="title" label="Title" required></loomi-input>
