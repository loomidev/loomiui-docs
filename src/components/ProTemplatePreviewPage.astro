---
import ProLandingShell from "./ProLandingShell.astro";
import { PRO_LICENSING_URL } from "../lib/pro-licensing.mjs";

interface Props {
  template: string;
}

const { template } = Astro.props;
const templateLabels: Record<string, string> = {
  admin: "Admin Pro",
  saas: "SaaS Starter",
  crm: "CRM",
  analytics: "Analytics Dashboard",
};
const templateLabel = templateLabels[template] ?? template;
const previewUrl = `/pro/live/${template}/`;
const fullscreenModalName = `${template}-template-fullscreen-preview`;
const title = `${templateLabel} Live Preview - LoomiUI Pro`;
const description = `Run through the actual Lit application for the ${templateLabel} template.`;
---

<ProLandingShell title={title} description={description} wide>
  <a href="/pro/templates/" class="back-link">
    <loomi-icon name="arrow-left"></loomi-icon>
    Back to templates
  </a>

  <section class="preview-heading">
    <div>
      <div class="preview-meta">
        <span>Live template preview</span>
        <span>HTML + Lit</span>
      </div>
      <h1>{templateLabel}</h1>
      <p>This is the actual template application. Use its navigation, forms, filters, and product workflows as you would in the delivered Lit project.</p>
    </div>
    <div class="preview-actions">
      <loomi-button type="secondary" id="open-fullscreen-preview">Open full screen</loomi-button>
      <loomi-button color="primary" tag="a" href={PRO_LICENSING_URL}>Get Pro</loomi-button>
    </div>
  </section>

  <section class="preview-frame" aria-label={`${templateLabel} Lit application preview`}>
    <div class="preview-browser-bar">
      <div class="browser-dots" aria-hidden="true"><span></span><span></span><span></span></div>
      <div class="browser-address">{previewUrl ?? "Preview unavailable"}</div>
      <span class="browser-stack">Lit application</span>
    </div>

    <div class="iframe-wrap">
        <div class="frame-loading" id="frame-loading">
          <loomi-icon name="arrow-path"></loomi-icon>
          <strong>Loading {templateLabel}</strong>
          <span>The real template app runs in this frame.</span>
        </div>
        <iframe
          id="template-preview-frame"
          src={previewUrl}
          title={`${templateLabel} HTML and Lit live preview`}
          loading="eager"
          allow="clipboard-write; fullscreen"
          sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-modals allow-downloads"
        ></iframe>
    </div>
  </section>

  <loomi-modal
    id="fullscreen-preview-modal"
    name={fullscreenModalName}
    size="omg"
    show-action-buttons="false"
    show-close-icon
    aria-label={`${templateLabel} full screen live preview`}
  >
    <div class="fullscreen-preview">
      <a href="/pro/templates/" class="fullscreen-templates-link">
        <loomi-icon name="arrow-left"></loomi-icon>
        View other templates
      </a>

      <div class="fullscreen-iframe-wrap">
        <div class="frame-loading" id="fullscreen-frame-loading">
          <loomi-icon name="arrow-path"></loomi-icon>
          <strong>Loading {templateLabel}</strong>
          <span>The real template app runs in this frame.</span>
        </div>
        <iframe
          id="fullscreen-template-preview-frame"
          data-src={previewUrl}
          title={`${templateLabel} HTML and Lit full screen live preview`}
          allow="clipboard-write; fullscreen"
          sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-modals allow-downloads"
        ></iframe>
      </div>
    </div>
  </loomi-modal>

  <p class="local-preview-note">
    Working locally? Run <code>pnpm previews:build</code> after changing a Lit template, then reload this page.
  </p>

  <section class="purchase-panel">
    <div>
      <p class="section-eyebrow">Build from this foundation</p>
      <h2>Get {templateLabel} and every Pro template</h2>
      <p>One Pro license includes every template family, all framework implementations, themes, private documentation, and updates.</p>
    </div>
    <loomi-button color="primary" tag="a" href={PRO_LICENSING_URL}>View Pro licenses</loomi-button>
  </section>

  <script is:inline>
    const frame = document.getElementById("template-preview-frame");
    const loading = document.getElementById("frame-loading");
    frame?.addEventListener("load", () => loading?.classList.add("is-hidden"));

    const fullscreenTrigger = document.getElementById("open-fullscreen-preview");
    const fullscreenModal = document.getElementById("fullscreen-preview-modal");
    const fullscreenFrame = document.getElementById("fullscreen-template-preview-frame");
    const fullscreenLoading = document.getElementById("fullscreen-frame-loading");

    fullscreenFrame?.addEventListener("load", () => fullscreenLoading?.classList.add("is-hidden"));
    fullscreenTrigger?.addEventListener("click", async () => {
      if (fullscreenFrame && !fullscreenFrame.getAttribute("src")) {
        fullscreenFrame.setAttribute("src", fullscreenFrame.dataset.src ?? "");
      }
      await customElements.whenDefined("loomi-modal");
      fullscreenModal?.show?.();
    });
  </script>
</ProLandingShell>

<style>
  .back-link { display: inline-flex; align-items: center; gap: .45rem; color: rgb(75 85 99); font-size: .875rem; font-weight: 650; text-decoration: none; }
  .back-link:hover { color: rgb(37 99 235); }
  .back-link loomi-icon { width: 1rem; height: 1rem; }
  .preview-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-top: 2rem; }
  .preview-meta { display: flex; flex-wrap: wrap; gap: .5rem; }
  .preview-meta span { border-radius: 999px; background: rgb(239 246 255); padding: .4rem .65rem; color: rgb(37 99 235); font-size: .72rem; font-weight: 750; letter-spacing: .06em; text-transform: uppercase; }
  .preview-heading h1 { margin: .75rem 0 0; font-size: clamp(2.5rem, 5vw, 4.5rem); line-height: 1; letter-spacing: -.045em; }
  .preview-heading p { margin: 1rem 0 0; max-width: 45rem; color: rgb(75 85 99); font-size: 1rem; line-height: 1.7; }
  .preview-actions { display: flex; flex-wrap: wrap; flex: none; gap: .65rem; }
  .preview-frame { margin-top: 2.5rem; overflow: hidden; border: 1px solid rgb(203 213 225); border-radius: 1.25rem; background: rgb(248 250 252); box-shadow: 0 24px 60px rgb(15 23 42 / .1); }
  .preview-browser-bar { display: grid; grid-template-columns: auto minmax(8rem, 30rem) auto; align-items: center; justify-content: space-between; gap: 1rem; border-bottom: 1px solid rgb(226 232 240); background: white; padding: .8rem 1rem; }
  .browser-dots { display: flex; gap: .35rem; }
  .browser-dots span { width: .6rem; height: .6rem; border-radius: 50%; background: rgb(248 113 113); }
  .browser-dots span:nth-child(2) { background: rgb(250 204 21); }
  .browser-dots span:nth-child(3) { background: rgb(74 222 128); }
  .browser-address { overflow: hidden; border-radius: .45rem; background: rgb(241 245 249); padding: .4rem .75rem; color: rgb(100 116 139); font-size: .75rem; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
  .browser-stack { color: rgb(100 116 139); font-size: .72rem; font-weight: 700; text-transform: uppercase; }
  .iframe-wrap { position: relative; min-height: 760px; background: white; }
  .iframe-wrap iframe { display: block; width: 100%; height: 760px; border: 0; background: white; }
  .frame-loading { position: absolute; inset: 0; z-index: 1; display: grid; align-content: center; justify-items: center; gap: .5rem; background: rgb(248 250 252); color: rgb(30 41 59); text-align: center; transition: opacity .2s, visibility .2s; }
  .frame-loading.is-hidden { visibility: hidden; opacity: 0; pointer-events: none; }
  .frame-loading loomi-icon { width: 1.75rem; height: 1.75rem; margin-bottom: .35rem; color: rgb(37 99 235); animation: spin 1s linear infinite; }
  .frame-loading span { color: rgb(100 116 139); font-size: .875rem; }
  .fullscreen-preview { display: grid; grid-template-rows: auto minmax(0, 1fr); gap: 1rem; height: calc(90vh - 3rem); min-height: 30rem; }
  .fullscreen-templates-link { display: inline-flex; align-items: center; justify-self: start; gap: .45rem; color: rgb(75 85 99); font-size: .875rem; font-weight: 650; text-decoration: none; }
  .fullscreen-templates-link:hover { color: rgb(37 99 235); }
  .fullscreen-templates-link loomi-icon { width: 1rem; height: 1rem; }
  .fullscreen-iframe-wrap { position: relative; min-height: 0; overflow: hidden; border: 1px solid rgb(203 213 225); border-radius: .8rem; background: white; }
  .fullscreen-iframe-wrap iframe { display: block; width: 100%; height: 100%; border: 0; background: white; }
  .local-preview-note { margin: 1rem 0 0; color: rgb(100 116 139); font-size: .8rem; }
  .local-preview-note code { border-radius: .3rem; background: rgb(241 245 249); padding: .15rem .35rem; color: rgb(51 65 85); }
  .section-eyebrow { margin: 0; color: rgb(37 99 235); font-size: .72rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  .purchase-panel { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin-top: 4rem; border-radius: 1.25rem; background: rgb(239 246 255); padding: 2rem; }
  .purchase-panel h2 { margin: .3rem 0 0; font-size: 1.6rem; line-height: 1.2; font-weight: 750; letter-spacing: -.025em; }
  .purchase-panel p:last-child { margin: .65rem 0 0; color: rgb(75 85 99); }
  @keyframes spin { to { transform: rotate(360deg); } }
  :global(.dark) .back-link, :global(.dark) .preview-heading p, :global(.dark) .purchase-panel p:last-child, :global(.dark) .local-preview-note, :global(.dark) .fullscreen-templates-link { color: rgb(156 163 175); }
  :global(.dark) .preview-meta span { background: rgb(30 58 138 / .45); color: rgb(147 197 253); }
  :global(.dark) .preview-frame, :global(.dark) .preview-browser-bar { border-color: rgb(55 65 81); background: rgb(17 24 39); }
  :global(.dark) .browser-address, :global(.dark) .local-preview-note code { background: rgb(30 41 59); color: rgb(203 213 225); }
  :global(.dark) .purchase-panel { background: rgb(30 58 138 / .3); }
  @media (max-width: 800px) {
    .preview-heading, .purchase-panel { align-items: flex-start; flex-direction: column; }
    .preview-browser-bar { grid-template-columns: auto 1fr; }
    .browser-stack { display: none; }
    .iframe-wrap, .iframe-wrap iframe { min-height: 680px; height: 680px; }
    .fullscreen-preview { height: calc(90vh - 2.5rem); min-height: 24rem; }
  }
</style>
