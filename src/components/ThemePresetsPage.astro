    import "@loomidev/chart";
    import "@loomidev/checkbox";
    import "@loomidev/datepicker";
    import "@loomidev/filepicker";
    import "@loomidev/input";
    import "@loomidev/otp";
    import "@loomidev/progress";
    import "@loomidev/radio";
    import "@loomidev/rating";
    import "@loomidev/select";
    import "@loomidev/tab";
    import "@loomidev/table";
    import "@loomidev/tag";
    import "@loomidev/textarea";
    import "@loomidev/toggle";
  </script>
  <script type="application/json" id="theme-preset-data" is:inline set:html={JSON.stringify(themeBundle)}></script>
  <script>
    const themeData = JSON.parse(document.getElementById("theme-preset-data")!.textContent || "{}");
    const manifest = themeData.manifest?.presets ?? [];
    const tokens = themeData.tokens ?? {};
    const presetButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-preset]"));
    const presetGrid = document.getElementById("preset-grid") as HTMLElement;
    const presetPrev = document.getElementById("preset-prev") as HTMLButtonElement;
    const presetNext = document.getElementById("preset-next") as HTMLButtonElement;
    const modeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-mode]"));
    const viewportButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".viewport-button[data-viewport]"));
    const pmButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-pm]"));
    const workbench = document.getElementById("preset-workbench") as HTMLElement;
    const inspector = document.querySelector<HTMLElement>(".theme-inspector")!;
    const previewFrame = document.getElementById("preview-frame") as HTMLElement;
    const presetName = document.getElementById("selected-preset-name") as HTMLElement;
    const presetDescription = document.getElementById("selected-preset-description") as HTMLElement;
    const installCode = document.getElementById("install-code") as HTMLElement;
    const importCode = document.getElementById("import-code") as HTMLElement;
    const copyFeedback = document.getElementById("copy-feedback") as HTMLElement;
    const themeBuilderLink = document.getElementById("open-theme-builder") as HTMLElement;
    const tokenRows = Array.from(document.querySelectorAll<HTMLElement>(".token-row"));
    let activePreset = manifest[0]?.name;
    let activeMode = "light";
    let activePm = "npm";

    function getPreset(name: string) {
      return manifest.find((preset: any) => preset.name === name);
    }

    function toKebabCase(value: string) {
      return value.replace(/([a-z0-9])([A-Z])/g, "$1-$2").toLowerCase();
    }

    function setTokenGroup(prefix: string, group: Record<string, unknown> = {}) {
      Object.entries(group).forEach(([name, value]) => {
        workbench.style.setProperty(`${prefix}-${toKebabCase(name)}`, String(value));
      });
    }

    function updateInspector(mode: any, preset: any, values: Record<string, string>) {
      const primary = mode?.color?.primary ?? {};
      const primaryValue = primary[500] ?? preset.primary500;
      const inspectorValues: Record<string, string> = {
        "primary": primaryValue,
        "primary-hover": primary[activeMode === "dark" ? 400 : 600] ?? primaryValue,
        "surface": values["--preview-surface"],
        "surface-alt": values["--preview-surface-muted"],
        "success": mode?.color?.success?.[500] ?? "#22c55e",
        "border": values["--preview-border"],
        "warning": mode?.color?.warning?.[500] ?? "#f59e0b",
        "text-primary": values["--preview-text"],
        "danger": mode?.color?.error?.[500] ?? "#ef4444",
        "text-muted": values["--preview-text-muted"],
      };
      tokenRows.forEach((row) => {
        const value = inspectorValues[row.dataset.token ?? ""];
        if (!value) return;
        (row.querySelector(".token-swatch") as HTMLElement).style.background = value;
        row.querySelector(".token-value")!.textContent = value.startsWith("#") ? value.toUpperCase() : value;
      });

      const font = (mode?.typography?.fontFamily ?? "Inter").split(",")[0].trim().replace(/["']/g, "");
      document.getElementById("radius-token-value")!.textContent = mode?.component?.panelRadius ?? "12px";
      document.getElementById("spacing-token-value")!.textContent = mode?.spacing?.xs ?? "8px";
      document.getElementById("type-token-value")!.textContent = font;
    }

    function setCanvasTokens(mode: any, preset: any) {
      const primary = mode?.color?.primary ?? {};
      const surface = mode?.color?.surface ?? {};
      const text = mode?.color?.text ?? {};
      const values: Record<string, string> = {
        "--preview-primary": primary[500] ?? preset.primary500,
        "--preview-primary-soft": primary[activeMode === "dark" ? 950 : 50] ?? surface.muted,
        "--preview-primary-strong": primary[activeMode === "dark" ? 300 : 700] ?? preset.primary500,
        "--preview-surface": surface.base ?? (activeMode === "dark" ? "#0f172a" : "#ffffff"),
        "--preview-surface-muted": surface.muted ?? (activeMode === "dark" ? "#020617" : "#f8fafc"),
        "--preview-surface-raised": surface.raised ?? surface.base,
        "--preview-border": surface.border ?? (activeMode === "dark" ? "#334155" : "#e2e8f0"),
        "--preview-text": text.base ?? (activeMode === "dark" ? "#f8fafc" : "#0f172a"),
        "--preview-text-muted": text.muted ?? (activeMode === "dark" ? "#94a3b8" : "#64748b"),
        "--preview-radius": mode?.component?.panelRadius ?? "12px",
        "--preview-shadow": mode?.component?.cardShadow ?? "0 1px 3px rgba(15,23,42,.1)",
      };
      Object.entries(values).forEach(([property, value]) => {
        workbench.style.setProperty(property, String(value));
        inspector.style.setProperty(property, String(value));
      });
      workbench.dataset.loomiMode = activeMode;

      setTokenGroup("--loomi-primary", primary);
      setTokenGroup("--loomi-gray", mode?.color?.neutral);
      setTokenGroup("--loomi-success", mode?.color?.success);
      setTokenGroup("--loomi-warning", mode?.color?.warning);
      setTokenGroup("--loomi-error", mode?.color?.error);
      workbench.style.setProperty("--loomi-surface", surface.base ?? values["--preview-surface"]);
      workbench.style.setProperty("--loomi-surface-muted", surface.muted ?? values["--preview-surface-muted"]);
      workbench.style.setProperty("--loomi-surface-hover", surface.hover ?? values["--preview-surface-muted"]);
      workbench.style.setProperty("--loomi-surface-raised", surface.raised ?? values["--preview-surface-raised"]);
      workbench.style.setProperty("--loomi-surface-border", surface.border ?? values["--preview-border"]);
      workbench.style.setProperty("--loomi-surface-border-subtle", surface.borderSubtle ?? values["--preview-border"]);
      workbench.style.setProperty("--loomi-text", text.base ?? values["--preview-text"]);
      workbench.style.setProperty("--loomi-text-secondary", text.secondary ?? values["--preview-text"]);
      workbench.style.setProperty("--loomi-text-muted", text.muted ?? values["--preview-text-muted"]);
      workbench.style.setProperty("--loomi-text-faint", text.faint ?? values["--preview-text-muted"]);
      workbench.style.setProperty("--loomi-text-on-primary", text.onPrimary ?? "#ffffff");
      workbench.style.setProperty("--loomi-focus-ring", mode?.color?.focusRing ?? primary[500] ?? preset.primary500);
      setTokenGroup("--loomi-font", mode?.typography);
      setTokenGroup("--loomi-space", mode?.spacing);
      setTokenGroup("--loomi-radius", mode?.radius);
      setTokenGroup("--loomi-shadow", mode?.shadow);
      setTokenGroup("--loomi-border", mode?.border);
      setTokenGroup("--loomi-motion", mode?.motion);
      setTokenGroup("--loomi-density", mode?.density);
      setTokenGroup("--loomi-component", mode?.component);

      updateInspector(mode, preset, values);

      workbench.querySelectorAll<any>("loomi-chart").forEach((chart) => chart.requestUpdate?.());
    }

    function renderInstall() {
      const preset = getPreset(activePreset);
      if (!preset) return;
      const commands: Record<string, string> = { npm: "npm i", yarn: "yarn add", pnpm: "pnpm add" };
      installCode.textContent = `${commands[activePm] ?? commands.npm} @loomdev-pro/themes`;
      importCode.textContent = `@import "@loomdev-pro/themes/css/${preset.name}.css";`;
      pmButtons.forEach((button) => {
        const active = button.dataset.pm === activePm;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });
    }

    function render() {
      const preset = getPreset(activePreset);
      if (!preset) return;
      const mode = tokens[activePreset]?.modes?.[activeMode];

      presetButtons.forEach((button) => {
        const active = button.dataset.preset === activePreset;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });
      modeButtons.forEach((button) => {
        const active = button.dataset.mode === activeMode;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });

      presetName.textContent = preset.label;
      presetDescription.textContent = preset.description;
      renderInstall();
      setCanvasTokens(mode, preset);

      const url = new URL(window.location.href);
      url.searchParams.set("preset", activePreset);
      if (activeMode === "dark") url.searchParams.set("mode", "dark");
      else url.searchParams.delete("mode");
      history.replaceState(null, "", url);

      const builderUrl = new URL("/pro/themes/theme-builder/", window.location.origin);
      builderUrl.searchParams.set("preset", activePreset);
      if (activeMode === "dark") builderUrl.searchParams.set("mode", "dark");
      themeBuilderLink.setAttribute("href", `${builderUrl.pathname}${builderUrl.search}`);
    }

    function wireCopy(buttonId: string, code: HTMLElement) {
      document.getElementById(buttonId)?.addEventListener("click", () => {
        copyFeedback.textContent = "Copied";
        window.setTimeout(() => { copyFeedback.textContent = ""; }, 1600);
        void navigator.clipboard.writeText(code.textContent ?? "").catch(() => {
          copyFeedback.textContent = "Copy unavailable";
        });
      });
    }

    function updateCarouselControls() {
      const maxScroll = presetGrid.scrollWidth - presetGrid.clientWidth;
      presetPrev.disabled = presetGrid.scrollLeft <= 2;
      presetNext.disabled = presetGrid.scrollLeft >= maxScroll - 2;
    }

    function scrollPresetCarousel(direction: number) {
      const card = presetGrid.querySelector<HTMLElement>(".preset-card");
      const gap = Number.parseFloat(getComputedStyle(presetGrid).gap) || 0;
      presetGrid.scrollBy({ left: direction * ((card?.offsetWidth ?? presetGrid.clientWidth) + gap), behavior: "smooth" });
    }

    presetPrev.addEventListener("click", () => scrollPresetCarousel(-1));
    presetNext.addEventListener("click", () => scrollPresetCarousel(1));
    presetGrid.addEventListener("scroll", updateCarouselControls, { passive: true });
    window.addEventListener("resize", updateCarouselControls);

    presetButtons.forEach((button) => button.addEventListener("click", () => {
      activePreset = button.dataset.preset!;
      render();
      document.querySelector(".workbench")?.scrollIntoView({ behavior: "smooth", block: "start" });
    }));
    modeButtons.forEach((button) => button.addEventListener("click", () => {
      activeMode = button.dataset.mode ?? "light";
      render();
    }));
    viewportButtons.forEach((button) => button.addEventListener("click", () => {
      previewFrame.dataset.viewport = button.dataset.viewport ?? "desktop";
      viewportButtons.forEach((other) => {
        const active = other === button;
        other.classList.toggle("is-active", active);
        other.setAttribute("aria-pressed", String(active));
      });
    }));
    pmButtons.forEach((button) => button.addEventListener("click", () => {
      activePm = button.dataset.pm ?? "npm";
      renderInstall();
    }));
    // Charts render at zero width while their tab panel is hidden, so re-measure
    // the ones in the newly revealed panel after the switch.
    document.getElementById("demo-tabs")?.addEventListener("loomi-tab-change", () => {
      window.requestAnimationFrame(() => {
        workbench.querySelectorAll<any>("loomi-chart").forEach((chart) => chart.requestUpdate?.());
      });
    });
    document.getElementById("view-retention")?.addEventListener("click", () => {
      document.getElementById("retention-card")?.scrollIntoView({ behavior: "smooth", block: "center" });
    });
    const selectionTable = document.getElementById("selection-demo-table");
    const selectionCount = document.getElementById("selection-count");
    selectionTable?.addEventListener("loomi-selection-change", (event: any) => {
      const count = event.detail?.ids?.length ?? 0;
      selectionCount!.textContent = `${count} row${count === 1 ? "" : "s"} selected`;
    });
    // The table has no public clear API (`selected-value` is initial state only), so
    // clear by toggling each checked row checkbox through its own click handler —
    // this also fires loomi-selection-change, which keeps the count label in sync.
    document.getElementById("clear-selection")?.addEventListener("click", () => {
      selectionTable?.shadowRoot
        ?.querySelectorAll<HTMLElement>("tbody loomi-checkbox[checked]")
        .forEach((box) => ((box.shadowRoot?.querySelector("input") as HTMLElement | null) ?? box).click());
    });
    // The "Error" input-state demo: run the component's own required-field check so
    // it renders its invalid style without user interaction.
    void customElements.whenDefined("loomi-input").then(async () => {
      const errorInput = document.getElementById("error-state-input") as any;
      await errorInput?.updateComplete;
      errorInput?.validate?.();
    });
    document.querySelectorAll<HTMLButtonElement>("[data-dismiss-alert]").forEach((button) => {
      button.addEventListener("click", () => {
        const alert = button.closest<HTMLElement>(".demo-alert");
        if (alert) alert.hidden = true;
      });
    });
    wireCopy("copy-install", installCode);
    wireCopy("copy-import", importCode);

    const params = new URL(window.location.href).searchParams;
    const requestedPreset = params.get("preset");
    if (requestedPreset && getPreset(requestedPreset)) activePreset = requestedPreset;
    if (params.get("mode") === "dark") activeMode = "dark";
    render();
    window.requestAnimationFrame(() => {
      const activeCard = presetGrid.querySelector<HTMLElement>(`.preset-card[data-preset="${activePreset}"]`);
      if (activeCard) presetGrid.scrollLeft = Math.max(0, activeCard.offsetLeft - presetGrid.offsetLeft);
      updateCarouselControls();
    });
  </script>
