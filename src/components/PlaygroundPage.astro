---
import MarketingHeader from "./MarketingHeader.astro";
import { buildImportMap } from "../lib/import-map.mjs";
import "../styles/home.css";

const importMap = buildImportMap();
const title = "Playground - LoomiUI";
const description = "Select LoomiUI components and adjust common props in a live playground.";

const playgroundComponents = [
  {
    key: "button",
    title: "Button",
    tag: "loomi-button",
    packageName: "button",
    description: "Action button with color, size, outline, radius, and icon props.",
    defaults: {
      content: "Save changes",
      type: "primary",
      color: "",
      size: "regular",
      radius: "medium",
      outline: false,
      uppercase: false,
      icon: "",
    },
    controls: [
      { type: "text", key: "content", label: "Label" },
      { type: "select", key: "type", label: "Type", options: ["primary", "secondary"] },
      { type: "select", key: "color", label: "Color", options: ["", "primary", "secondary", "success", "warning", "error"] },
      { type: "select", key: "size", label: "Size", options: ["tiny", "small", "regular", "medium", "big"] },
      { type: "select", key: "radius", label: "Radius", options: ["none", "small", "medium", "full"] },
      { type: "select", key: "icon", label: "Icon", options: ["", "check", "plus", "trash", "arrow-right", "bell-alert"] },
      { type: "boolean-attr", key: "outline", label: "Outline" },
      { type: "boolean-attr", key: "uppercase", label: "Uppercase" },
    ],
  },
  {
    key: "input",
    title: "Input",
    tag: "loomi-input",
    packageName: "input",
    description: "Text input with label, placeholder, affixes, clear button, and state props.",
    defaults: {
      label: "Email",
      placeholder: "name@company.com",
      value: "",
      type: "email",
      size: "regular",
      prefix: "",
      suffix: "",
      clearable: true,
      disabled: false,
    },
    controls: [
      { type: "text", key: "label", label: "Label" },
      { type: "text", key: "placeholder", label: "Placeholder" },
      { type: "text", key: "value", label: "Value" },
      { type: "select", key: "type", label: "Type", options: ["text", "email", "search", "tel", "url"] },
      { type: "select", key: "size", label: "Size", options: ["small", "regular", "medium", "big"] },
      { type: "text", key: "prefix", label: "Prefix" },
      { type: "text", key: "suffix", label: "Suffix" },
      { type: "boolean-attr", key: "clearable", label: "Clearable" },
      { type: "boolean-attr", key: "disabled", label: "Disabled" },
    ],
  },
  {
    key: "textarea",
    title: "Textarea",
    tag: "loomi-textarea",
    packageName: "textarea",
    description: "Multi-line input with label, placeholder, rows, and disabled state.",
    defaults: {
      label: "Message",
      placeholder: "Write a short update...",
      value: "",
      rows: 4,
      disabled: false,
    },
    controls: [
      { type: "text", key: "label", label: "Label" },
      { type: "text", key: "placeholder", label: "Placeholder" },
      { type: "text", key: "value", label: "Value" },
      { type: "number", key: "rows", label: "Rows", min: 2, max: 8, step: 1 },
      { type: "boolean-attr", key: "disabled", label: "Disabled" },
    ],
  },
  {
    key: "alert",
    title: "Alert",
    tag: "loomi-alert",
    packageName: "alert",
    description: "Inline alert with type, shade, icon visibility, and close controls.",
    defaults: {
      content: "Your workspace was updated successfully.",
      type: "success",
      shade: "faint",
      color: "",
      icon: "",
      "show-icon": true,
      "show-close-icon": true,
    },
    controls: [
      { type: "text", key: "content", label: "Message" },
      { type: "select", key: "type", label: "Type", options: ["info", "success", "warning", "error"] },
      { type: "select", key: "shade", label: "Shade", options: ["faint", "dark"] },
      { type: "select", key: "color", label: "Color", options: ["", "primary", "success", "warning", "error", "transparent"] },
      { type: "select", key: "icon", label: "Icon", options: ["", "information-circle", "check-circle", "bell-alert", "key"] },
      { type: "boolean-string", key: "show-icon", label: "Show icon" },
      { type: "boolean-string", key: "show-close-icon", label: "Show close" },
    ],
  },
  {
    key: "checkbox",
    title: "Checkbox",
    tag: "loomi-checkbox",
    packageName: "checkbox",
    description: "Checkbox with checked and disabled states.",
    defaults: { content: "Send weekly summary", checked: true, disabled: false },
    controls: [
      { type: "text", key: "content", label: "Label" },
      { type: "boolean-attr", key: "checked", label: "Checked" },
      { type: "boolean-attr", key: "disabled", label: "Disabled" },
    ],
  },
  {
    key: "toggle",
    title: "Toggle",
    tag: "loomi-toggle",
    packageName: "toggle",
    description: "Switch control with checked and disabled states.",
    defaults: { checked: true, disabled: false },
    controls: [
      { type: "boolean-attr", key: "checked", label: "Checked" },
      { type: "boolean-attr", key: "disabled", label: "Disabled" },
    ],
  },
  {
    key: "slider",
    title: "Slider",
    tag: "loomi-slider",
    packageName: "slider",
    description: "Range slider with min, max, step, and selected value props.",
    defaults: { selected: 60, min: 0, max: 100, step: 5, label: "Completion" },
    controls: [
      { type: "text", key: "label", label: "Label" },
      { type: "range", key: "selected", label: "Selected", min: 0, max: 100, step: 5 },
      { type: "number", key: "min", label: "Min", min: 0, max: 100, step: 1 },
      { type: "number", key: "max", label: "Max", min: 1, max: 200, step: 1 },
      { type: "number", key: "step", label: "Step", min: 1, max: 25, step: 1 },
    ],
  },
  {
    key: "progress",
    title: "Progress",
    tag: "loomi-progress-bar",
    packageName: "progress",
    description: "Progress bar with percentage and color props.",
    defaults: { percentage: 68, color: "primary" },
    controls: [
      { type: "range", key: "percentage", label: "Percentage", min: 0, max: 100, step: 1 },
      { type: "select", key: "color", label: "Color", options: ["primary", "success", "warning", "error"] },
    ],
  },
  {
    key: "tag",
    title: "Tag",
    tag: "loomi-tag",
    packageName: "tag",
    description: "Compact label with text, color, and size props.",
    defaults: { label: "In review", color: "primary", size: "regular" },
    controls: [
      { type: "text", key: "label", label: "Label" },
      { type: "select", key: "color", label: "Color", options: ["primary", "success", "warning", "error", "secondary"] },
      { type: "select", key: "size", label: "Size", options: ["small", "regular", "medium"] },
    ],
  },
  {
    key: "avatar",
    title: "Avatar",
    tag: "loomi-avatar",
    packageName: "avatar",
    description: "Avatar with initials, image, color, dotted, and size props.",
    defaults: { label: "AM", image: "", size: "regular", "bg-color": "primary", dotted: false },
    controls: [
      { type: "text", key: "label", label: "Label" },
      { type: "text", key: "image", label: "Image URL" },
      { type: "select", key: "size", label: "Size", options: ["tiny", "small", "regular", "medium", "big"] },
      { type: "select", key: "bg-color", label: "Color", options: ["primary", "success", "warning", "error", "secondary"] },
      { type: "boolean-attr", key: "dotted", label: "Dotted" },
    ],
  },
  {
    key: "rating",
    title: "Rating",
    tag: "loomi-rating",
    packageName: "rating",
    description: "Star rating with rating, color, and clickable props.",
    defaults: { rating: 4, color: "orange", clickable: false, name: "playground-rating" },
    controls: [
      { type: "range", key: "rating", label: "Rating", min: 0, max: 5, step: 1 },
      { type: "select", key: "color", label: "Color", options: ["orange", "primary", "success", "warning", "error"] },
      { type: "boolean-string", key: "clickable", label: "Clickable" },
    ],
  },
  {
    key: "icon",
    title: "Icon",
    tag: "loomi-icon",
    packageName: "icon",
    description: "Icon renderer with name and size props.",
    defaults: { name: "sparkles", size: 48 },
    controls: [
      { type: "select", key: "name", label: "Name", options: ["sparkles", "bell-alert", "check-circle", "trash", "magnifying-glass", "squares-plus"] },
      { type: "range", key: "size", label: "Size", min: 16, max: 96, step: 4 },
    ],
  },
  {
    key: "theme-switcher",
    title: "Theme Switcher",
    tag: "loomi-theme-switcher",
    packageName: "theme-switcher",
    description: "Theme control with variant and label visibility props.",
    defaults: { variant: "dropmenu", "show-labels": false },
    controls: [
      { type: "select", key: "variant", label: "Variant", options: ["dropmenu", "switch", "buttons"] },
      { type: "boolean-attr", key: "show-labels", label: "Show labels" },
    ],
  },
  {
    key: "select",
    title: "Select",
    tag: "loomi-select",
    packageName: "select",
    description: "Custom select with data-driven options, search, sizes, and states.",
    defaults: {
      label: "Country",
      placeholder: "",
      data: '[{"label":"Ghana","value":"gh"},{"label":"Nigeria","value":"ng"},{"label":"Kenya","value":"ke"}]',
      "selected-value": "gh",
      size: "medium",
      searchable: false,
      disabled: false,
      readonly: false,
    },
    controls: [
      { type: "text", key: "label", label: "Label" },
      { type: "text", key: "placeholder", label: "Placeholder" },
      { type: "text", key: "data", label: "Data (JSON)" },
      { type: "select", key: "size", label: "Size", options: ["small", "regular", "medium", "big"] },
      { type: "boolean-attr", key: "searchable", label: "Searchable" },
      { type: "boolean-attr", key: "disabled", label: "Disabled" },
      { type: "boolean-attr", key: "readonly", label: "Readonly" },
    ],
  },
  {
    key: "datepicker",
    title: "Datepicker",
    tag: "loomi-datepicker",
    packageName: "datepicker",
    description: "Date picker with popup or inline styles, formats, and range mode.",
    defaults: {
      label: "Start date",
      "dp-style": "popup",
      format: "yyyy-mm-dd",
      "week-starts": "sunday",
      range: false,
      size: "regular",
      required: false,
    },
    controls: [
      { type: "text", key: "label", label: "Label" },
      { type: "select", key: "dp-style", label: "Style", options: ["popup", "inline"] },
      { type: "select", key: "format", label: "Format", options: ["yyyy-mm-dd", "dd-mm-yyyy", "mm-dd-yyyy", "yyyy/mm/dd", "dd/mm/yyyy", "mm/dd/yyyy", "D d M, Y"] },
      { type: "select", key: "week-starts", label: "Week starts", options: ["sunday", "monday"] },
      { type: "select", key: "size", label: "Size", options: ["tiny", "small", "regular", "medium", "big"] },
      { type: "boolean-attr", key: "range", label: "Range" },
      { type: "boolean-attr", key: "required", label: "Required" },
    ],
  },
  {
    key: "password",
    title: "Password",
    tag: "loomi-password",
    packageName: "password",
    description: "Password field with label, placeholder, sizes, and states.",
    defaults: {
      label: "Password",
      placeholder: "Enter a password",
      value: "",
      size: "medium",
      required: false,
      disabled: false,
    },
    controls: [
      { type: "text", key: "label", label: "Label" },
      { type: "text", key: "placeholder", label: "Placeholder" },
      { type: "text", key: "value", label: "Value" },
      { type: "select", key: "size", label: "Size", options: ["tiny", "small", "regular", "medium", "big"] },
      { type: "boolean-attr", key: "required", label: "Required" },
      { type: "boolean-attr", key: "disabled", label: "Disabled" },
    ],
  },
  {
    key: "number",
    title: "Number",
    tag: "loomi-number",
    packageName: "number",
    description: "Numeric stepper input with min, max, step, and size props.",
    defaults: { label: "Quantity", value: 5, min: 0, max: 100, step: 1, size: "medium", disabled: false },
    controls: [
      { type: "text", key: "label", label: "Label" },
      { type: "number", key: "value", label: "Value", min: 0, max: 100, step: 1 },
      { type: "number", key: "min", label: "Min", min: 0, max: 100, step: 1 },
      { type: "number", key: "max", label: "Max", min: 1, max: 1000, step: 1 },
      { type: "number", key: "step", label: "Step", min: 1, max: 25, step: 1 },
      { type: "select", key: "size", label: "Size", options: ["small", "regular", "medium", "big"] },
      { type: "boolean-attr", key: "disabled", label: "Disabled" },
    ],
  },
  {
    key: "pin",
    title: "Pin",
    tag: "loomi-pin",
    packageName: "pin",
    description: "Verification code input with digit count, masking, and separator.",
    defaults: { "total-digits": 4, size: "small", separator: false, "hide-digits": false },
    controls: [
      { type: "number", key: "total-digits", label: "Digits", min: 3, max: 8, step: 1 },
      { type: "select", key: "size", label: "Size", options: ["small", "big"] },
      { type: "boolean-attr", key: "separator", label: "Separator" },
      { type: "boolean-attr", key: "hide-digits", label: "Hide digits" },
    ],
  },
  {
    key: "radio",
    title: "Radio",
    tag: "loomi-radio",
    packageName: "radio",
    description: "Radio button with label, checked state, and color props.",
    defaults: { label: "Email me a copy", name: "playground-radio", value: "yes", checked: true, color: "primary", disabled: false },
    controls: [
      { type: "text", key: "label", label: "Label" },
      { type: "select", key: "color", label: "Color", options: ["primary", "success", "warning", "error", "secondary"] },
      { type: "boolean-attr", key: "checked", label: "Checked" },
      { type: "boolean-attr", key: "disabled", label: "Disabled" },
    ],
  },
  {
    key: "tag-input",
    title: "Tag Input",
    tag: "loomi-tag-input",
    packageName: "tag-input",
    description: "Tag entry field with modes, chip colors, shades, and sizes.",
    defaults: {
      label: "Skills",
      placeholder: "Type and press Enter",
      value: "design,engineering",
      mode: "inside",
      size: "medium",
      color: "primary",
      shade: "light",
      disabled: false,
    },
    controls: [
      { type: "text", key: "label", label: "Label" },
      { type: "text", key: "placeholder", label: "Placeholder" },
      { type: "text", key: "value", label: "Tags (comma separated)" },
      { type: "select", key: "mode", label: "Mode", options: ["inside", "below"] },
      { type: "select", key: "size", label: "Size", options: ["tiny", "small", "regular", "medium", "big"] },
      { type: "select", key: "color", label: "Color", options: ["primary", "success", "warning", "error", "secondary"] },
      { type: "select", key: "shade", label: "Shade", options: ["light", "faint", "dark"] },
      { type: "boolean-attr", key: "disabled", label: "Disabled" },
    ],
  },
  {
    key: "spinner",
    title: "Spinner",
    tag: "loomi-spinner",
    packageName: "spinner",
    description: "Loading indicator with type, size, color, and label props.",
    defaults: { type: "spinner", size: "medium", color: "primary", label: "Loading..." },
    controls: [
      { type: "select", key: "type", label: "Type", options: ["simple", "spinner", "dot"] },
      { type: "select", key: "size", label: "Size", options: ["small", "medium", "big", "xl", "omg"] },
      { type: "select", key: "color", label: "Color", options: ["gray", "primary", "success", "warning", "error"] },
      { type: "text", key: "label", label: "Label" },
    ],
  },
  {
    key: "divider",
    title: "Divider",
    tag: "loomi-divider",
    packageName: "divider",
    description: "Content divider with label, alignment, variant, and color props.",
    defaults: { label: "OR", orientation: "horizontal", align: "center", variant: "solid", color: "gray", thickness: "1px" },
    controls: [
      { type: "text", key: "label", label: "Label" },
      { type: "select", key: "orientation", label: "Orientation", options: ["horizontal", "vertical"] },
      { type: "select", key: "align", label: "Align", options: ["start", "center", "end"] },
      { type: "select", key: "variant", label: "Variant", options: ["solid", "dashed", "dotted"] },
      { type: "select", key: "color", label: "Color", options: ["gray", "primary", "success", "warning", "error"] },
      { type: "text", key: "thickness", label: "Thickness" },
    ],
  },
  {
    key: "empty-state",
    title: "Empty State",
    tag: "loomi-empty-state",
    packageName: "empty-state",
    description: "Empty state with heading, message, action button, and image size.",
    defaults: {
      heading: "No projects yet",
      message: "Create your first project to get started.",
      "button-label": "New project",
      "image-size": "medium",
    },
    controls: [
      { type: "text", key: "heading", label: "Heading" },
      { type: "text", key: "message", label: "Message" },
      { type: "text", key: "button-label", label: "Button label" },
      { type: "select", key: "image-size", label: "Image size", options: ["small", "medium", "large", "xl"] },
    ],
  },
  {
    key: "statistic",
    title: "Statistic",
    tag: "loomi-statistic",
    packageName: "statistic",
    description: "Stat card with label, value, currency, and layout props.",
    defaults: {
      label: "Monthly revenue",
      number: "48,250",
      currency: "$",
      "currency-position": "left",
      "label-position": "top",
      radius: "small",
      "show-spinner": false,
    },
    controls: [
      { type: "text", key: "label", label: "Label" },
      { type: "text", key: "number", label: "Number" },
      { type: "text", key: "currency", label: "Currency" },
      { type: "select", key: "currency-position", label: "Currency position", options: ["left", "right"] },
      { type: "select", key: "label-position", label: "Label position", options: ["top", "bottom"] },
      { type: "select", key: "radius", label: "Radius", options: ["none", "small", "medium", "large", "xl"] },
      { type: "boolean-attr", key: "show-spinner", label: "Show spinner" },
    ],
  },
  {
    key: "pagination",
    title: "Pagination",
    tag: "loomi-pagination",
    packageName: "pagination",
    description: "Pagination with total, page size, style, and color props.",
    defaults: { total: 120, "page-size": 10, page: 1, "pagination-style": "numbers", color: "primary", "show-total": true },
    controls: [
      { type: "number", key: "total", label: "Total items", min: 0, max: 1000, step: 10 },
      { type: "number", key: "page-size", label: "Page size", min: 1, max: 100, step: 1 },
      { type: "number", key: "page", label: "Page", min: 1, max: 100, step: 1 },
      { type: "select", key: "pagination-style", label: "Style", options: ["arrows", "numbers", "dropdown"] },
      { type: "select", key: "color", label: "Color", options: ["primary", "success", "warning", "error", "secondary"] },
      { type: "boolean-string", key: "show-total", label: "Show total" },
    ],
  },
  {
    key: "tooltip",
    title: "Tooltip",
    tag: "loomi-tooltip",
    packageName: "tooltip",
    description: "Tooltip with content, position, and shade props around a trigger.",
    defaults: { content: "Tooltips add helpful context.", position: "top", shade: "dark" },
    // Static anchor the tooltip wraps in the preview; `content` stays an attribute
    // here (the slot occupies the element body), unlike text-content components.
    slot: '<loomi-button size="small">Hover me</loomi-button>',
    controls: [
      { type: "text", key: "content", label: "Content" },
      { type: "select", key: "position", label: "Position", options: ["top", "bottom", "left", "right"] },
      { type: "select", key: "shade", label: "Shade", options: ["dark", "light"] },
    ],
  },
];

playgroundComponents.sort((a, b) => a.title.localeCompare(b.title));

const componentOptions = playgroundComponents.map((component) => ({ label: component.title, value: component.key }));
const packagesToImport = [...new Set(playgroundComponents.map((component) => component.packageName))];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" />
    <script type="importmap" is:inline set:html={JSON.stringify(importMap)} />
  </head>
  <body class="bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100">
    <MarketingHeader />

    <main class="mx-auto max-w-7xl px-6 py-10">
      <div class="feature-kicker">Playground</div>
      <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-end">
        <div>
          <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Playground</h1>
          <p class="mt-3 max-w-2xl text-lg leading-7 text-gray-600 dark:text-gray-400">
            Select a component, tune its props, and inspect the markup as it changes.
          </p>
        </div>
        <label class="playground-select-label">
          <span>Component</span>
          <loomi-select
            id="component-select"
            searchable
            placeholder="Select a component"
            selected-value={playgroundComponents[0].key}
            data={JSON.stringify(componentOptions)}
          ></loomi-select>
        </label>
      </div>

      <section class="playground-shell mt-8">
        <div class="playground-preview-panel">
          <div class="playground-panel-top">
            <div>
              <h2 id="component-title">{playgroundComponents[0].title}</h2>
              <p id="component-description">{playgroundComponents[0].description}</p>
            </div>
            <a id="docs-link" href={`/components/${playgroundComponents[0].key}/`} class="playground-docs-link">
              Docs
              <loomi-icon name="arrow-right" style="width:0.9rem;height:0.9rem"></loomi-icon>
            </a>
          </div>

          <div class="playground-preview-stage">
            <div id="preview-host" class="playground-preview"></div>
          </div>

          <div class="playground-code-block">
            <div class="playground-code-header">
              <span>HTML</span>
              <button type="button" id="copy-code" class="playground-icon-button" aria-label="Copy HTML">
                <loomi-icon name="clipboard-document" style="width:1rem;height:1rem"></loomi-icon>
              </button>
            </div>
            <pre><code id="markup-code"></code></pre>
          </div>
        </div>

        <aside class="playground-controls-panel" aria-label="Component props">
          <div class="playground-controls-heading">
            <h2>Props</h2>
            <button type="button" id="reset-props" class="playground-reset">
              <loomi-icon name="arrow-path" style="width:0.95rem;height:0.95rem"></loomi-icon>
              Reset
            </button>
          </div>
          <div id="controls" class="playground-controls"></div>
        </aside>
      </section>
    </main>

    <footer class="border-t border-gray-200 dark:border-gray-800">
      <div class="mx-auto max-w-6xl px-6 py-10 text-sm text-gray-500 dark:text-gray-400">
        <div class="flex flex-wrap justify-center gap-6">
          <a href="/installation/" class="hover:text-primary-600 dark:hover:text-primary-400">Installation</a>
          <a href="/components/" class="hover:text-primary-600 dark:hover:text-primary-400">Components</a>
          <a href="/icons/" class="hover:text-primary-600 dark:hover:text-primary-400">Icons</a>
          <a href="/playground/" class="hover:text-primary-600 dark:hover:text-primary-400">Playground</a>
        </div>
        <p class="mt-6 text-center">© {new Date().getFullYear()} LoomiUI.</p>
      </div>
    </footer>

    <script type="application/json" id="playground-data" is:inline set:html={JSON.stringify(playgroundComponents)}></script>

    <script type="module" is:inline set:html={`
      const names = ${JSON.stringify(packagesToImport)};
      for (const name of names) { import("@loomidev/" + name); }
      import("@loomidev/button");
      import("@loomidev/icon");
    `} />

    <script>
      type Control = {
        type: "text" | "select" | "boolean-attr" | "boolean-string" | "number" | "range";
        key: string;
        label: string;
        options?: string[];
        min?: number;
        max?: number;
        step?: number;
      };
      type PlaygroundComponent = {
        key: string;
        title: string;
        tag: string;
        packageName: string;
        description: string;
        defaults: Record<string, string | number | boolean>;
        slot?: string;
        controls: Control[];
      };
      type SelectDetail = { value: string; label: string; values: string[] };

      // loomi-select options can't carry an empty-string value (an empty
      // `selected-value` reads as "nothing selected"), so "Default" options travel
      // under this sentinel and are translated back to "" before rendering markup.
      const DEFAULT_OPTION = "__default__";

      const components = JSON.parse(document.getElementById("playground-data")!.textContent || "[]") as PlaygroundComponent[];
      const byKey = new Map(components.map((component) => [component.key, component]));
      const select = document.getElementById("component-select") as HTMLElement;
      const titleEl = document.getElementById("component-title") as HTMLElement;
      const descriptionEl = document.getElementById("component-description") as HTMLElement;
      const docsLink = document.getElementById("docs-link") as HTMLAnchorElement;
      const previewHost = document.getElementById("preview-host") as HTMLElement;
      const controlsHost = document.getElementById("controls") as HTMLElement;
      const codeEl = document.getElementById("markup-code") as HTMLElement;
      const resetButton = document.getElementById("reset-props") as HTMLButtonElement;
      const copyButton = document.getElementById("copy-code") as HTMLButtonElement;

      let active = components[0];
      let values: Record<string, string | number | boolean> = { ...active.defaults };

      function escapeHtml(value: unknown) {
        return String(value)
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;");
      }

      function controlFor(key: string) {
        return active.controls.find((control) => control.key === key);
      }

      function shouldRenderAttribute(key: string, value: string | number | boolean) {
        const control = controlFor(key);
        // `content` is the element's text content — except for slotted components
        // (e.g. tooltip), where the slot fills the body and `content` is a real attribute.
        if (key === "content" && !active.slot) return false;
        if (typeof value === "string" && value.length === 0) return false;
        if (control?.type === "boolean-attr") return value === true;
        return true;
      }

      function attributeValue(key: string, value: string | number | boolean) {
        const control = controlFor(key);
        if (control?.type === "boolean-attr") return "";
        return String(value);
      }

      function markupForCurrent() {
        const attrs = Object.entries(values)
          .filter(([key, value]) => shouldRenderAttribute(key, value))
          .map(([key, value]) => {
            const attrValue = attributeValue(key, value);
            return attrValue ? `${key}="${escapeHtml(attrValue)}"` : key;
          })
          .join(" ");
        const open = attrs ? `<${active.tag} ${attrs}>` : `<${active.tag}>`;
        const content = "content" in values && !active.slot ? escapeHtml(values.content) : "";
        return `${open}${content}${active.slot ?? ""}</${active.tag}>`;
      }

      function renderPreview() {
        const markup = markupForCurrent();
        previewHost.innerHTML = markup;
        codeEl.textContent = markup;
      }

      function renderControl(control: Control) {
        const wrapper = document.createElement("label");
        wrapper.className = control.type.startsWith("boolean") ? "playground-check-control" : "playground-field";

        if (control.type.startsWith("boolean")) {
          const input = document.createElement("input");
          input.type = "checkbox";
          input.checked = Boolean(values[control.key]);
          input.addEventListener("change", () => {
            values[control.key] = input.checked;
            renderPreview();
          });
          const text = document.createElement("span");
          text.textContent = control.label;
          wrapper.append(input, text);
          return wrapper;
        }

        const text = document.createElement("span");
        text.textContent = control.label;
        wrapper.append(text);

        if (control.type === "select") {
          const input = document.createElement("loomi-select");
          const options = (control.options ?? []).map((option) => ({
            label: option || "Default",
            value: option || DEFAULT_OPTION,
          }));
          input.setAttribute("size", "small");
          input.setAttribute("data", JSON.stringify(options));
          input.setAttribute("selected-value", String(values[control.key] ?? "") || DEFAULT_OPTION);
          input.addEventListener("select", (event) => {
            const picked = (event as CustomEvent<SelectDetail>).detail.value;
            values[control.key] = picked === DEFAULT_OPTION ? "" : picked;
            renderPreview();
          });
          wrapper.append(input);
          return wrapper;
        }

        if (control.type === "range") {
          const row = document.createElement("div");
          row.className = "playground-range-row";
          const input = document.createElement("input");
          input.type = "range";
          input.min = String(control.min ?? 0);
          input.max = String(control.max ?? 100);
          input.step = String(control.step ?? 1);
          input.value = String(values[control.key] ?? control.min ?? 0);
          const output = document.createElement("output");
          output.textContent = input.value;
          input.addEventListener("input", () => {
            values[control.key] = Number(input.value);
            output.textContent = input.value;
            renderPreview();
          });
          row.append(input, output);
          wrapper.append(row);
          return wrapper;
        }

        const input = document.createElement("input");
        input.type = control.type === "number" ? "number" : "text";
        if (control.type === "number") {
          input.min = String(control.min ?? "");
          input.max = String(control.max ?? "");
          input.step = String(control.step ?? 1);
        }
        input.value = String(values[control.key] ?? "");
        input.addEventListener("input", () => {
          values[control.key] = control.type === "number" ? Number(input.value) : input.value;
          renderPreview();
        });
        wrapper.append(input);
        return wrapper;
      }

      function renderControls() {
        controlsHost.replaceChildren(...active.controls.map(renderControl));
      }

      function activate(key: string) {
        active = byKey.get(key) ?? components[0];
        values = { ...active.defaults };
        titleEl.textContent = active.title;
        descriptionEl.textContent = active.description;
        docsLink.href = `/components/${active.key}/`;
        renderControls();
        renderPreview();
      }

      select.addEventListener("select", (event) => activate((event as CustomEvent<SelectDetail>).detail.value));
      resetButton.addEventListener("click", () => activate(active.key));
      copyButton.addEventListener("click", async () => {
        await navigator.clipboard?.writeText(codeEl.textContent ?? "");
        copyButton.classList.add("is-copied");
        window.setTimeout(() => copyButton.classList.remove("is-copied"), 900);
      });

      activate(active.key);
    </script>
  </body>
</html>

