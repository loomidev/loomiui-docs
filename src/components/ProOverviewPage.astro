---
import ProLandingShell from "./ProLandingShell.astro";
import { PRO_LICENSING_URL } from "../lib/pro-licensing.mjs";

const title = "LoomiUI Pro";
const description = "Production-ready templates, themes, design resources, and tooling for teams building with LoomiUI.";

const workflow = [
  { number: "01", title: "Choose a foundation", description: "Start from a complete application template or a production-ready theme preset." },
  { number: "02", title: "Adapt it to your product", description: "Use shared tokens, real screens, and framework variants instead of disconnected examples." },
  { number: "03", title: "Ship and keep moving", description: "Rely on private documentation, tooling, updates, and reusable product patterns." },
];

const included = [
  { icon: "rectangle-stack", title: "Application templates", description: "Admin, SaaS, CRM, and analytics product foundations across four framework choices.", href: "/pro/templates/" },
  { icon: "swatch", title: "Themes and tokens", description: "Twelve presets, semantic design tokens, visual editing, and multiple export formats.", href: "/pro/themes/" },
  { icon: "beaker", title: "Design resources", description: "A matching Figma kit, product frames, brand assets, and launch-ready visuals.", href: "/pro/themes/figma-kit/" },
  { icon: "command-line", title: "Production tooling", description: "CLI workflows, private packages, upgrade guidance, and customer-ready releases.", href: "/cli/" },
];
---

<ProLandingShell title={title} description={description}>
  <section class="pro-hero">
    <div class="pro-hero-copy">
      <div class="feature-kicker">A production layer for LoomiUI</div>
      <h1>Ship complete product surfaces, not component demos</h1>
      <p>
        LoomiUI Pro gives your team application foundations, brand-ready themes, matching design assets, and the tooling needed to move from idea to production faster.
      </p>
      <div class="pro-hero-actions">
        <loomi-button color="primary" tag="a" href="/pro/templates/">Explore templates</loomi-button>
        <loomi-button type="secondary" tag="a" href="/pro/themes/">Explore themes</loomi-button>
      </div>
    </div>

    <div class="product-composition" aria-hidden="true">
      <div class="composition-window">
        <div class="composition-bar"><span></span><span></span><span></span></div>
        <div class="composition-app">
          <div class="composition-nav"></div>
          <div class="composition-content">
            <div class="composition-title"></div>
            <div class="composition-metrics"><span></span><span></span><span></span></div>
            <div class="composition-table"></div>
            <div class="composition-row"></div>
          </div>
        </div>
      </div>
      <div class="composition-swatches"><span></span><span></span><span></span><span></span></div>
    </div>
  </section>

  <section class="direction-grid" aria-label="Explore LoomiUI Pro">
    <a href="/pro/templates/" class="direction-card templates-card">
      <div class="direction-icon"><loomi-icon name="rectangle-stack"></loomi-icon></div>
      <div>
        <p class="section-eyebrow">Start with the product</p>
        <h2>Application templates</h2>
        <p>Complete Admin, SaaS, CRM, and Analytics foundations with real routes, responsive states, and framework variants.</p>
        <span>Explore templates <loomi-icon name="arrow-right"></loomi-icon></span>
      </div>
    </a>
    <a href="/pro/themes/" class="direction-card themes-card">
      <div class="direction-icon"><loomi-icon name="swatch"></loomi-icon></div>
      <div>
        <p class="section-eyebrow">Start with the brand</p>
        <h2>Themes and design system</h2>
        <p>Production presets, semantic tokens, visual tooling, and Figma resources that stay aligned with the code.</p>
        <span>Explore themes <loomi-icon name="arrow-right"></loomi-icon></span>
      </div>
    </a>
  </section>

  <section class="workflow-section" aria-labelledby="workflow-heading">
    <div class="workflow-intro">
      <p class="section-eyebrow">A clearer path to production</p>
      <h2 id="workflow-heading">From foundation to shipped product</h2>
      <p>Pro supports the work around your components—the screens, brand system, and repeatable workflows that turn them into an application.</p>
    </div>
    <ol class="workflow-list">
      {workflow.map((step) => (
        <li>
          <span>{step.number}</span>
          <div><strong>{step.title}</strong><p>{step.description}</p></div>
        </li>
      ))}
    </ol>
  </section>

  <section class="included-section" aria-labelledby="included-heading">
    <div class="section-heading">
      <div>
        <p class="section-eyebrow">One connected system</p>
        <h2 id="included-heading">What Pro includes</h2>
      </div>
      <p>Choose the surface you need now. The rest is there when your product grows.</p>
    </div>
    <div class="included-grid">
      {included.map((item) => (
        <a href={item.href}>
          <span class="included-icon"><loomi-icon name={item.icon}></loomi-icon></span>
          <strong>{item.title}</strong>
          <p>{item.description}</p>
          <loomi-icon name="arrow-right"></loomi-icon>
        </a>
      ))}
    </div>
  </section>

  <section class="purchase-panel">
    <div>
      <p class="section-eyebrow">Build on LoomiUI with confidence</p>
      <h2>Give your next product a stronger starting point</h2>
      <p>Get every template, theme preset, design resource, private package, and future update.</p>
    </div>
    <div class="purchase-actions">
      <loomi-button color="primary" tag="a" href={PRO_LICENSING_URL}>View Pro licenses</loomi-button>
      <loomi-button type="secondary" tag="a" href="/components/">Browse free components</loomi-button>
    </div>
  </section>
</ProLandingShell>

<style>
  .pro-hero { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(22rem, .95fr); align-items: center; gap: 4rem; padding: 1rem 0 2rem; }
  .pro-hero-copy h1 { margin: .7rem 0 0; max-width: 15ch; font-size: clamp(2.75rem, 5vw, 4.15rem); line-height: 1; font-weight: 800; letter-spacing: -.05em; }
  .pro-hero-copy > p { max-width: 39rem; margin: 1.4rem 0 0; color: rgb(75 85 99); font-size: 1.1rem; line-height: 1.75; }
  .pro-hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.75rem; }
  .product-composition { position: relative; padding: 2rem 0 2.5rem; }
  .composition-window { overflow: hidden; border: 1px solid rgb(191 219 254); border-radius: 1.25rem; background: white; box-shadow: 0 28px 70px rgb(37 99 235 / .18); transform: rotate(1.5deg); }
  .composition-bar { display: flex; gap: .35rem; padding: .8rem; border-bottom: 1px solid rgb(219 234 254); }
  .composition-bar span { width: .5rem; height: .5rem; border-radius: 50%; background: rgb(191 219 254); }
  .composition-app { display: grid; grid-template-columns: 4.75rem 1fr; min-height: 20rem; }
  .composition-nav { background: rgb(30 64 175); }
  .composition-content { padding: 1.5rem; background: rgb(248 250 252); }
  .composition-title { width: 52%; height: .85rem; border-radius: 999px; background: rgb(37 99 235); }
  .composition-metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: .65rem; margin-top: 1.5rem; }
  .composition-metrics span { height: 4rem; border: 1px solid rgb(219 234 254); border-radius: .65rem; background: white; }
  .composition-table { height: 5.5rem; margin-top: 1rem; border-radius: .65rem; background: rgb(219 234 254); }
  .composition-row { width: 76%; height: 1.25rem; margin-top: .75rem; border-radius: .45rem; background: rgb(226 232 240); }
  .composition-swatches { position: absolute; right: -1rem; bottom: .25rem; display: flex; gap: .45rem; border: 1px solid rgb(226 232 240); border-radius: 1rem; background: white; padding: .75rem; box-shadow: 0 15px 35px rgb(15 23 42 / .12); }
  .composition-swatches span { width: 2.6rem; height: 2.6rem; border-radius: .65rem; background: #2563eb; }
  .composition-swatches span:nth-child(2) { background: #4f46e5; }
  .composition-swatches span:nth-child(3) { background: #0d9488; }
  .composition-swatches span:nth-child(4) { background: #f59e0b; }
  .direction-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; margin-top: 4rem; }
  .direction-card { display: grid; grid-template-columns: auto 1fr; gap: 1.25rem; overflow: hidden; border: 1px solid rgb(229 231 235); border-radius: 1.25rem; padding: 2rem; color: rgb(17 24 39); text-decoration: none; transition: transform .15s, box-shadow .15s, border-color .15s; }
  .direction-card:hover { transform: translateY(-2px); border-color: rgb(147 197 253); box-shadow: 0 18px 40px rgb(15 23 42 / .08); }
  .templates-card { background: linear-gradient(145deg, white, rgb(239 246 255)); }
  .themes-card { background: linear-gradient(145deg, white, rgb(245 243 255)); }
  .direction-icon, .included-icon { display: grid; width: 2.75rem; height: 2.75rem; place-items: center; border-radius: .8rem; background: rgb(219 234 254); color: rgb(37 99 235); }
  .direction-icon loomi-icon, .included-icon loomi-icon { width: 1.25rem; height: 1.25rem; }
  .direction-card h2, .workflow-intro h2, .section-heading h2, .purchase-panel h2 { margin: .3rem 0 0; font-size: 1.75rem; line-height: 1.2; font-weight: 750; letter-spacing: -.025em; }
  .direction-card div > p:not(.section-eyebrow) { margin: .75rem 0 0; color: rgb(75 85 99); line-height: 1.65; }
  .direction-card div > span { display: inline-flex; align-items: center; gap: .4rem; margin-top: 1.25rem; color: rgb(37 99 235); font-weight: 700; }
  .direction-card div > span loomi-icon { width: 1rem; height: 1rem; }
  .section-eyebrow { margin: 0; color: rgb(37 99 235); font-size: .75rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  .workflow-section { display: grid; grid-template-columns: .8fr 1.2fr; gap: 5rem; margin-top: 5rem; border-radius: 1.25rem; background: rgb(249 250 251); padding: 2.5rem; }
  .workflow-intro > p:last-child { margin: .8rem 0 0; color: rgb(75 85 99); line-height: 1.65; }
  .workflow-list { margin: 0; padding: 0; list-style: none; }
  .workflow-list li { display: grid; grid-template-columns: 2.5rem 1fr; gap: 1rem; padding: 1.15rem 0; border-bottom: 1px solid rgb(229 231 235); }
  .workflow-list li:first-child { padding-top: 0; }
  .workflow-list li:last-child { padding-bottom: 0; border-bottom: 0; }
  .workflow-list li > span { color: rgb(37 99 235); font-size: .75rem; font-weight: 800; letter-spacing: .08em; }
  .workflow-list strong { font-size: .95rem; }
  .workflow-list p { margin: .3rem 0 0; color: rgb(107 114 128); font-size: .875rem; line-height: 1.5; }
  .included-section { margin-top: 5rem; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }
  .section-heading > p { max-width: 30rem; margin: 0; color: rgb(75 85 99); line-height: 1.6; }
  .included-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; margin-top: 1.75rem; }
  .included-grid > a { position: relative; border: 1px solid rgb(229 231 235); border-radius: 1rem; padding: 1.25rem; color: rgb(17 24 39); text-decoration: none; }
  .included-grid > a:hover { border-color: rgb(147 197 253); }
  .included-grid strong { display: block; margin-top: 1rem; }
  .included-grid p { margin: .5rem 0 0; color: rgb(107 114 128); font-size: .85rem; line-height: 1.55; }
  .included-grid > a > loomi-icon { position: absolute; top: 1.5rem; right: 1.25rem; width: 1rem; height: 1rem; color: rgb(37 99 235); }
  .purchase-panel { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin-top: 4rem; border-radius: 1.25rem; background: rgb(239 246 255); padding: 2rem; }
  .purchase-panel p:last-child { margin: .65rem 0 0; color: rgb(75 85 99); }
  .purchase-actions { display: flex; flex-wrap: wrap; gap: .75rem; }
  :global(.dark) .pro-hero-copy > p, :global(.dark) .direction-card div > p:not(.section-eyebrow), :global(.dark) .workflow-intro > p:last-child, :global(.dark) .section-heading > p, :global(.dark) .purchase-panel p:last-child { color: rgb(156 163 175); }
  :global(.dark) .composition-window, :global(.dark) .composition-swatches { border-color: rgb(55 65 81); background: rgb(15 23 42); }
  :global(.dark) .composition-bar { border-color: rgb(30 58 138); }
  :global(.dark) .composition-content { background: rgb(17 24 39); }
  :global(.dark) .composition-metrics span { border-color: rgb(51 65 85); background: rgb(30 41 59); }
  :global(.dark) .direction-card, :global(.dark) .included-grid > a { border-color: rgb(55 65 81); background: rgb(17 24 39); color: rgb(243 244 246); }
  :global(.dark) .workflow-section { background: rgb(17 24 39); }
  :global(.dark) .workflow-list li { border-color: rgb(55 65 81); }
  :global(.dark) .workflow-list p, :global(.dark) .included-grid p { color: rgb(156 163 175); }
  :global(.dark) .purchase-panel { background: rgb(30 58 138 / .3); }
  @media (max-width: 960px) {
    .pro-hero { grid-template-columns: 1fr; }
    .product-composition { max-width: 38rem; }
    .included-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    .direction-grid, .workflow-section, .included-grid { grid-template-columns: 1fr; }
    .workflow-section { gap: 2.5rem; }
    .section-heading, .purchase-panel { align-items: flex-start; flex-direction: column; }
    .product-composition { display: none; }
  }
</style>
