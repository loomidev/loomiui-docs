---
import { Image } from "astro:assets";
import MarketingHeader from "../components/MarketingHeader.astro";
import ProductProofDemos from "../components/home-demos/ProductProofDemos.astro";
import ThemeProvider from "../components/ThemeProvider.astro";
import icon from "../assets/icon.png";
import { buildImportMap } from "../lib/import-map.mjs";
import "../styles/home.css";

const importMap = buildImportMap();
const title = "LoomiUI - One component library for every frontend stack";
const description =
  "LoomiUI is a framework-agnostic library of Web Components built with Lit, fully themeable through CSS custom properties. Install a single component or the entire library";

const heroFeatures = [
  { icon: "cube", title: "Framework agnostic", desc: "Works with any stack" },
  { icon: "shield-check", title: "Accessible foundation", desc: "Keyboard-ready patterns" },
  { icon: "adjustments-horizontal", title: "Customizable", desc: "CSS variables" },
  { icon: "sparkles", title: "Light & Dark", desc: "Theme ready" },
  { icon: "code-bracket", title: "TypeScript", desc: "Fully typed" },
  { icon: "bolt", title: "Modular", desc: "Install per component" },
];

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" />
    <ThemeProvider />
    <script type="importmap" is:inline set:html={JSON.stringify(importMap)} />
  </head>
  <body class="bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100">
    <MarketingHeader />

    <!-- Hero -->
    <div class="post-hero-backdrop">
      <section class="mx-auto max-w-7xl px-6 pb-20 pt-16 sm:pt-20">
        <div class="grid items-center gap-16 lg:grid-cols-2">
          <div>
            <div class="kicker-badge">
              <span>Open source</span><span class="kicker-dot" aria-hidden="true"></span><span>Built with Lit</span>
            </div>
            <h1 class="mt-5 text-5xl font-bold leading-[1.05] tracking-tight text-gray-950 dark:text-white sm:text-6xl">
              Beautiful components.<br />
              Built for <span class="hero-underline text-primary-600 dark:text-primary-400">every</span> frontend.
            </h1>
            <p class="mt-6 max-w-xl text-lg leading-8 text-gray-600 dark:text-gray-300">
              LoomiUI is a framework-agnostic Web Component library built with modern standards and styled your way.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-3">
              <loomi-button color="primary" tag="a" href="/installation/" icon="arrow-right" icon-right>Get Started</loomi-button>
              <loomi-button type="secondary" outline tag="a" href="/components/">Explore Components</loomi-button>
            </div>
            <div class="mobile-hero-proof mt-10 lg:hidden" aria-label="LoomiUI component preview">
              <div><span>Workspace access</span><strong>Invite your team</strong></div>
              <loomi-input label="Work email" placeholder="you@company.com" size="small"></loomi-input>
              <loomi-button color="primary" size="small" block>Send invitation</loomi-button>
            </div>
          </div>

          <div class="hero-stage relative hidden min-h-[28rem] lg:block" aria-hidden="true">
            <div class="hero-stage-glow"></div>

            <div class="hero-float absolute left-0 top-2 w-52">
              <div class="text-xs font-medium text-gray-500 dark:text-gray-400">Sales Overview</div>
              <div class="mt-1 text-2xl font-bold text-gray-950 dark:text-white">$24,780</div>
              <div class="mt-0.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400">+12.6% vs last month</div>
              <div class="mt-2 h-9">
                <loomi-chart
                  type="line"
                  color="primary"
                  style="--loomi-chart-max-height: 2.25rem"
                  data='[{"label":"1","value":12},{"label":"2","value":18},{"label":"3","value":15},{"label":"4","value":24},{"label":"5","value":21},{"label":"6","value":30}]'
                ></loomi-chart>
              </div>
            </div>

            <div class="hero-float absolute right-2 top-8 flex items-center gap-1.5 font-mono text-xs text-gray-600 dark:text-gray-300">
              <loomi-icon name="code-bracket" style="width:0.9rem;height:0.9rem"></loomi-icon>
              loomi-button
            </div>

            <div class="hero-float absolute left-0 top-56 w-52">
              <div class="text-xs font-medium text-gray-500 dark:text-gray-400">Weekly Signups</div>
              <div class="mt-2 h-12">
                <loomi-chart
                  type="bar"
                  color="primary"
                  color2="success"
                  style="--loomi-chart-max-height: 3rem"
                  data='[{"label":"Apr","value":14,"value2":10},{"label":"May","value":18,"value2":15},{"label":"Jun","value":20,"value2":24},{"label":"Jul","value":24,"value2":28}]'
                ></loomi-chart>
              </div>
            </div>

            <!-- z-index bump: every .hero-float sibling shares the same z-index:1 (home.css),
                 so paint order falls back to DOM order. This card's dropdown menu pops out
                 over the rating card below it, which comes later in the DOM and would
                 otherwise paint on top and clip the open menu. -->
            <div class="hero-float absolute right-0 top-40 w-56" style="z-index:5">
              <loomi-dropmenu position="auto" hide-after-click style="display:block;width:100%">
                <div slot="trigger" class="flex w-full cursor-pointer items-center gap-3 border-0 bg-transparent p-0 text-left">
                  <loomi-avatar image="/avatars/female.jpg" size="small"></loomi-avatar>
                  <div class="min-w-0 grow">
                    <div class="truncate text-sm font-semibold text-gray-900 dark:text-white">Alice Wonderland</div>
                    <div class="truncate text-xs text-gray-500 dark:text-gray-400">alice@loomiui.com</div>
                  </div>
                  <loomi-icon name="chevron-down" style="width:1rem;height:1rem;color:#9ca3af"></loomi-icon>
                </div>
                <loomi-dropmenu-item icon="user-circle">Profile</loomi-dropmenu-item>
                <loomi-dropmenu-item icon="cog-6-tooth">Settings</loomi-dropmenu-item>
                <loomi-dropmenu-item divider></loomi-dropmenu-item>
                <loomi-dropmenu-item icon="arrow-right-on-rectangle" variant="destructive">Log out</loomi-dropmenu-item>
              </loomi-dropmenu>
            </div>

            <div class="hero-float absolute bottom-24 right-10 flex items-center gap-2">
              <loomi-rating rating="5" name="hero-rating" clickable="false" color="orange"></loomi-rating>
              <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">4.9 out of 5</span>
            </div>

            <div class="hero-float hero-float-round absolute bottom-0 left-10 flex items-center gap-3">
              <loomi-icon name="bolt" style="width:1rem;height:1rem;color:#9ca3af"></loomi-icon>
              <loomi-toggle checked></loomi-toggle>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- Hero feature strip -->
    <section class="border-t border-gray-100 dark:border-gray-900">
      <div class="mx-auto max-w-6xl px-6 py-12">
        <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-6">
          {heroFeatures.map((item) => (
            <div class="flex items-start gap-2.5">
              <span class="hero-bullet-icon"><loomi-icon name={item.icon} style="width:1rem;height:1rem"></loomi-icon></span>
              <div>
                <div class="text-sm font-semibold text-gray-900 dark:text-white">{item.title}</div>
                <div class="text-xs text-gray-500 dark:text-gray-400">{item.desc}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- One library, every stack -->
    <section class="border-t border-gray-100 dark:border-gray-900">
      <div class="mx-auto max-w-6xl px-6 py-20 text-center">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">One component library for every frontend stack</h2>
        <p class="mt-3 text-gray-600 dark:text-gray-400">Write once. Use anywhere.</p>

        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {["App.jsx", "App.vue", "App.svelte", "index.html"].map((file) => (
            <div class="stack-card">
              <div class="stack-card-code">
                <div class="stack-card-filename">{file}</div>
                <pre><code>&lt;<span class="text-sky-400">loomi-button</span> <span class="text-violet-300">radius</span>=<span class="text-emerald-300">"full"</span>&gt;
  Save User
&lt;/<span class="text-sky-400">loomi-button</span>&gt;</code></pre>
              </div>
              <div class="stack-card-render">
                <loomi-button radius="full">Save User</loomi-button>
              </div>
            </div>
          ))}
        </div>

        <p class="mt-10 text-sm text-gray-500 dark:text-gray-400">
          Works with React, Vue, Svelte, Angular, Solid, Qwik and any web project.
        </p>
        <a href="/installation/" class="mt-2 inline-flex items-center gap-1 text-sm font-semibold text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300">
          See all integrations
          <loomi-icon name="arrow-right" style="width:0.9rem;height:0.9rem"></loomi-icon>
        </a>
      </div>
    </section>

    <!-- Everything you need to build -->
    <section id="home-component-showcase" class="border-t border-gray-100 bg-gray-50/60 dark:border-gray-900 dark:bg-gray-900/20">
      <div class="mx-auto max-w-6xl px-6 py-20">
        <div class="text-center">
          <div class="feature-kicker">Core building blocks</div>
          <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">From a single control to a complete workflow</h2>
          <p class="mt-3 text-gray-600 dark:text-gray-400">
            A representative set of LoomiUI primitives. Browse the gallery when you need the full catalog.
          </p>
        </div>

        <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
          <div class="component-tile" data-cat="layout" data-href="/components/button/">
            <div class="component-tile-preview">
              <loomi-button color="primary">Button</loomi-button>
            </div>
            <div class="component-tile-label">Button</div>
          </div>

          <div class="component-tile" data-cat="data-entry" data-href="/components/input/">
            <div class="component-tile-preview">
              <loomi-input placeholder="Type something..." size="small"></loomi-input>
            </div>
            <div class="component-tile-label">Input</div>
          </div>

          <div class="component-tile" data-cat="data-entry" data-href="/components/select/">
            <div class="component-tile-preview">
              <loomi-select placeholder="Select an option" size="small"></loomi-select>
            </div>
            <div class="component-tile-label">Select</div>
          </div>







          <div class="component-tile" data-cat="overlay" data-href="/components/modal/">
            <div class="component-tile-preview">
              <loomi-button size="small" color="primary" onclick="showLoomiModal('grid-modal-demo')">Open Modal</loomi-button>
              <loomi-modal name="grid-modal-demo" title="A real modal">
                This modal is the actual <code>@loomidev/modal</code> package — not a screenshot.
              </loomi-modal>
            </div>
            <div class="component-tile-label">Modal</div>
          </div>

          <div class="component-tile" data-cat="data-display" data-href="/components/table/">
            <div class="component-tile-preview w-full">
              <loomi-table compact data='[{"Name":"Olivia Rhye","Status":"Active"},{"Name":"Liam Carter","Status":"Invited"}]'></loomi-table>
            </div>
            <div class="component-tile-label">Table</div>
          </div>


          <div class="component-tile" data-cat="feedback" data-href="/components/alert/">
            <div class="component-tile-preview w-full">
              <loomi-alert type="success" class="w-full text-xs">Success! Your changes were saved.</loomi-alert>
            </div>
            <div class="component-tile-label">Alert</div>
          </div>

          <div class="component-tile" data-cat="data-display" data-href="/components/chart/">
            <div class="component-tile-preview w-full">
              <loomi-chart type="line" color="primary" show-y-axis="false" data='[{"label":"Mon","value":18},{"label":"Tue","value":26},{"label":"Wed","value":22},{"label":"Thu","value":34},{"label":"Fri","value":31}]' style="height:4.5rem;width:100%;display:block"></loomi-chart>
            </div>
            <div class="component-tile-label">Chart</div>
          </div>







          <div class="component-tile" data-cat="data-display" data-href="/components/calendar/">
            <div class="component-tile-preview w-full">
              <div style="height:5.5rem;width:100%;overflow:hidden">
                <loomi-calendar view="week" week-starts="monday" style="display:block;width:140%;transform:scale(.58);transform-origin:top left"></loomi-calendar>
              </div>
            </div>
            <div class="component-tile-label">Calendar</div>
          </div>


        </div>

        <div class="mt-10 flex flex-wrap justify-center gap-3">
          <loomi-button color="primary" tag="a" href="/components/">Explore all components</loomi-button>
          <loomi-button type="secondary" tag="a" href="/playground/">Try the Playground</loomi-button>
        </div>
      </div>
    </section>

    <!-- Themed with CSS variables -->
    <section id="home-theme-showcase" class="border-t border-gray-100 dark:border-gray-900">
      <div class="mx-auto max-w-6xl px-6 py-20 text-center">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Themed with CSS variables</h2>
        <p class="mt-3 text-gray-600 dark:text-gray-400">Fully customizable. Works with your design system.</p>

        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <div class="theme-preview-card">
              <div class="theme-mini-stack">
                <loomi-button color="primary" size="small">Primary</loomi-button>
                <loomi-input placeholder="Input field" size="small"></loomi-input>
                <loomi-select placeholder="Dropdown" size="small"></loomi-select>
              </div>
            </div>
            <div class="theme-preview-label">Light</div>
          </div>

          <div>
            <div class="dark theme-preview-card">
              <div class="theme-mini-stack">
                <loomi-button color="primary" size="small">Primary</loomi-button>
                <loomi-input placeholder="Input field" size="small"></loomi-input>
                <loomi-select placeholder="Dropdown" size="small"></loomi-select>
              </div>
            </div>
            <div class="theme-preview-label">Dark</div>
          </div>

          <div>
            <div class="theme-preview-card theme-preview-card-split">
              <div class="theme-mini-stack">
                <loomi-button color="primary" size="small">Primary</loomi-button>
                <loomi-input placeholder="Input field" size="small"></loomi-input>
                <loomi-select placeholder="Dropdown" size="small"></loomi-select>
              </div>
              <div class="dark theme-mini-stack">
                <loomi-button color="primary" size="small">Primary</loomi-button>
                <loomi-input placeholder="Input field" size="small"></loomi-input>
                <loomi-select placeholder="Dropdown" size="small"></loomi-select>
              </div>
            </div>
            <div class="theme-preview-label">Auto (System)</div>
          </div>

          <div>
            <div class="theme-preview-card theme-card-brand">
              <div class="theme-mini-stack">
                <loomi-button color="primary" size="small">Primary</loomi-button>
                <loomi-input placeholder="Input field" size="small"></loomi-input>
                <loomi-select placeholder="Dropdown" size="small"></loomi-select>
              </div>
            </div>
            <div class="theme-preview-label">Brand</div>
          </div>
        </div>

        <a href="/customization/" class="mt-10 inline-flex items-center gap-1 text-sm font-semibold text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300">
          Learn how theming works
          <loomi-icon name="arrow-right" style="width:0.9rem;height:0.9rem"></loomi-icon>
        </a>
      </div>
    </section>

    <ProductProofDemos />

    <section class="border-t border-gray-100 dark:border-gray-900">
      <div class="mx-auto max-w-6xl px-6 py-20">
        <div class="mx-auto max-w-2xl text-center">
          <div class="feature-kicker">Choose your starting point</div>
          <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Use the open library. Add Pro when the product needs more.</h2>
          <p class="mt-4 text-gray-600 dark:text-gray-400">The same LoomiUI component foundation supports both paths, so you can start small without rebuilding later.</p>
        </div>
        <div class="home-path-grid mt-10">
          <article class="home-path-card">
            <span>Open source</span>
            <h3>Build with individual components</h3>
            <p>Install only what you need, customize it with CSS variables, and use it in any frontend stack.</p>
            <loomi-button type="secondary" tag="a" href="/components/">Explore components</loomi-button>
          </article>
          <article class="home-path-card is-pro">
            <span>LoomiUI Pro</span>
            <h3>Start from complete product foundations</h3>
            <p>Add application templates, production theme presets, design resources, and private tooling.</p>
            <loomi-button color="primary" tag="a" href="/pro/">Explore LoomiUI Pro</loomi-button>
          </article>
        </div>
      </div>
    </section>

    <!-- Install CTA -->
    <section class="cta-band">
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold text-white sm:text-4xl">Install LoomiUI and ship your first component.</h2>
          <p class="mt-4 max-w-md text-gray-300">Choose your package manager, add the library, and follow the installation guide for your stack.</p>
          <a href="/installation/" class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-primary-300 hover:text-primary-200">
            Read the installation guide
            <loomi-icon name="arrow-right" style="width:1rem;height:1rem"></loomi-icon>
          </a>
        </div>

        <div class="cta-install-card">
          <div class="flex flex-wrap gap-1" id="pm-tabs" role="tablist">
            {["npm", "pnpm", "yarn", "bun"].map((pm, i) => (
              <button type="button" role="tab" class="pm-tab" aria-selected={i === 0 ? "true" : "false"} data-pm={pm}>{pm}</button>
            ))}
          </div>
          <div class="mt-3 flex items-center justify-between gap-3 rounded-lg bg-gray-950 px-4 py-3">
            <code id="pm-install-command" class="overflow-x-auto whitespace-nowrap font-mono text-sm text-gray-100">npm install @loomidev/components lit</code>
            <button type="button" id="pm-copy" aria-label="Copy install command" class="shrink-0 rounded-md p-1.5 text-gray-400 hover:bg-white/10 hover:text-white">
              <loomi-icon name="clipboard-document" style="width:1rem;height:1rem"></loomi-icon>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="mx-auto max-w-6xl px-6 py-16">
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1fr]">
          <div>
            <a href="/" class="flex items-center gap-2 text-base font-bold text-white">
              <Image src={icon} alt="" class="h-6 w-6" />
              loomi UI
            </a>
            <p class="mt-3 max-w-xs text-sm text-gray-400">
              A modern, accessible, and customizable Web Component library for every frontend stack.
            </p>
            <a
              href="https://github.com/loomidev/loomiui-docs"
              aria-label="GitHub"
              class="mt-4 inline-flex rounded-lg p-2 text-gray-400 hover:bg-white/5 hover:text-white"
            >
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                  d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.026 2.747-1.026.546 1.378.202 2.397.1 2.65.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"
                />
              </svg>
            </a>
          </div>

          <div>
            <div class="footer-heading">Docs</div>
            <ul class="mt-4 space-y-3 text-sm">
              <li><a href="/installation/" class="footer-link">Installation</a></li>
              <li><a href="/components/" class="footer-link">Components</a></li>
              <li><a href="/customization/" class="footer-link">Theming</a></li>
              <li><a href="/mcp-server/" class="footer-link">MCP Server</a></li>
              <li><a href="/cli/" class="footer-link">CLI</a></li>
            </ul>
          </div>

          <div>
            <div class="footer-heading">Resources</div>
            <ul class="mt-4 space-y-3 text-sm">
              <li><a href="https://github.com/loomidev/loomiui-docs" class="footer-link">GitHub</a></li>
              <li><a href="/architecture/" class="footer-link">Architecture</a></li>
              <li><a href="/contributing/" class="footer-link">Contributing</a></li>
              <li><a href="/rtl-support/" class="footer-link">RTL Support</a></li>
            </ul>
          </div>

          <div>
            <div class="footer-heading">Community</div>
            <ul class="mt-4 space-y-3 text-sm">
              <li><a href="https://github.com/loomidev/loomiui-docs/issues" class="footer-link">Report an issue</a></li>
              <li><a href="https://github.com/loomidev/loomiui-docs/discussions" class="footer-link">Discussions</a></li>
            </ul>
            <a href="https://github.com/loomidev/loomiui-docs" class="footer-star-callout">
              <span class="font-semibold text-white">⭐ Star us on GitHub</span>
              <span class="mt-1 block text-gray-400">Help us build the best UI library for the web.</span>
            </a>
          </div>
        </div>

        <div class="mt-12 border-t border-white/10 pt-6 text-center text-sm text-gray-500">
          © {new Date().getFullYear()} LoomiUI. MIT License.
        </div>
      </div>
    </footer>

    <script type="module" is:inline>
      import "@loomidev/button";
      import "@loomidev/icon";
      import "@loomidev/avatar";
      import "@loomidev/chart";
      import "@loomidev/rating";
      import "@loomidev/input";
      import "@loomidev/toggle";
      import "@loomidev/dropmenu";

      const loadedPackages = new Set(["button", "icon", "avatar", "chart", "rating", "input", "toggle", "dropmenu"]);
      const loadPackages = async (names) => {
        const pending = names.filter((name) => !loadedPackages.has(name));
        pending.forEach((name) => loadedPackages.add(name));
        await Promise.all(pending.map((name) => import("@loomidev/" + name)));
      };
      const groups = new Map([
        [document.getElementById("home-component-showcase"), ["select", "modal", "table", "alert", "calendar"]],
        [document.getElementById("home-theme-showcase"), ["select"]],
        [document.querySelector(".proof-band"), ["card", "tag", "password", "select", "checkbox", "textarea", "datepicker", "date-range-picker", "modal", "tooltip", "table", "bell", "button-group", "tab", "horizontal-line-graph", "sortable", "progress", "drawer", "autocomplete", "calendar", "chat"]],
      ]);
      const sectionObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          sectionObserver.unobserve(entry.target);
          void loadPackages(groups.get(entry.target) || []).then(() => {
            if (!entry.target.matches(".proof-band")) return;
            window.__loomiComponentsLoaded = true;
            window.dispatchEvent(new Event("loomi-components-loaded"));
          });
        }
      }, { rootMargin: "700px 0px" });
      groups.forEach((_, section) => { if (section) sectionObserver.observe(section); });
    </script>

    <script>
      const tiles = document.querySelectorAll<HTMLElement>(".component-tile");
      tiles.forEach((tile) => {
        const link = document.createElement("a");
        link.className = "component-tile-link";
        link.href = tile.dataset.href ?? "/components/";
        link.setAttribute("aria-label", `View ${tile.querySelector(".component-tile-label")?.textContent?.trim() ?? "component"} documentation`);
        tile.append(link);
      });
      document.querySelectorAll<HTMLElement>(".component-tile-preview").forEach((preview) => {
        preview.setAttribute("inert", "");
        preview.setAttribute("aria-hidden", "true");
      });
    </script>

    <script>
      // Install CTA: swap the displayed command per package manager and copy it —
      // both read straight from this map, no server round-trip.
      const PM_COMMANDS: Record<string, string> = {
        npm: "npm install @loomidev/components lit",
        pnpm: "pnpm add @loomidev/components lit",
        yarn: "yarn add @loomidev/components lit",
        bun: "bun add @loomidev/components lit",
      };
      const pmTabsBar = document.getElementById("pm-tabs");
      const pmCommand = document.getElementById("pm-install-command");
      pmTabsBar?.addEventListener("click", (e) => {
        const target = e.target;
        if (!(target instanceof Element)) return;
        const tab = target.closest("button[data-pm]");
        if (!(tab instanceof HTMLElement) || !pmCommand) return;
        for (const t of pmTabsBar.querySelectorAll("button[data-pm]")) {
          t.setAttribute("aria-selected", String(t === tab));
        }
        pmCommand.textContent = PM_COMMANDS[tab.dataset.pm ?? "npm"] ?? PM_COMMANDS.npm;
      });
      document.getElementById("pm-copy")?.addEventListener("click", () => {
        if (pmCommand?.textContent) void navigator.clipboard.writeText(pmCommand.textContent);
      });
    </script>

    <script>
      import "../scripts/product-proof-demos.ts";
    </script>
  </body>
</html>
