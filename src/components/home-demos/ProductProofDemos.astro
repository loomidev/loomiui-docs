---
import DashboardDemo from "./DashboardDemo.astro";
import KanbanDemo from "./KanbanDemo.astro";
---

<section class="proof-band border-t border-gray-100 px-6 py-20 dark:border-gray-900">
  <div class="mx-auto max-w-3xl text-center">
    <div>
      <div class="text-sm font-semibold uppercase tracking-[0.18em] text-primary-600 dark:text-primary-300">
        Live product proof
      </div>
      <h2 class="mt-3 text-3xl font-bold sm:text-4xl">Two real product workflows, built from LoomiUI.</h2>
    </div>
    <p class="mx-auto mt-4 max-w-2xl text-gray-600 dark:text-gray-400">
      Explore an operations dashboard and a collaborative project workspace. Both use live
      LoomiUI components wired into realistic product interactions.
    </p>
  </div>

  <div id="product-proof-demos" class="proof-shell mx-auto mt-10 max-w-6xl">
    <div class="proof-window-bar">
      <div class="proof-window-dots" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <div class="proof-window-title">
        <loomi-icon name="sparkles" style="width:1rem;height:1rem"></loomi-icon>
        LoomiUI proof workspace
      </div>
      <loomi-tag label="Interactive" color="green"></loomi-tag>
    </div>

    <loomi-tabs class="proof-tabs" tab-style="pills" color="primary">
      <loomi-tab label="Dashboard" icon="chart-bar-square" active>
        <DashboardDemo />
      </loomi-tab>
      <loomi-tab label="Kanban" icon="view-columns">
        <KanbanDemo />
      </loomi-tab>
    </loomi-tabs>
  </div>

  <div class="proof-followup mx-auto mt-6 flex max-w-6xl flex-wrap items-center justify-between gap-3">
    <p>Want to test individual properties instead?</p>
    <loomi-button type="secondary" tag="a" href="/playground/" size="small" icon="arrow-right" icon-right>Open the Playground</loomi-button>
  </div>

  <loomi-modal name="dashboard-profile-modal" title="Profile" show-action-buttons="false" show-close-icon>
    <div class="proof-profile-modal">
      <loomi-avatar image="/avatars/female.jpg" label="Alice Wonderland" size="large"></loomi-avatar>
      <div>
        <h3>Alice Wonderland</h3>
        <p>Supervisor - Operations command</p>
      </div>
      <loomi-input label="Display name" value="Alice Wonderland"></loomi-input>
      <loomi-input label="Email" value="alice@northstarops.example"></loomi-input>
      <loomi-button class="proof-modal-save" color="primary" data-proof-toast="Profile updated">Save profile</loomi-button>
    </div>
  </loomi-modal>

  <loomi-modal name="dashboard-preferences-modal" title="Preferences" show-action-buttons="false" show-close-icon>
    <div class="proof-pref-grid">
      <div>
        <strong>Compact density</strong>
        <span>Fit more operational rows on screen.</span>
      </div>
      <loomi-toggle checked></loomi-toggle>
      <div>
        <strong>Daily digest</strong>
        <span>Send a morning delivery summary.</span>
      </div>
      <loomi-toggle checked></loomi-toggle>
      <div>
        <strong>Keyboard shortcuts</strong>
        <span>Enable power-user navigation.</span>
      </div>
      <loomi-toggle></loomi-toggle>
    </div>
  </loomi-modal>

  <loomi-drawer name="kanban-task-drawer" title="Task details">
    <div class="kanban-drawer-body">
      <h4 data-ktd-title>Task</h4>
      <div class="ktd-meta-grid">
        <span class="ktd-label">Status</span>
        <span><loomi-tag data-ktd-status label="To Do" color="primary"></loomi-tag></span>
        <span class="ktd-label">Team</span>
        <span data-ktd-team>-</span>
        <span class="ktd-label">Due date</span>
        <span data-ktd-date>-</span>
        <span class="ktd-label">Assignee</span>
        <button class="ktd-assignee" type="button" data-ktd-reassign>
          <loomi-avatar data-ktd-avatar size="tiny"></loomi-avatar>
          <span data-ktd-assignee>-</span>
          <loomi-icon name="pencil-square"></loomi-icon>
        </button>
      </div>
      <loomi-textarea rows="3" label="Notes" placeholder="Add a note for the team..."></loomi-textarea>
      <div class="kanban-drawer-actions">
        <loomi-button size="small" type="secondary" icon="user-circle" data-ktd-reassign>Reassign</loomi-button>
        <loomi-button size="small" color="primary" icon="check" data-ktd-toggle>Mark as done</loomi-button>
      </div>
    </div>
  </loomi-drawer>

  <loomi-drawer name="kanban-new-task-drawer" title="New task">
    <div class="kanban-drawer-body">
      <loomi-input id="knt-title" label="Title" placeholder="What needs doing?" required></loomi-input>
      <loomi-select
        id="knt-team"
        label="Team"
        selected-value="UI/UX"
        data='[{"label":"UI/UX","value":"UI/UX"},{"label":"Backend","value":"Backend"},{"label":"DevOps","value":"DevOps"},{"label":"Content","value":"Content"},{"label":"Research","value":"Research"},{"label":"Planning","value":"Planning"}]'
      ></loomi-select>
      <loomi-datepicker id="knt-date" label="Due date" selected-value="2026-07-21"></loomi-datepicker>
      <loomi-autocomplete id="knt-assignee" label="Assignee" placeholder="Search teammates"></loomi-autocomplete>
      <loomi-select
        id="knt-column"
        label="Add to"
        selected-value="todo"
        data='[{"label":"To Do","value":"todo"},{"label":"In Progress","value":"progress"},{"label":"Done","value":"done"}]'
      ></loomi-select>
      <div class="kanban-drawer-actions">
        <loomi-button size="small" type="secondary" data-knt-cancel>Cancel</loomi-button>
        <loomi-button size="small" color="primary" icon="plus" data-knt-add>Add task</loomi-button>
      </div>
    </div>
  </loomi-drawer>

  <loomi-modal name="kanban-assignee-modal" title="Reassign task" show-action-buttons="false" show-close-icon>
    <div class="kanban-assignee-body">
      <p data-kam-task class="kam-task"></p>
      <loomi-autocomplete id="kam-picker" label="Assign to" placeholder="Search teammates"></loomi-autocomplete>
    </div>
  </loomi-modal>

  <div id="proof-toast" class="proof-toast hidden" role="status" aria-live="polite"></div>
</section>
