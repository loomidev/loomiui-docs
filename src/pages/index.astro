    <script>
      // "Everything you need to build" filter pills: pure client-side show/hide, no
      // routing — data-cat on each tile is a curated grouping for this showcase, not
      // tied to the docs site's own category taxonomy.
      const filterBar = document.getElementById("component-filters");
      const tiles = document.querySelectorAll<HTMLElement>(".component-tile");
      filterBar?.addEventListener("click", (e) => {
        const target = e.target;
        if (!(target instanceof Element)) return;
        const button = target.closest("button[data-filter]");
        if (!(button instanceof HTMLElement)) return;
        const filter = button.dataset.filter ?? "all";
        for (const b of filterBar.querySelectorAll("button[data-filter]")) {
          b.setAttribute("aria-pressed", String(b === button));
        }
        for (const tile of tiles) {
          tile.classList.toggle("hidden", filter !== "all" && tile.dataset.cat !== filter);
        }
      });
    </script>

    <script>
      // Install CTA: swap the displayed command per package manager and copy it —
      // both read straight from this map, no server round-trip.
      const PM_COMMANDS: Record<string, string> = {
        npm: "npm install @loomidev/components lit",
        pnpm: "pnpm add @loomidev/components lit",
        yarn: "yarn add @loomidev/components lit",
        bun: "bun add @loomidev/components lit",
      };
      const pmTabsBar = document.getElementById("pm-tabs");
      const pmCommand = document.getElementById("pm-install-command");
      pmTabsBar?.addEventListener("click", (e) => {
        const target = e.target;
        if (!(target instanceof Element)) return;
        const tab = target.closest("button[data-pm]");
        if (!(tab instanceof HTMLElement) || !pmCommand) return;
        for (const t of pmTabsBar.querySelectorAll("button[data-pm]")) {
          t.setAttribute("aria-selected", String(t === tab));
        }
        pmCommand.textContent = PM_COMMANDS[tab.dataset.pm ?? "npm"] ?? PM_COMMANDS.npm;
      });
      document.getElementById("pm-copy")?.addEventListener("click", () => {
        if (pmCommand?.textContent) void navigator.clipboard.writeText(pmCommand.textContent);
      });
    </script>

