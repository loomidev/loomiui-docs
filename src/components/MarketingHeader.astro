---
// Header for the marketing homepage ONLY (src/pages/index.astro). Deliberately not
// Starlight's docs header — a marketing nav (logo, links, a search shortcut, one CTA)
// reads differently from a docs header (logo, search, sidebar toggle, theme switcher)
// and trying to share one component between both would just constrain this one.
//
// Still dogfoods loomi for its interactive pieces: the theme switcher and the
// Resources dropdown.
import { Image } from "astro:assets";
import icon from "../assets/icon.png";
import logoLight from "../assets/logo-light.png";
import logoDark from "../assets/logo-dark.png";

import { PRO_LICENSING_URL } from "../lib/pro-licensing.mjs";

const GITHUB_URL = "https://github.com/loomidev/loomiui-docs";
---

<header class="sticky top-0 z-50 border-b border-gray-200 bg-white/80 backdrop-blur dark:border-gray-800 dark:bg-gray-950/80">
  <div class="mx-auto flex max-w-7xl items-center px-4 py-3">
    <a href="/" class="flex min-w-0 shrink-0 items-center">
      <Image src={icon} alt="loomiui" class="h-8 w-8 sm:hidden" />
      <Image src={logoLight} alt="loomiui" class="hidden h-7 w-auto dark:hidden sm:block" />
      <Image src={logoDark} alt="loomiui" class="hidden h-7 w-auto dark:sm:block" />
    </a>

    <nav class="ml-10 hidden items-center gap-7 text-sm font-medium text-gray-600 dark:text-gray-300 lg:flex">
      <a href="/installation/" class="hover:text-primary-600 dark:hover:text-primary-400">Docs</a>
      <a href="/components/" class="hover:text-primary-600 dark:hover:text-primary-400">Components</a>
      <a href="/playground/" class="hover:text-primary-600 dark:hover:text-primary-400">Playground</a>
      <loomi-dropmenu position="auto" hide-after-click>
        <button slot="trigger" type="button" class="flex cursor-pointer items-center gap-1 border-0 bg-transparent p-0 font-sans text-sm font-medium text-gray-600 hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400">
          Resources
          <loomi-icon name="chevron-down" style="width:0.85rem;height:0.85rem"></loomi-icon>
        </button>
        <loomi-dropmenu-item icon="squares-plus"><a href="/icons/">Icons</a></loomi-dropmenu-item>
        <loomi-dropmenu-item icon="cpu-chip"><a href="/mcp-server/">MCP Server</a></loomi-dropmenu-item>
        <loomi-dropmenu-item icon="command-line"><a href="/cli/">CLI</a></loomi-dropmenu-item>
        <loomi-dropmenu-item icon="building-library"><a href="/architecture/">Architecture</a></loomi-dropmenu-item>
        <loomi-dropmenu-item icon="code-bracket"><a href="/contributing/">Contributing</a></loomi-dropmenu-item>
        <loomi-dropmenu-item icon="language"><a href="/rtl-support/">RTL Support</a></loomi-dropmenu-item>
        <loomi-dropmenu-item divider icon="star"><a href={GITHUB_URL}>Star on GitHub</a></loomi-dropmenu-item>
      </loomi-dropmenu>
      <loomi-dropmenu position="auto" hide-after-click>
        <button slot="trigger" type="button" class="flex cursor-pointer items-center gap-1 border-0 bg-transparent p-0 font-sans text-sm font-medium text-gray-600 hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400">
          Pro
          <loomi-icon name="chevron-down" style="width:0.85rem;height:0.85rem"></loomi-icon>
        </button>
        <loomi-dropmenu-item icon="swatch"><a href="/pro/themes/">Themes</a></loomi-dropmenu-item>
        <loomi-dropmenu-item icon="rectangle-stack"><a href="/pro/templates/">Templates</a></loomi-dropmenu-item>
      </loomi-dropmenu>
    </nav>

    <div class="ml-auto flex min-w-0 items-center gap-2 sm:gap-3">
      <a
        href="/components/"
        class="hidden items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 px-3 py-1.5 text-sm text-gray-400 hover:border-gray-300 hover:text-gray-500 dark:border-gray-800 dark:bg-gray-900 dark:text-gray-500 dark:hover:border-gray-700 dark:hover:text-gray-400 lg:flex"
      >
        <loomi-icon name="magnifying-glass" style="width:1rem;height:1rem"></loomi-icon>
        <span>Search docs...</span>
        <kbd class="ml-6 rounded border border-gray-300 bg-white px-1.5 py-0.5 font-sans text-[10px] font-semibold text-gray-400 dark:border-gray-700 dark:bg-gray-800">⌘K</kbd>
      </a>
      <loomi-theme-switcher variant="dropmenu"></loomi-theme-switcher>
      <a
        href={GITHUB_URL}
        aria-label="GitHub"
        class="hidden rounded-lg p-2 text-gray-500 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white sm:inline-flex"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.026 2.747-1.026.546 1.378.202 2.397.1 2.65.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"
          />
        </svg>
      </a>
      <loomi-button class="hidden sm:inline-flex" type="secondary" size="small" tag="a" href="/installation/">Get Started</loomi-button>
      <loomi-button class="hidden sm:inline-flex" color="primary" size="small" tag="a" href={PRO_LICENSING_URL}>Get Pro</loomi-button>
    </div>
  </div>
</header>

<script type="module" is:inline>
  import "@loomidev/theme-switcher";
  import "@loomidev/button";
  import "@loomidev/icon";
  import "@loomidev/dropmenu";
</script>
