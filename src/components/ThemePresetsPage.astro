// Semicircle gauge — no gauge component exists, so this mirrors the sparkline helper
// and builds an SVG arc the preset primary color fills via currentColor.
function gauge(percentage: number) {
  const cx = 100;
  const cy = 100;
  const r = 82;
  const length = Math.PI * r;
  const angle = Math.PI - (percentage / 100) * Math.PI;
  const knobX = cx + r * Math.cos(angle);
  const knobY = cy - r * Math.sin(angle);
  return {
    track: `M ${cx - r} ${cy} A ${r} ${r} 0 0 1 ${cx + r} ${cy}`,
    length: Number(length.toFixed(1)),
    filled: Number((length * (percentage / 100)).toFixed(1)),
    knobX: Number(knobX.toFixed(1)),
    knobY: Number(knobY.toFixed(1)),
  };
}
const goalGauge = gauge(72);

function sparkline(values: number[]) {
  const width = 120;
  const height = 36;
  const max = Math.max(...values);
  const min = Math.min(...values);
  const range = max - min || 1;
  const points = values.map((value, index) => [
    (index / (values.length - 1)) * width,
    4 + (1 - (value - min) / range) * (height - 8),
  ]);
  const line = points.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(" ");
  const area = `M0,${height} L${points.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(" L")} L${width},${height} Z`;
  return { line, area };
}

