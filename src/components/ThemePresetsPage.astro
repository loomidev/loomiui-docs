---
import ProLandingShell from "./ProLandingShell.astro";
import { readFileSync, existsSync } from "node:fs";
import { resolve } from "node:path";
import { PRO_LICENSING_URL } from "../lib/pro-licensing.mjs";

const title = "Theme Presets - LoomiUI Pro";
const description = "Compare all twelve LoomiUI Pro presets in light and dark mode, inspect their design direction, and choose a foundation for your product.";

const fallbackPresets = [
  ["default", "Loomi Default", "Confident blue with cool slate neutrals.", "#3b82f6", "Admin Pro", "admin"],
  ["saas-admin", "SaaS Admin", "Indigo for dense control surfaces.", "#6366f1", "SaaS Starter", "saas"],
  ["fintech", "Fintech", "Deep teal for numbers-first products.", "#14b8a6", "CRM", "crm"],
  ["healthcare", "Healthcare", "Calm sky blue for patient-facing clarity.", "#0ea5e9", "", ""],
  ["education", "Education", "Friendly violet for learning tools.", "#8b5cf6", "", ""],
  ["creator-tools", "Creator Tools", "Expressive rose for creative workflows.", "#f43f5e", "", ""],
  ["developer-tools", "Developer Tools", "Cyan and deep neutrals for technical UI.", "#06b6d4", "Analytics Dashboard", "analytics"],
  ["ecommerce-admin", "E-commerce Admin", "Energetic orange for catalog operations.", "#f97316", "", ""],
  ["enterprise-neutral", "Enterprise Neutral", "Restrained slate for long work sessions.", "#64748b", "", ""],
  ["high-contrast", "High Contrast", "Strong boundaries and visible focus states.", "#3b82f6", "", ""],
  ["marketing-growth", "Marketing Growth", "Vibrant emerald for campaign analytics.", "#10b981", "", ""],
  ["legal-compliance", "Legal & Compliance", "Structured amber for audit workflows.", "#f59e0b", "", ""],
].map(([name, label, presetDescription, primary500, starterName, starterSlug]) => ({
  name,
  label,
  description: presetDescription,
  primary500,
  starterKit: starterName ? { name: starterName, slug: starterSlug } : null,
  css: `css/${name}.css`,
  json: `json/${name}.json`,
}));

function loadThemeBundle() {
  const docsRoot = process.cwd();
  const roots = [
    resolve(docsRoot, "public/pro/themes"),
    resolve(docsRoot, "../pro/packages/themes/dist"),
  ];

  for (const root of roots) {
    const manifestFile = resolve(root, "json/manifest.json");
    if (!existsSync(manifestFile)) continue;

    const manifest = JSON.parse(readFileSync(manifestFile, "utf8"));
    const tokens: Record<string, any> = {};
    for (const preset of manifest.presets) {
      const tokenFile = resolve(root, preset.json);
      if (existsSync(tokenFile)) tokens[preset.name] = JSON.parse(readFileSync(tokenFile, "utf8"));
    }
    return { manifest, tokens };
  }

  return { manifest: { presets: fallbackPresets }, tokens: {} };
}

const themeBundle = loadThemeBundle();
const presets = themeBundle.manifest.presets;
const initialPreset = presets[0];
const initialTokens = themeBundle.tokens[initialPreset.name]?.modes?.light;
const overviewChartData = JSON.stringify([
  { label: "Mon", value: 64, value2: 58 },
  { label: "Tue", value: 78, value2: 67 },
  { label: "Wed", value: 71, value2: 69 },
  { label: "Thu", value: 92, value2: 76 },
  { label: "Fri", value: 86, value2: 79 },
  { label: "Sat", value: 104, value2: 88 },
  { label: "Sun", value: 96, value2: 91 },
]);
const acquisitionChartData = JSON.stringify([
  { label: "Direct", value: 42 },
  { label: "Search", value: 31 },
  { label: "Social", value: 17 },
  { label: "Email", value: 10 },
]);
const customerRows = JSON.stringify([
  { name: "Northstar Labs", plan: "Business", seats: 42, status: "Active", mrr: "$4,200" },
  { name: "Aster Health", plan: "Enterprise", seats: 118, status: "Active", mrr: "$11,800" },
  { name: "Kite Commerce", plan: "Growth", seats: 24, status: "Trial", mrr: "$1,640" },
  { name: "Clarity Legal", plan: "Business", seats: 36, status: "Active", mrr: "$3,600" },
]);

function paletteFor(preset: any) {
  const mode = themeBundle.tokens[preset.name]?.modes?.light;
  return [
    mode?.color?.primary?.[500] ?? preset.primary500,
    mode?.color?.primary?.[200] ?? preset.primary500,
    mode?.color?.surface?.muted ?? "#f8fafc",
    mode?.color?.text?.base ?? "#0f172a",
  ];
}
---

<ProLandingShell title={title} description={description} wide>
  <a class="back-link" href="/pro/themes/">
    <loomi-icon name="arrow-left"></loomi-icon>
    Back to themes
  </a>

  <section class="preset-hero">
    <div>
      <p class="section-eyebrow">Theme presets</p>
      <h1>Choose a visual direction. Keep one token contract.</h1>
      <p>Compare every Pro preset in the same product shell, switch between light and dark mode, then take the closest direction into the Theme Builder.</p>
    </div>
    <div class="hero-actions">
      <loomi-button color="primary" tag="a" href="/pro/themes/theme-builder/">Customize a preset</loomi-button>
      <loomi-button type="secondary" tag="a" href={PRO_LICENSING_URL}>Get Pro</loomi-button>
    </div>
  </section>

  <section class="catalog-section" aria-labelledby="preset-catalog-heading">
    <div class="section-heading">
      <div>
        <p class="section-eyebrow">All included presets</p>
        <h2 id="preset-catalog-heading">12 foundations for different product moods</h2>
      </div>
      <p>Select any preset to update the preview and implementation details below.</p>
    </div>

    <div class="preset-grid" id="preset-grid">
      {presets.map((preset: any, index: number) => (
        <button
          type="button"
          class:list={["preset-card", index === 0 && "is-active"]}
          data-preset={preset.name}
          aria-pressed={index === 0 ? "true" : "false"}
        >
          <span class="preset-palette" aria-hidden="true">
            {paletteFor(preset).map((color: string) => <span style={`background:${color}`}></span>)}
          </span>
          <span class="preset-card-copy">
            <strong>{preset.label}</strong>
            <small>{preset.description}</small>
          </span>
          {preset.starterKit && <span class="starter-badge">Pairs with {preset.starterKit.name}</span>}
        </button>
      ))}
    </div>
  </section>

  <section class="workbench" aria-labelledby="selected-preset-name">
    <div class="workbench-header">
      <div>
        <p class="section-eyebrow">Selected preset</p>
        <h2 id="selected-preset-name">{initialPreset.label}</h2>
        <p id="selected-preset-description">{initialPreset.description}</p>
      </div>
      <div class="mode-toggle" role="group" aria-label="Preview color mode">
        <button type="button" class="mode-button is-active" data-mode="light" aria-pressed="true">
          <loomi-icon name="sun"></loomi-icon> Light
        </button>
        <button type="button" class="mode-button" data-mode="dark" aria-pressed="false">
          <loomi-icon name="moon"></loomi-icon> Dark
        </button>
      </div>
    </div>

    <div class="workbench-layout">
      <div class="preview-canvas" id="preview-canvas" style={`
        --preview-primary:${initialTokens?.color?.primary?.[500] ?? initialPreset.primary500};
        --preview-primary-soft:${initialTokens?.color?.primary?.[50] ?? "#eff6ff"};
        --preview-primary-strong:${initialTokens?.color?.primary?.[700] ?? initialPreset.primary500};
        --preview-surface:${initialTokens?.color?.surface?.base ?? "#ffffff"};
        --preview-surface-muted:${initialTokens?.color?.surface?.muted ?? "#f8fafc"};
        --preview-surface-raised:${initialTokens?.color?.surface?.raised ?? "#ffffff"};
        --preview-border:${initialTokens?.color?.surface?.border ?? "#e2e8f0"};
        --preview-text:${initialTokens?.color?.text?.base ?? "#0f172a"};
        --preview-text-muted:${initialTokens?.color?.text?.muted ?? "#64748b"};
        --preview-radius:${initialTokens?.component?.panelRadius ?? "12px"};
        --preview-shadow:${initialTokens?.component?.cardShadow ?? "0 1px 3px rgba(15,23,42,.1)"};
      `}>
        <aside class="demo-sidebar">
          <div class="demo-brand"><span></span><strong id="demo-brand-name">{initialPreset.label}</strong></div>
          <nav aria-label="Preview pages">
            <button type="button" class="is-current" data-demo-view="overview" aria-current="page"><loomi-icon name="squares-2x2"></loomi-icon>Overview</button>
            <button type="button" data-demo-view="customers"><loomi-icon name="users"></loomi-icon>Customers</button>
            <button type="button" data-demo-view="analytics"><loomi-icon name="chart-bar"></loomi-icon>Analytics</button>
            <button type="button" data-demo-view="settings"><loomi-icon name="cog-6-tooth"></loomi-icon>Settings</button>
          </nav>
          <loomi-profile-menu
            class="demo-profile-menu"
            name="Ama Mensah"
            description="Product lead"
            avatar-label="AM"
            avatar-size="small"
            dotted
            transparent
            placement="left"
          >
            <loomi-dropmenu-item icon="user-circle">Profile</loomi-dropmenu-item>
            <loomi-dropmenu-item icon="cog-6-tooth">Account settings</loomi-dropmenu-item>
            <loomi-dropmenu-item divider></loomi-dropmenu-item>
            <loomi-dropmenu-item icon="arrow-right-start-on-rectangle" variant="destructive">Sign out</loomi-dropmenu-item>
          </loomi-profile-menu>
        </aside>
        <div class="demo-main">
          <header class="demo-topbar">
            <div><small id="demo-page-kicker">Workspace</small><strong id="demo-page-title">Performance overview</strong></div>
            <div class="demo-topbar-actions">
              <loomi-button type="secondary" size="small" icon="magnifying-glass" aria-label="Search workspace"></loomi-button>
              <loomi-button color="primary" size="small" icon="arrow-down-tray">Export</loomi-button>
            </div>
          </header>
          <main>
            <section class="demo-view is-active" data-demo-panel="overview">
              <div class="demo-welcome">
                <div><small>Last 30 days</small><h3>Good morning, Ama</h3><p>Here is what changed across your workspace.</p></div>
                <loomi-tag label="Workspace growth +12.4% vs previous period" color="success" rounded></loomi-tag>
              </div>
              <div class="demo-view-toolbar">
                <loomi-select
                  size="small"
                  selected-value="30"
                  aria-label="Reporting period"
                  data='[{"label":"Last 7 days","value":"7"},{"label":"Last 30 days","value":"30"},{"label":"Last quarter","value":"90"}]'
                ></loomi-select>
                <loomi-button type="secondary" size="small" icon="funnel">Filter</loomi-button>
              </div>
              <div class="demo-metrics">
                <loomi-statistic label="Active users" number="8,429" icon-position="right" radius="large">
                  <loomi-icon slot="icon" name="users"></loomi-icon>
                </loomi-statistic>
                <loomi-statistic label="Conversion" number="4.82%" icon-position="right" radius="large">
                  <loomi-icon slot="icon" name="arrow-trending-up"></loomi-icon>
                </loomi-statistic>
                <loomi-statistic label="Revenue" number="84.2k" currency="$" icon-position="right" radius="large">
                  <loomi-icon slot="icon" name="banknotes"></loomi-icon>
                </loomi-statistic>
              </div>
              <div class="demo-lower">
                <loomi-card size="sm" class="demo-chart-card">
                  <loomi-card-header>
                    <loomi-card-title>Weekly activity</loomi-card-title>
                    <loomi-card-description>Current period compared with the previous period</loomi-card-description>
                  </loomi-card-header>
                  <loomi-card-content>
                    <loomi-chart
                      id="overview-theme-chart"
                      type="line"
                      color="primary"
                      color2="gray"
                      series-label="Current"
                      series2-label="Previous"
                      show-y-axis="false"
                      data={overviewChartData}
                    ></loomi-chart>
                  </loomi-card-content>
                </loomi-card>
                <loomi-card size="sm" class="demo-activity-card">
                  <loomi-card-header>
                    <loomi-card-title>Recent activity</loomi-card-title>
                    <loomi-card-description>Latest workspace changes</loomi-card-description>
                  </loomi-card-header>
                  <loomi-card-content>
                    <loomi-timeline stacked>
                      <loomi-timeline-item date="2 min ago" content="Ama exported a revenue report" completed></loomi-timeline-item>
                      <loomi-timeline-item date="18 min ago" content="Kojo invited a workspace member" completed></loomi-timeline-item>
                      <loomi-timeline-item date="1 hr ago" content="Esi updated the billing profile"></loomi-timeline-item>
                    </loomi-timeline>
                  </loomi-card-content>
                </loomi-card>
              </div>
              <loomi-card size="sm" class="goal-card">
                <loomi-card-header>
                  <loomi-card-title>Quarterly activation goal</loomi-card-title>
                  <loomi-card-description>1,842 of 2,400 new workspaces activated</loomi-card-description>
                </loomi-card-header>
                <loomi-card-content><loomi-progress-bar percentage="77" color="success" show-percentage-label></loomi-progress-bar></loomi-card-content>
              </loomi-card>
            </section>

            <section class="demo-view" data-demo-panel="customers" hidden>
              <div class="demo-section-heading"><div><small>Customer directory</small><h3>Customers</h3><p>Search accounts, review plans, and monitor workspace health.</p></div><loomi-button color="primary" size="small" icon="plus">Add customer</loomi-button></div>
              <div class="customer-summary">
                <loomi-statistic label="Total customers" number="1,284" radius="large"></loomi-statistic>
                <loomi-statistic label="Active trials" number="86" radius="large"></loomi-statistic>
                <loomi-statistic label="Expansion MRR" number="12.6k" currency="$" radius="large"></loomi-statistic>
              </div>
              <loomi-card size="sm">
                <loomi-card-header><loomi-card-title>Customer accounts</loomi-card-title><loomi-card-description>Latest plan and revenue status</loomi-card-description></loomi-card-header>
                <loomi-card-content>
                  <loomi-table compact has-border has-hover searchable sortable search-placeholder="Search customer accounts…" data={customerRows}></loomi-table>
                </loomi-card-content>
              </loomi-card>
            </section>

            <section class="demo-view" data-demo-panel="analytics" hidden>
              <div class="demo-section-heading"><div><small>Product intelligence</small><h3>Analytics</h3><p>Understand acquisition, retention, and feature adoption.</p></div><loomi-tag label="Live data" color="success" rounded></loomi-tag></div>
              <div class="analytics-grid">
                <loomi-card size="sm">
                  <loomi-card-header><loomi-card-title>Acquisition mix</loomi-card-title><loomi-card-description>New workspaces by source</loomi-card-description></loomi-card-header>
                  <loomi-card-content><loomi-chart type="donut" color="primary" show-legend data={acquisitionChartData}></loomi-chart></loomi-card-content>
                </loomi-card>
                <loomi-card size="sm">
                  <loomi-card-header><loomi-card-title>Activation health</loomi-card-title><loomi-card-description>Key onboarding milestones</loomi-card-description></loomi-card-header>
                  <loomi-card-content class="progress-stack">
                    <div><span>Created first project</span><loomi-progress-bar percentage="84" show-percentage-label></loomi-progress-bar></div>
                    <div><span>Invited a teammate</span><loomi-progress-bar percentage="68" color="success" show-percentage-label></loomi-progress-bar></div>
                    <div><span>Connected billing</span><loomi-progress-bar percentage="51" color="warning" show-percentage-label></loomi-progress-bar></div>
                  </loomi-card-content>
                </loomi-card>
              </div>
              <loomi-alert type="info" show-icon>Retention is 6.8% above the trailing 90-day baseline.</loomi-alert>
            </section>

            <section class="demo-view" data-demo-panel="settings" hidden>
              <div class="demo-section-heading"><div><small>Workspace controls</small><h3>Settings</h3><p>See how inputs, selects, toggles, cards, and alerts inherit the preset.</p></div><loomi-button color="primary" size="small">Save changes</loomi-button></div>
              <div class="settings-grid">
                <loomi-card size="sm">
                  <loomi-card-header><loomi-card-title>Workspace profile</loomi-card-title><loomi-card-description>General identity and regional defaults</loomi-card-description></loomi-card-header>
                  <loomi-card-content class="settings-fields">
                    <loomi-input label="Workspace name" value="Loomi Cloud" size="small"></loomi-input>
                    <loomi-input label="Workspace URL" prefix="app.loomi.dev/" value="loomi-cloud" size="small"></loomi-input>
                    <loomi-select label="Time zone" selected-value="accra" data='[{"label":"Accra (GMT)","value":"accra"},{"label":"London (GMT)","value":"london"},{"label":"New York (EST)","value":"new-york"}]'></loomi-select>
                  </loomi-card-content>
                </loomi-card>
                <loomi-card size="sm">
                  <loomi-card-header><loomi-card-title>Notifications</loomi-card-title><loomi-card-description>Choose the events your team receives</loomi-card-description></loomi-card-header>
                  <loomi-card-content class="toggle-stack">
                    <loomi-toggle justified checked>Weekly performance summary</loomi-toggle>
                    <loomi-toggle justified checked>Billing and usage alerts</loomi-toggle>
                    <loomi-toggle justified>Product announcements</loomi-toggle>
                  </loomi-card-content>
                </loomi-card>
              </div>
              <loomi-alert type="success" show-icon>Your workspace uses the selected preset’s focus, status, and surface tokens.</loomi-alert>
            </section>
          </main>
        </div>
      </div>

      <aside class="preset-details">
        <div class="detail-block">
          <div class="detail-label">Use this preset</div>
          <div class="import-row">
            <code id="import-code">import &quot;@loomdev-pro/themes/css/{initialPreset.name}.css&quot;;</code>
            <button type="button" id="copy-import" aria-label="Copy preset import"><loomi-icon name="clipboard"></loomi-icon></button>
          </div>
          <span class="copy-feedback" id="copy-feedback" aria-live="polite"></span>
        </div>

        <div class="detail-block">
          <div class="detail-label">Core decisions</div>
          <div class="token-summary">
            <div><span class="token-dot" id="primary-token-dot" style={`background:${initialTokens?.color?.primary?.[500] ?? initialPreset.primary500}`}></span><small>Primary</small><strong id="primary-token-value">{initialTokens?.color?.primary?.[500] ?? initialPreset.primary500}</strong></div>
            <div><loomi-icon name="square-3-stack-3d"></loomi-icon><small>Panel radius</small><strong id="radius-token-value">{initialTokens?.component?.panelRadius ?? "12px"}</strong></div>
            <div><loomi-icon name="arrows-pointing-in"></loomi-icon><small>Control height</small><strong id="density-token-value">{initialTokens?.density?.controlHeight ?? "36px"}</strong></div>
            <div><loomi-icon name="language"></loomi-icon><small>Body size</small><strong id="type-token-value">{initialTokens?.typography?.fontSizeMd ?? "14px"}</strong></div>
          </div>
        </div>

        <div class="detail-block starter-detail" id="starter-detail" hidden={!initialPreset.starterKit}>
          <div class="detail-label">Recommended starting point</div>
          <strong id="starter-name">{initialPreset.starterKit?.name}</strong>
          <p>The preset is already paired with this template family.</p>
          <a id="starter-link" href={`/pro/templates/?preview=${initialPreset.starterKit?.slug ?? "admin"}`}>View template preview <loomi-icon name="arrow-right"></loomi-icon></a>
        </div>

        <loomi-button color="primary" tag="a" href="/pro/themes/theme-builder/" block>Customize in Theme Builder</loomi-button>
      </aside>
    </div>
  </section>

  <section class="delivery-section">
    <div>
      <p class="section-eyebrow">What ships</p>
      <h2>A complete theme, not a color swatch</h2>
      <p>Every preset uses the same semantic contract, so changing direction does not require rewriting your components.</p>
    </div>
    <div class="delivery-grid">
      <article><loomi-icon name="swatch"></loomi-icon><strong>Light and dark modes</strong><p>Complete surface, text, border, semantic, and focus tokens.</p></article>
      <article><loomi-icon name="adjustments-horizontal"></loomi-icon><strong>Product-level decisions</strong><p>Typography, radius, density, shadow, motion, and component sizing.</p></article>
      <article><loomi-icon name="code-bracket"></loomi-icon><strong>Multiple export formats</strong><p>Use generated CSS directly or take the JSON tokens into your tooling.</p></article>
    </div>
  </section>

  <section class="purchase-panel">
    <div>
      <p class="section-eyebrow">Included with LoomiUI Pro</p>
      <h2>Start polished, then make it unmistakably yours</h2>
      <p>Get all twelve presets, Theme Builder exports, matching templates, Figma resources, and updates.</p>
    </div>
    <loomi-button color="primary" tag="a" href={PRO_LICENSING_URL}>View Pro licenses</loomi-button>
  </section>

  <script type="module" is:inline>
    import "@loomidev/alert";
    import "@loomidev/card";
    import "@loomidev/chart";
    import "@loomidev/input";
    import "@loomidev/profile-menu";
    import "@loomidev/progress";
    import "@loomidev/select";
    import "@loomidev/statistic";
    import "@loomidev/table";
    import "@loomidev/tag";
    import "@loomidev/timeline";
    import "@loomidev/toggle";
  </script>
  <script type="application/json" id="theme-preset-data" is:inline set:html={JSON.stringify(themeBundle)}></script>
  <script>
    const themeData = JSON.parse(document.getElementById("theme-preset-data")!.textContent || "{}");
    const manifest = themeData.manifest?.presets ?? [];
    const tokens = themeData.tokens ?? {};
    const presetButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-preset]"));
    const modeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-mode]"));
    const canvas = document.getElementById("preview-canvas") as HTMLElement;
    const presetName = document.getElementById("selected-preset-name") as HTMLElement;
    const presetDescription = document.getElementById("selected-preset-description") as HTMLElement;
    const brandName = document.getElementById("demo-brand-name") as HTMLElement;
    const importCode = document.getElementById("import-code") as HTMLElement;
    const copyButton = document.getElementById("copy-import") as HTMLButtonElement;
    const copyFeedback = document.getElementById("copy-feedback") as HTMLElement;
    const starterDetail = document.getElementById("starter-detail") as HTMLElement;
    const starterName = document.getElementById("starter-name") as HTMLElement;
    const starterLink = document.getElementById("starter-link") as HTMLAnchorElement;
    const demoViewButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-demo-view]"));
    const demoPanels = Array.from(document.querySelectorAll<HTMLElement>("[data-demo-panel]"));
    const demoPageKicker = document.getElementById("demo-page-kicker") as HTMLElement;
    const demoPageTitle = document.getElementById("demo-page-title") as HTMLElement;
    let activePreset = manifest[0]?.name;
    let activeMode = "light";

    function getPreset(name: string) {
      return manifest.find((preset: any) => preset.name === name);
    }

    function toKebabCase(value: string) {
      return value.replace(/([a-z0-9])([A-Z])/g, "$1-$2").toLowerCase();
    }

    function setTokenGroup(prefix: string, group: Record<string, unknown> = {}) {
      Object.entries(group).forEach(([name, value]) => {
        canvas.style.setProperty(`${prefix}-${toKebabCase(name)}`, String(value));
      });
    }

    function setCanvasTokens(mode: any, preset: any) {
      const primary = mode?.color?.primary ?? {};
      const surface = mode?.color?.surface ?? {};
      const text = mode?.color?.text ?? {};
      const values = {
        "--preview-primary": primary[500] ?? preset.primary500,
        "--preview-primary-soft": primary[activeMode === "dark" ? 950 : 50] ?? surface.muted,
        "--preview-primary-strong": primary[activeMode === "dark" ? 300 : 700] ?? preset.primary500,
        "--preview-surface": surface.base ?? (activeMode === "dark" ? "#0f172a" : "#ffffff"),
        "--preview-surface-muted": surface.muted ?? (activeMode === "dark" ? "#020617" : "#f8fafc"),
        "--preview-surface-raised": surface.raised ?? surface.base,
        "--preview-border": surface.border ?? (activeMode === "dark" ? "#334155" : "#e2e8f0"),
        "--preview-text": text.base ?? (activeMode === "dark" ? "#f8fafc" : "#0f172a"),
        "--preview-text-muted": text.muted ?? (activeMode === "dark" ? "#94a3b8" : "#64748b"),
        "--preview-radius": mode?.component?.panelRadius ?? "12px",
        "--preview-shadow": mode?.component?.cardShadow ?? "0 1px 3px rgba(15,23,42,.1)",
      };
      Object.entries(values).forEach(([property, value]) => canvas.style.setProperty(property, String(value)));
      canvas.dataset.loomiMode = activeMode;

      setTokenGroup("--loomi-primary", primary);
      setTokenGroup("--loomi-gray", mode?.color?.neutral);
      setTokenGroup("--loomi-success", mode?.color?.success);
      setTokenGroup("--loomi-warning", mode?.color?.warning);
      setTokenGroup("--loomi-error", mode?.color?.error);
      canvas.style.setProperty("--loomi-surface", surface.base ?? values["--preview-surface"]);
      canvas.style.setProperty("--loomi-surface-muted", surface.muted ?? values["--preview-surface-muted"]);
      canvas.style.setProperty("--loomi-surface-hover", surface.hover ?? values["--preview-surface-muted"]);
      canvas.style.setProperty("--loomi-surface-raised", surface.raised ?? values["--preview-surface-raised"]);
      canvas.style.setProperty("--loomi-surface-border", surface.border ?? values["--preview-border"]);
      canvas.style.setProperty("--loomi-surface-border-subtle", surface.borderSubtle ?? values["--preview-border"]);
      canvas.style.setProperty("--loomi-text", text.base ?? values["--preview-text"]);
      canvas.style.setProperty("--loomi-text-secondary", text.secondary ?? values["--preview-text"]);
      canvas.style.setProperty("--loomi-text-muted", text.muted ?? values["--preview-text-muted"]);
      canvas.style.setProperty("--loomi-text-faint", text.faint ?? values["--preview-text-muted"]);
      canvas.style.setProperty("--loomi-text-on-primary", text.onPrimary ?? "#ffffff");
      canvas.style.setProperty("--loomi-focus-ring", mode?.color?.focusRing ?? primary[500] ?? preset.primary500);
      setTokenGroup("--loomi-font", mode?.typography);
      setTokenGroup("--loomi-space", mode?.spacing);
      setTokenGroup("--loomi-radius", mode?.radius);
      setTokenGroup("--loomi-shadow", mode?.shadow);
      setTokenGroup("--loomi-border", mode?.border);
      setTokenGroup("--loomi-motion", mode?.motion);
      setTokenGroup("--loomi-density", mode?.density);
      setTokenGroup("--loomi-component", mode?.component);

      const primaryValue = primary[500] ?? preset.primary500;
      (document.getElementById("primary-token-dot") as HTMLElement).style.background = primaryValue;
      document.getElementById("primary-token-value")!.textContent = primaryValue;
      document.getElementById("radius-token-value")!.textContent = mode?.component?.panelRadius ?? "12px";
      document.getElementById("density-token-value")!.textContent = mode?.density?.controlHeight ?? "36px";
      document.getElementById("type-token-value")!.textContent = mode?.typography?.fontSizeMd ?? "14px";

      canvas.querySelectorAll<any>("loomi-chart").forEach((chart) => chart.requestUpdate?.());
    }

    function setDemoView(view: string) {
      const pageLabels: Record<string, { kicker: string; title: string }> = {
        overview: { kicker: "Workspace", title: "Performance overview" },
        customers: { kicker: "Directory", title: "Customer accounts" },
        analytics: { kicker: "Insights", title: "Product analytics" },
        settings: { kicker: "Configuration", title: "Workspace settings" },
      };
      demoViewButtons.forEach((button) => {
        const active = button.dataset.demoView === view;
        button.classList.toggle("is-current", active);
        if (active) button.setAttribute("aria-current", "page");
        else button.removeAttribute("aria-current");
      });
      demoPanels.forEach((panel) => {
        const active = panel.dataset.demoPanel === view;
        panel.hidden = !active;
        panel.classList.toggle("is-active", active);
      });
      demoPageKicker.textContent = pageLabels[view]?.kicker ?? "Workspace";
      demoPageTitle.textContent = pageLabels[view]?.title ?? "Performance overview";
    }

    function render() {
      const preset = getPreset(activePreset);
      if (!preset) return;
      const mode = tokens[activePreset]?.modes?.[activeMode];

      presetButtons.forEach((button) => {
        const active = button.dataset.preset === activePreset;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });
      modeButtons.forEach((button) => {
        const active = button.dataset.mode === activeMode;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });

      presetName.textContent = preset.label;
      presetDescription.textContent = preset.description;
      brandName.textContent = preset.label;
      importCode.textContent = `import "@loomdev-pro/themes/css/${preset.name}.css";`;
      setCanvasTokens(mode, preset);

      starterDetail.hidden = !preset.starterKit;
      if (preset.starterKit) {
        starterName.textContent = preset.starterKit.name;
        starterLink.href = `/pro/templates/?preview=${preset.starterKit.slug}`;
      }

      const url = new URL(window.location.href);
      url.searchParams.set("preset", activePreset);
      if (activeMode === "dark") url.searchParams.set("mode", "dark");
      else url.searchParams.delete("mode");
      history.replaceState(null, "", url);
    }

    presetButtons.forEach((button) => button.addEventListener("click", () => {
      activePreset = button.dataset.preset!;
      render();
      document.querySelector(".workbench")?.scrollIntoView({ behavior: "smooth", block: "start" });
    }));
    modeButtons.forEach((button) => button.addEventListener("click", () => {
      activeMode = button.dataset.mode ?? "light";
      render();
    }));
    demoViewButtons.forEach((button) => button.addEventListener("click", () => {
      setDemoView(button.dataset.demoView ?? "overview");
    }));
    copyButton.addEventListener("click", () => {
      copyFeedback.textContent = "Copied";
      window.setTimeout(() => { copyFeedback.textContent = ""; }, 1600);
      void navigator.clipboard.writeText(importCode.textContent ?? "").catch(() => {
        copyFeedback.textContent = "Copy unavailable";
      });
    });

    const params = new URL(window.location.href).searchParams;
    const requestedPreset = params.get("preset");
    if (requestedPreset && getPreset(requestedPreset)) activePreset = requestedPreset;
    if (params.get("mode") === "dark") activeMode = "dark";
    render();
  </script>
</ProLandingShell>

