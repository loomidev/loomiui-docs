{
  "name": "loomiui-docs",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "predev": "pnpm run prepare:content",
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "pnpm run previews:build && pnpm run prepare:content",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "previews:build": "pnpm --dir ../pro build:previews && node scripts/copy-pro-template-previews.mjs",
    "previews:serve": "pnpm --dir ../pro serve:previews",
    "astro": "astro",
    "prepare:content": "node scripts/sync-docs-version.mjs && node scripts/copy-component-assets.mjs && node scripts/copy-pro-theme-assets.mjs && node scripts/copy-pro-template-screenshots.mjs && node scripts/copy-pro-template-previews.mjs && node scripts/gen-component-docs.mjs && node scripts/gen-preview-fallbacks.mjs",
    "gen:components": "node scripts/gen-component-docs.mjs",
    "gen:preview-fallbacks": "node scripts/gen-preview-fallbacks.mjs",
    "copy:assets": "node scripts/copy-component-assets.mjs",
    "watch:components": "node scripts/watch-component-docs.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.6",
    "@expressive-code/plugin-line-numbers": "^0.44.2",
    "astro": "^7.3.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@tailwindcss/vite": "^4.3.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@<4.3.2": "^4.3.2",
      "fast-uri@<3.1.8": "^3.1.8",
      "postcss@<8.5.23": "^8.5.23",
      "nanoid@<3.3.18": "^3.3.18",
      "yaml@<2.8.3": "^2.8.3",
      "source-map-js@<1.2.2": "^1.2.2"
    }
  }
}
