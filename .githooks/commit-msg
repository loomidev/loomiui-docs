#!/bin/sh
# Strips AI/tool attribution from commit messages.
#
# AGENTS.md tells assistants not to add attribution, but an instruction any tool
# can ignore is not enforcement. This runs on every commit regardless of which
# assistant, IDE, or CLI produced the message.
#
# Enable in a fresh clone (hooks are not cloned):
#   git config core.hooksPath .githooks
#
# Human co-authors are preserved — only known AI/bot identities are removed.
# Deliberately plain POSIX sh with `case` rather than sed/awk regexes, which
# differ between BSD and GNU userlands in ways that silently drop the wrong line.

MSG_FILE="$1"
[ -f "$MSG_FILE" ] || exit 0

TMP="$MSG_FILE.attrib.$$"
CHANGED=0

is_ai() {
  case "$1" in
    *claude*|*anthropic*|*copilot*|*cursor*|*openai*|*codex*|*chatgpt*|*gpt-4*|*gpt-5*) return 0 ;;
    *gemini*|*devin*|*aider*|*windsurf*|*sourcegraph*|*swe-agent*|*"[bot]"*|*bot@*) return 0 ;;
  esac
  return 1
}

while IFS= read -r line || [ -n "$line" ]; do
  # Lowercase and strip leading blanks so prefix matching is predictable.
  probe=$(printf '%s' "$line" | tr '[:upper:]' '[:lower:]' | sed 's/^[[:space:]]*//')
  drop=0

  case "$probe" in
    co-authored-by:*|signed-off-by:*|assisted-by:*|on-behalf-of:*|coauthored-by:*)
      is_ai "$probe" && drop=1
      ;;
  esac

  case "$probe" in
    "generated with"*|"generated by"*|"created with"*|"created by"*|"written with"*|\
    "written by"*|"authored with"*|"authored by"*|"ai-assisted"*|"ai assisted"*|"🤖"*)
      if is_ai "$probe"; then
        drop=1
      else
        case "$probe" in
          *ai-assisted*|*"ai assisted"*|"🤖"*) drop=1 ;;
        esac
      fi
      ;;
  esac

  if [ "$drop" -eq 1 ]; then
    CHANGED=1
  else
    printf '%s\n' "$line"
  fi
done < "$MSG_FILE" > "$TMP"

if [ "$CHANGED" -eq 1 ]; then
  # Drop blank lines that the removal left stranded at the end.
  while [ -s "$TMP" ] && [ -z "$(tail -n 1 "$TMP")" ]; do
    sed '$d' "$TMP" > "$TMP.trim" && mv "$TMP.trim" "$TMP"
  done
  mv "$TMP" "$MSG_FILE"
  echo "commit-msg: removed AI attribution from the commit message (see AGENTS.md)." >&2
else
  rm -f "$TMP"
fi

exit 0
