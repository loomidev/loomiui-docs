---

<ProLandingShell title={title} description={description} wide>
  <a class="back-link" href="/pro/themes/">
    <loomi-icon name="arrow-left"></loomi-icon>
    Back to themes
  </a>

  <section class="preset-hero">
    <div>
      <p class="section-eyebrow">Theme presets</p>
      <h1>Choose a visual direction. Keep one token contract.</h1>
      <p>Compare every Pro preset in the same product shell, switch between light and dark mode, then take the closest direction into the Theme Builder.</p>
    </div>
    <div class="hero-actions">
      <loomi-button color="primary" tag="a" href="/pro/themes/theme-builder/">Customize a preset</loomi-button>
      <loomi-button type="secondary" tag="a" href={PRO_LICENSING_URL}>Get Pro</loomi-button>
    </div>
  </section>

  <section class="catalog-section" aria-labelledby="preset-catalog-heading">
    <div class="section-heading">
      <div>
        <p class="section-eyebrow">All included presets</p>
        <h2 id="preset-catalog-heading">12 foundations for different product moods</h2>
      </div>
      <p>Select any preset to update the preview and implementation details below.</p>
    </div>

    <div class="preset-carousel" aria-label="Theme preset carousel">
      <button type="button" class="carousel-button" id="preset-prev" aria-label="Show previous presets"><loomi-icon name="chevron-left"></loomi-icon></button>
      <div class="preset-grid" id="preset-grid" aria-label="Theme presets">
        {presets.map((preset: any, index: number) => (
          <button
            type="button"
            class:list={["preset-card", index === 0 && "is-active"]}
            data-preset={preset.name}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            <span class="preset-palette" aria-hidden="true">
              {paletteFor(preset).map((color: string) => <span style={`background:${color}`}></span>)}
            </span>
            <span class="preset-card-copy">
              <strong>{preset.label}</strong>
              <small>{preset.description}</small>
            </span>
          </button>
        ))}
      </div>
      <button type="button" class="carousel-button" id="preset-next" aria-label="Show next presets"><loomi-icon name="chevron-right"></loomi-icon></button>
    </div>
  </section>

  <section
    class="workbench"
    id="preset-workbench"
    aria-labelledby="selected-preset-name"
    data-loomi-mode="light"
    style={`
      --preview-primary:${initialTokens?.color?.primary?.[500] ?? initialPreset.primary500};
