---
import ProLandingShell from "./ProLandingShell.astro";
import { PRO_LICENSING_URL } from "../lib/pro-licensing.mjs";
import { readFileSync, existsSync } from "node:fs";
import { resolve } from "node:path";

const title = "Themes - LoomiUI Pro";
const description = "Theme presets, design tokens, visual tooling, and matching Figma resources for LoomiUI.";

const themeRoot = [resolve(process.cwd(), "public/pro/themes"), resolve(process.cwd(), "../pro/packages/themes/dist")]
  .find((root) => existsSync(resolve(root, "json/manifest.json")));
const themeManifest = themeRoot
  ? JSON.parse(readFileSync(resolve(themeRoot, "json/manifest.json"), "utf8"))
  : { presets: [] };
const presets: Array<{ slug: string; name: string; description: string; colors: string[] }> = themeManifest.presets.slice(0, 6).map((preset: any) => {
  const tokenPath = themeRoot && resolve(themeRoot, preset.json);
  const mode = tokenPath && existsSync(tokenPath)
    ? JSON.parse(readFileSync(tokenPath, "utf8")).modes?.light
    : null;
  return {
    slug: preset.name,
    name: preset.label,
    description: preset.description,
    colors: [
      mode?.color?.primary?.[500] ?? preset.primary500,
      mode?.color?.primary?.[200] ?? preset.primary500,
      mode?.color?.surface?.muted ?? "#f8fafc",
      mode?.color?.text?.base ?? "#0f172a",
    ],
  };
});

const workflow = [
  { number: "01", title: "Choose a preset", description: "Start with a visual direction designed for a real product category." },
  { number: "02", title: "Adjust the tokens", description: "Tune color, typography, radius, density, and light or dark surfaces." },
  { number: "03", title: "Export and ship", description: "Generate CSS variables, JSON, or TypeScript for your application." },
];

const resources = [
  { title: "Theme Builder", icon: "adjustments-horizontal", href: "/pro/themes/theme-builder/", description: "Customize and preview a theme visually before export." },
  { title: "Figma workflow", icon: "beaker", href: "/pro/themes/figma-kit/", description: "Import variables and keep design decisions aligned with code." },
];

const tokenGroups = [
  { label: "Color", value: "Brand, semantic, surface and text roles" },
  { label: "Foundation", value: "Typography, spacing, radius and shadow" },
  { label: "Behavior", value: "Density, motion, focus and component tokens" },
];

const qualityChecks = [
  "Readable light and dark surfaces",
  "Visible keyboard focus",
  "Reduced-motion preferences",
  "High-contrast starting point",
];
---

<ProLandingShell title={title} description={description}>
  <section class="theme-hero">
    <div class="max-w-3xl">
      <div class="feature-kicker">LoomiUI Pro</div>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">Customize LoomiUI without rebuilding every component</h1>
      <p class="mt-5 text-lg leading-8 text-gray-600 dark:text-gray-400">
        Choose a production-ready preset, adapt a shared token system to your brand, and export a theme that stays consistent across every LoomiUI component.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <loomi-button color="primary" tag="a" href="/pro/themes/theme-presets/">Explore presets</loomi-button>
        <loomi-button type="secondary" tag="a" href="/pro/themes/theme-builder/">Open theme builder</loomi-button>
      </div>
    </div>
    <div class="hero-swatch" aria-hidden="true">
      <div class="hero-swatch-header"><span></span><span></span><span></span></div>
      <div class="hero-swatch-body">
        <div class="hero-sidebar"></div>
        <div class="hero-content">
          <div class="hero-line wide"></div><div class="hero-line"></div>
          <div class="hero-panels"><span></span><span></span><span></span></div>
          <div class="hero-table"></div><div class="hero-table short"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="system-section" id="tokens" aria-labelledby="tokens-heading">
    <div class="system-copy">
      <p class="section-eyebrow">One contract across every component</p>
      <h2 id="tokens-heading">Tokens are built in, not another destination to learn</h2>
      <p>Every preset uses the same semantic <code>--loomi-*</code> contract. Change a role once and buttons, forms, navigation, tables, and product shells update together.</p>
      <pre><code>{`:root {
  --loomi-primary-500: #2563eb;
  --loomi-surface: #ffffff;
  --loomi-text: #0f172a;
  --loomi-radius-md: 0.625rem;
}`}</code></pre>
    </div>
    <dl class="token-groups">
      {tokenGroups.map((group) => (
        <div><dt>{group.label}</dt><dd>{group.value}</dd></div>
      ))}
    </dl>
  </section>

  <section class="mt-20" aria-labelledby="presets-heading">
    <div class="section-heading">
      <div>
        <p class="section-eyebrow">Start visually</p>
        <h2 id="presets-heading">Theme presets</h2>
      </div>
      <a href="/pro/themes/theme-presets/">View all 12 presets <loomi-icon name="arrow-right"></loomi-icon></a>
    </div>

    <div class="preset-grid">
      {presets.map((preset) => (
        <a class="preset-card" href={`/pro/themes/theme-presets/?preset=${preset.slug}`}>
          <div class="preset-colors" aria-hidden="true">
            {preset.colors.map((color, index) => <span style={`--swatch:${color};--size:${index === 0 ? "3" : "1"}`}></span>)}
          </div>
          <div class="preset-copy">
            <strong>{preset.name}</strong>
            <p>{preset.description}</p>
          </div>
          <loomi-icon name="chevron-right"></loomi-icon>
        </a>
      ))}
    </div>
  </section>

  <section class="workflow-section" aria-labelledby="workflow-heading">
    <div class="workflow-intro">
      <p class="section-eyebrow">A simple workflow</p>
      <h2 id="workflow-heading">From preset to product</h2>
      <p>Presets are the starting point. Tokens and tooling make them yours.</p>
    </div>
    <ol class="workflow-list">
      {workflow.map((step) => (
        <li>
          <span>{step.number}</span>
          <div><strong>{step.title}</strong><p>{step.description}</p></div>
        </li>
      ))}
    </ol>
  </section>

  <section class="quality-section" id="quality" aria-labelledby="quality-heading">
    <div>
      <p class="section-eyebrow">Quality is part of the preset</p>
      <h2 id="quality-heading">Accessible defaults without a separate checklist page</h2>
      <p>Theme choices are reviewed where they matter: contrast, focus, motion, and readability. The High Contrast preset gives teams a stronger review baseline when requirements are stricter.</p>
    </div>
    <ul>
      {qualityChecks.map((check) => (
        <li><loomi-icon name="check-circle"></loomi-icon><span>{check}</span></li>
      ))}
    </ul>
  </section>

  <section class="mt-20" aria-labelledby="resources-heading">
    <div class="section-heading">
      <div>
        <p class="section-eyebrow">Go deeper when you need to</p>
        <h2 id="resources-heading">Tools and resources</h2>
      </div>
      <p>Everything supporting the presets, organized by the job it helps you complete.</p>
    </div>

    <div class="resource-list">
      {resources.map((resource) => (
        <a href={resource.href}>
          <span class="resource-icon"><loomi-icon name={resource.icon}></loomi-icon></span>
          <span><strong>{resource.title}</strong><small>{resource.description}</small></span>
          <loomi-icon name="arrow-right"></loomi-icon>
        </a>
      ))}
    </div>
  </section>

  <section class="purchase-panel">
    <div>
      <p class="section-eyebrow">Included with LoomiUI Pro</p>
      <h2>Design and code from one system</h2>
      <p>Get every preset, the Theme Builder, token exports, Figma resources, private docs, and updates.</p>
    </div>
    <loomi-button color="primary" tag="a" href={PRO_LICENSING_URL}>View Pro licenses</loomi-button>
  </section>
</ProLandingShell>

<style>
  .theme-hero { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(20rem, .85fr); align-items: center; gap: 4rem; }
  .hero-swatch { overflow: hidden; border: 1px solid rgb(191 219 254); border-radius: 1.25rem; background: white; box-shadow: 0 25px 60px rgb(37 99 235 / .16); transform: rotate(2deg); }
  .hero-swatch-header { display: flex; gap: .35rem; border-bottom: 1px solid rgb(219 234 254); padding: .8rem; }
  .hero-swatch-header span { width: .5rem; height: .5rem; border-radius: 50%; background: rgb(191 219 254); }
  .hero-swatch-body { display: grid; grid-template-columns: 4.5rem 1fr; min-height: 18rem; }
  .hero-sidebar { background: rgb(30 64 175); }
  .hero-content { padding: 1.5rem; background: rgb(248 250 252); }
  .hero-line { width: 38%; height: .55rem; border-radius: 1rem; background: rgb(191 219 254); }
  .hero-line.wide { width: 62%; height: .8rem; margin-bottom: .55rem; background: rgb(37 99 235); }
  .hero-panels { display: grid; grid-template-columns: repeat(3, 1fr); gap: .6rem; margin-top: 1.5rem; }
  .hero-panels span { height: 3.8rem; border: 1px solid rgb(219 234 254); border-radius: .6rem; background: white; }
  .hero-table { height: 2rem; margin-top: 1.25rem; border-radius: .45rem; background: rgb(219 234 254); }
  .hero-table.short { width: 80%; margin-top: .55rem; background: rgb(226 232 240); }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }
  .section-heading h2, .workflow-intro h2, .purchase-panel h2 { margin: .25rem 0 0; font-size: 1.75rem; line-height: 1.2; font-weight: 750; letter-spacing: -.025em; }
  .section-heading > p { margin: 0; max-width: 31rem; color: rgb(75 85 99); line-height: 1.6; }
  .section-heading > a { display: inline-flex; flex: none; align-items: center; gap: .35rem; color: rgb(37 99 235); font-size: .875rem; font-weight: 700; text-decoration: none; }
  .section-heading > a loomi-icon { width: 1rem; height: 1rem; }
  .section-eyebrow { margin: 0; color: rgb(37 99 235); font-size: .75rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  .preset-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-top: 1.75rem; }
  .preset-card { position: relative; overflow: hidden; border: 1px solid rgb(229 231 235); border-radius: 1rem; background: white; color: rgb(17 24 39); text-decoration: none; transition: transform .15s, box-shadow .15s; }
  .preset-card:hover { transform: translateY(-2px); box-shadow: 0 14px 30px rgb(15 23 42 / .08); }
  .preset-colors { display: grid; grid-template-columns: 3fr 1fr 1fr 1fr; height: 4.25rem; }
  .preset-colors span { background: var(--swatch); }
  .preset-copy { padding: 1rem 2.5rem 1rem 1rem; }
  .preset-copy strong { font-size: .95rem; }
  .preset-copy p { margin: .35rem 0 0; color: rgb(107 114 128); font-size: .8rem; line-height: 1.5; }
  .preset-card > loomi-icon { position: absolute; right: 1rem; bottom: 1.2rem; width: .95rem; height: .95rem; color: rgb(37 99 235); }
  .workflow-section { display: grid; grid-template-columns: .8fr 1.2fr; gap: 5rem; margin-top: 5rem; border-radius: 1.25rem; background: rgb(249 250 251); padding: 2.5rem; }
  .workflow-intro > p:last-child { margin: .75rem 0 0; color: rgb(75 85 99); line-height: 1.65; }
  .workflow-list { margin: 0; padding: 0; list-style: none; }
  .workflow-list li { display: grid; grid-template-columns: 2.5rem 1fr; gap: 1rem; padding: 1.15rem 0; border-bottom: 1px solid rgb(229 231 235); }
  .workflow-list li:first-child { padding-top: 0; }
  .workflow-list li:last-child { padding-bottom: 0; border-bottom: 0; }
  .workflow-list li > span { color: rgb(37 99 235); font-size: .75rem; font-weight: 800; letter-spacing: .08em; }
  .workflow-list strong { font-size: .95rem; }
  .workflow-list p { margin: .3rem 0 0; color: rgb(107 114 128); font-size: .875rem; line-height: 1.5; }
  .system-section, .quality-section { scroll-margin-top: 6rem; }
  .system-section { display: grid; grid-template-columns: 1.1fr .9fr; gap: 3rem; margin-top: 5rem; border: 1px solid rgb(219 234 254); border-radius: 1.25rem; background: linear-gradient(145deg, rgb(239 246 255), white); padding: 2.5rem; }
  .system-copy h2, .quality-section h2 { margin: .35rem 0 0; font-size: 1.75rem; line-height: 1.2; font-weight: 750; letter-spacing: -.025em; }
  .system-copy > p:last-of-type, .quality-section > div > p:last-child { margin: .8rem 0 0; color: rgb(75 85 99); line-height: 1.65; }
  .system-copy pre { overflow-x: auto; margin: 1.4rem 0 0; border-radius: .8rem; background: rgb(15 23 42); padding: 1rem; color: rgb(226 232 240); font-size: .78rem; line-height: 1.65; }
  .token-groups { display: grid; align-content: center; gap: .75rem; margin: 0; }
  .token-groups div { border: 1px solid rgb(219 234 254); border-radius: .8rem; background: rgb(255 255 255 / .8); padding: 1rem; }
  .token-groups dt { color: rgb(37 99 235); font-size: .75rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }
  .token-groups dd { margin: .35rem 0 0; color: rgb(51 65 85); font-size: .9rem; line-height: 1.5; }
  .quality-section { display: grid; grid-template-columns: 1.1fr .9fr; gap: 3rem; align-items: center; margin-top: 5rem; }
  .quality-section ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; margin: 0; padding: 0; list-style: none; }
  .quality-section li { display: flex; align-items: center; gap: .65rem; min-height: 4rem; border: 1px solid rgb(229 231 235); border-radius: .8rem; padding: .85rem; color: rgb(51 65 85); font-size: .85rem; font-weight: 650; }
  .quality-section li loomi-icon { flex: none; width: 1.1rem; height: 1.1rem; color: rgb(37 99 235); }
  .resource-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; margin-top: 1.75rem; }
  .resource-list > a { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1rem; border: 1px solid rgb(229 231 235); border-radius: .9rem; padding: 1rem; color: rgb(17 24 39); text-decoration: none; }
  .resource-list > a:hover { border-color: rgb(147 197 253); }
  .resource-icon { display: grid; width: 2.5rem; height: 2.5rem; place-items: center; border-radius: .75rem; background: rgb(239 246 255); color: rgb(37 99 235); }
  .resource-icon loomi-icon, .resource-list > a > loomi-icon { width: 1.1rem; height: 1.1rem; }
  .resource-list small { display: block; margin-top: .2rem; color: rgb(107 114 128); font-size: .8rem; line-height: 1.4; }
  .resource-list > a > loomi-icon { color: rgb(37 99 235); }
  .purchase-panel { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin-top: 4rem; border-radius: 1.25rem; background: rgb(239 246 255); padding: 2rem; }
  .purchase-panel p:last-child { margin: .65rem 0 0; color: rgb(75 85 99); }
  :global(.dark) .hero-swatch { border-color: rgb(30 64 175); background: rgb(15 23 42); }
  :global(.dark) .hero-swatch-header { border-color: rgb(30 58 138); }
  :global(.dark) .hero-content { background: rgb(17 24 39); }
  :global(.dark) .hero-panels span { border-color: rgb(51 65 85); background: rgb(30 41 59); }
  :global(.dark) .section-heading > p, :global(.dark) .workflow-intro > p:last-child, :global(.dark) .purchase-panel p:last-child { color: rgb(156 163 175); }
  :global(.dark) .preset-card, :global(.dark) .resource-list > a { border-color: rgb(55 65 81); background: rgb(17 24 39); color: rgb(243 244 246); }
  :global(.dark) .preset-copy p, :global(.dark) .workflow-list p, :global(.dark) .resource-list small { color: rgb(156 163 175); }
  :global(.dark) .workflow-section { background: rgb(17 24 39); }
  :global(.dark) .system-section { border-color: rgb(30 58 138); background: linear-gradient(145deg, rgb(15 23 42), rgb(17 24 39)); }
  :global(.dark) .token-groups div, :global(.dark) .quality-section li { border-color: rgb(55 65 81); background: rgb(17 24 39); }
  :global(.dark) .token-groups dd, :global(.dark) .quality-section li, :global(.dark) .system-copy > p:last-of-type, :global(.dark) .quality-section > div > p:last-child { color: rgb(156 163 175); }
  :global(.dark) .workflow-list li { border-color: rgb(55 65 81); }
  :global(.dark) .resource-icon { background: rgb(30 58 138 / .5); color: rgb(147 197 253); }
  :global(.dark) .purchase-panel { background: rgb(30 58 138 / .3); }
  @media (max-width: 900px) {
    .theme-hero { grid-template-columns: 1fr; }
    .hero-swatch { display: none; }
    .preset-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .workflow-section { grid-template-columns: 1fr; gap: 2.5rem; }
    .system-section, .quality-section { grid-template-columns: 1fr; gap: 2rem; }
  }
  @media (max-width: 640px) {
    .section-heading, .purchase-panel { align-items: flex-start; flex-direction: column; }
    .preset-grid, .resource-list { grid-template-columns: 1fr; }
    .system-section { padding: 1.5rem; }
    .quality-section ul { grid-template-columns: 1fr; }
  }
</style>
